iments: a flag with a default of 5.\n"],"reminderFold":false,"echoWireToolInputs":true,"contextRendering":"announced"},"type":"attachment","uuid":"729ee978-9823-4523-b343-0bf81edc7625","timestamp":"2026-11-12T14:21:31.793Z","userType":"external","entrypoint":"sdk-cli","cwd":"/Users/datguy/.hyp-sandbox/g146-base-a-1/tmp/hyp-owner-grill-eval/standin","sessionId":"74c6c6a6-9519-4de8-ad67-b802e65dfe9b","version":"2.1.322","gitBranch":"HEAD"}
