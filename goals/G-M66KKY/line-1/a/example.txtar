-- words --
After a select, on a change that no branch merged, the owner runs the land line hyp status prints. The act exits 0 and records one land event that names the stop selected.
-- input/lib.sh --
# Shared helpers for the examples of the land Goal. Each example holds its own
# copy as input/lib.sh. The run section sources it from the subject's root.
bin=$(mktemp -d) && go build -o "$bin/hyp" ./cmd/hyp || exit 90
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
HOME=$(mktemp -d) && export HOME || exit 91
out=$(mktemp -d) || exit 91
d='--'

hy() { _a=$1 _r=$2; shift 2; HYP_ACTOR=$_a HYP_ROLE=$_r "$bin/hyp" "$@"; }
save() { git add -A && git commit -q -m "$1"; }
not() { if [ "$1" = yes ]; then echo no; else echo yes; fi; }
yn() { if [ "$1" = 0 ]; then echo yes; else echo no; fi; }
events() { cat .tree/events/*.jsonl 2>/dev/null | sort; }
state() { hy grill grill status "$1" 2>/dev/null | head -n 1 | awk '{ print $2 }'; }
stopline() { hy grill grill status "$1" 2>/dev/null | sed -n 's/^stop: //p' | head -n 1; }

# mkrepo: a repository with one Goal on the file f; sets g, base and f.
mkrepo() { r=$(mktemp -d) && cd "$r" && git init -q -b main && echo hello >greet.txt && save base && addgoal a.txt; }
# addgoal FILE: a Goal whose one gap line needs FILE to say bye.
addgoal() { f=$1 && base=$(git rev-parse HEAD) && g=$(hy owner owner add goal --base HEAD --words "Say bye in $f." --line "gap:$f says bye." 2>/dev/null | sed -n 's/^recorded //p') && [ -n "$g" ] && save "record $g"; }
# mkex FOLDER: an example whose run prints the file f and needs bye.
mkex() { mkdir -p "$1/probe" && cp "$HYP_EXAMPLE/probe/run" "$1/probe/run" && chmod +x "$1/probe/run" && printf '%s words %s\n%s says bye.\n%s run %s\ncat %s\n%s floor: contains %s\nbye\n' "$d" "$d" "$f" "$d" "$d" "$f" "$d" "$d" >"$1/example.txtar"; }
# opened: place line-1/a; the place runs it on H0, so the Goal is open.
opened() { mkex "goals/$g/line-1/a" && save "example of $g" && hy grill grill place "$g" line-1/a >/dev/null 2>&1 && save "place $g"; }
# change TEXT: commit f with TEXT, and a spec for the Goal.
change() { echo "$1" >"$f" && mkdir -p "goals/$g/specs" && echo "$1" >"goals/$g/specs/spec.txt" && save "change $1"; }
# runhead: run line-1 on HEAD and commit the Result.
runhead() { hy runner-1 runner run HEAD "$g/line-1" >"$out/run" 2>&1; save "run $g"; }
# selected: open, one change that says bye, a run, and the select status prints.
selected() { opened && change bye && runhead && s=$(hy runner-1 runner status "$g" --role runner 2>/dev/null | sed -n 's/^  hyp select /select /p' | head -n 1) && [ -n "$s" ] && hy runner-1 runner $s >"$out/select" 2>&1 && save "select $g"; }
# budgetused: open, then three changes that do not say bye.
budgetused() { opened && for t in x1 x2 x3; do change "$t" && runhead || return 1; done; }
# twocand: two sibling changes that each say bye, run on two branches, merged.
twocand() { opened && git switch -q -c side && echo bye >"$f" && echo side >side.txt && mkdir -p "goals/$g/specs" && echo b >"goals/$g/specs/b.txt" && save 'change on side' && runhead && git switch -q main && echo bye >"$f" && mkdir -p "goals/$g/specs" && echo a >"goals/$g/specs/a.txt" && save 'change on main' && runhead && git merge -q --no-edit side >/dev/null 2>&1; }
# owneracts G: the lines under "owner may:" for Goal G.
owneracts() { hy owner owner status "$1" --role owner 2>/dev/null | awk '/^owner may:$/ { p = 1; next } p && /^  / { print; next } { p = 0 }'; }
# landline G: the land act hyp prints to the owner for G, without "hyp ".
landline() { owneracts "$1" | sed -n 's/^  hyp land /land /p' | head -n 1; }
# land G ROLE: run the land line hyp printed; exit code in lc, output in $out/land.
land() { l=$(landline "$1"); if [ -z "$l" ]; then : >"$out/land"; lc=none; return 1; fi; hy owner "${2:-owner}" $l >"$out/land" 2>&1; lc=$?; save "land $1"; return 0; }
# snap N: save the sorted log as N; added A B: the events B holds and A does not.
snap() { events >"$out/ev.$1"; }
added() { comm -13 "$out/ev.$1" "$out/ev.$2"; }
same() { if cmp -s "$out/ev.$1" "$out/ev.$2"; then echo yes; else echo no; fi; }
# flat: lower case, letters and digits only, so "budget used" reads budgetused.
flat() { tr 'A-Z' 'a-z' | tr -cd 'a-z0-9\n'; }
# actsin ROLE: the act lines under "ROLE may:" of a state block on stdin.
actsin() { awk -v r="$1 may:" '$0 == r { p = 1; next } p && /^  / { print; next } { p = 0 }'; }
# stopblock: the lines from "stop:" up to "waits:" of a state block on stdin.
stopblock() { awk '/^stop:/ { p = 1 } /^waits:/ { p = 0 } p'; }
# lastid TYPE: the id of the last event of TYPE in the log.
lastid() { events | grep "\"type\":\"$1\"" | tail -n 1 | sed 's/.*"id":"\([^"]*\)".*/\1/'; }
# has TEXT: yes when stdin contains TEXT.
has() { if grep -qF -- "$1"; then echo yes; else echo no; fi; }
# landcheck A B WORD ID: the events between snaps A and B hold one land event
# that names the stop by WORD (letters only) or by the id of the act behind it.
landcheck() {
  e=$(added "$1" "$2")
  echo "new events: $(printf '%s\n' "$e" | grep -c .)"
  echo "land event: $(printf '%s\n' "$e" | grep -c '"type":"[^"]*land' | sed 's/^0$/no/;s/^[1-9].*/yes/')"
  fe=$(printf '%s' "$e" | flat) fw=$(printf '%s' "$3" | flat) fi=$(printf '%s' "$4" | flat)
  n=no
  if [ -n "$fe" ] && [ -n "$fw" ]; then case "$fe" in *"$fw"*) n=yes ;; esac; fi
  if [ -n "$fe" ] && [ -n "$fi" ]; then case "$fe" in *"$fi"*) n=yes ;; esac; fi
  echo "names the stop: $n"
}
-- run --
. "$HYP_EXAMPLE/input/lib.sh"
mkrepo || exit 92
git switch -q -c change && selected || exit 93
sel=$(lastid select)
snap 0
land "$g" || echo "land line: none"
snap 1
echo "land exit: $lc"
landcheck 0 1 selected "$sel"
-- floor: equals --
land exit: 0
new events: 1
land event: yes
names the stop: yes
