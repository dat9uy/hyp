+    "standin-a.md"
+   ],
+   "assertions": [
+    {
+     "id": "has-goal",
+     "text": "The grill wrote at least one Goal with lines.",
+     "kind": "json-equals",
+     "path": "has_goal.json",
+     "expected": {
+      "pass": true
+     }
+    },
+    {
+     "id": "l1-store",
+     "text": "Each Goal with lines that the grill wrote is in a store under the directory the clone's AGENTS.md names for trees (investigations/), in the existing store there that holds a Goal of the issue's parent when one does, and no store is at the clone's top directory.",
+     "kind": "json-equals",
+     "path": "l1.json",
+     "expected": {
+      "pass": true
+     }
+    },
+    {
+     "id": "l1-init",
+     "text": "conversation.md shows no hyp init run in the clone's top directory: every hyp init the grill ran has a cwd, or a cd in the same command, inside a directory below the top."
+    },
+    {
+     "id": "l2",
+     "text": "The issue's candidate is a read command (hyp prompt). No [N] line of a Goal the grill wrote says that a write is refused or that a log is rejected on replay, and each [N] line names the output, exit code or refusal by which the candidate's tests decide it."
+    },
