-- words --
Run writes no git: on open Goal G-ONE, the runner runs line-1 on commit C1; the store in git does not change.
-- run --
HYP_ACTOR=runner-one HYP_ROLE=runner hyp run C1 G-ONE/line-1 >/dev/null 2>&1; echo "run exit: $?"; echo "store changes: $(git status --porcelain --untracked-files=all .tree | wc -l | tr -d ' ')"
-- floor: contains --
run exit: 0
-- floor: contains --
store changes: 0
