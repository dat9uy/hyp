-- words --
On a committed store, hyp refuses a run, a select and a place (exit 1, each says why and prints the Goal) and a status of an unknown Goal (exit 2, says why); afterwards git status shows no change.
-- run --
bin=$(mktemp -d) && go build -o "$bin/hyp" ./cmd/hyp || exit 90
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
repo=$(mktemp -d) && cd "$repo" && git init -q && git commit -q --allow-empty -m base || exit 91
g=$(HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" add goal --base HEAD --words 'Say hello.' --line 'gap:hyp says hello.' | sed -n 's/^recorded //p') && [ -n "$g" ] || exit 92
git add -A && git commit -q -m 'record the Goal' || exit 93
h=$(git rev-parse HEAD)
hy() { a=$1 r=$2; shift 2; out=$(HYP_ACTOR=$a HYP_ROLE=$r "$bin/hyp" "$@" 2>"$bin/err"); c=$?; case "$out" in *"$g"*) n=yes ;; *) n=no ;; esac; if [ -s "$bin/err" ]; then w=yes; else w=no; fi; echo "$a: hyp $(echo "$*" | sed "s/$g/G/g"): exit $c, names the Goal: $n, stderr: $w"; }
hy runner-1 runner run HEAD "$g/line-1"
hy runner-1 runner select "$g" 4b825dc642cb6eb9a060e54bf8d69288fbee4904
hy grill grill place "$g" line-1/a
hy owner owner status G-AAAAAA
ch=$(git status --porcelain --untracked-files=all); echo 'changes git sees:'; if [ -n "$ch" ]; then printf '%s\n' "$ch"; else echo none; fi
if [ "$(git rev-parse HEAD)" = "$h" ]; then echo 'HEAD moved: no'; else echo 'HEAD moved: yes'; fi
echo "files git is told to skip: $(git ls-files -v | grep -c '^[a-zS]')"
-- floor: equals --
runner-1: hyp run HEAD G/line-1: exit 1, names the Goal: yes, stderr: yes
runner-1: hyp select G 4b825dc642cb6eb9a060e54bf8d69288fbee4904: exit 1, names the Goal: yes, stderr: yes
grill: hyp place G line-1/a: exit 1, names the Goal: yes, stderr: yes
owner: hyp status G-AAAAAA: exit 2, names the Goal: no, stderr: yes
changes git sees:
none
HEAD moved: no
files git is told to skip: 0
