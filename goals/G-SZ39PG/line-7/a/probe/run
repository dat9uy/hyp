#!/bin/sh
# Probe of G-SZ39PG line-7/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test Goal and drives it to selected
# (one placed fixture example, a row that meets it, the select), adds a finding
# that stays not folded, then runs hyp land as the owner. It prints the land's
# output with the Goal id replaced by G, then "land recorded: yes" if the land
# exited 0 and "land recorded: no" if not, then a last line "exit N". Setup
# output goes to stderr. The finding command does not exist on H0: its failure
# is printed and the probe goes on. A build or store failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }
step() { echo "setup: $*" >&2; }
commit() { git add -A && git commit -q -m "$1" >&2 || fail "commit $1"; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit goal

d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
{
  echo '-- words --'
  echo "Fixture line-1/a."
  echo '-- run --'
  echo "cat greet.txt"
  echo '-- floor: contains --'
  echo "bye"
} >"$d/example.txtar"
cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
# Run the example's run section in the subject copy (the working directory),
# print its stdout, then a last line "exit N" with its exit code.
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
chmod +x "$d/probe/run"
# A select needs a spec file in the selected commit.
mkdir -p "goals/$G/specs" && echo spec >"goals/$G/specs/spec.txt" || fail "spec"
commit fixtures
step "hyp place"
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
commit placed

# A runner runs a commit on branch cand that meets the example, and selects it.
git checkout -q -b cand >&2 || fail "checkout cand"
echo bye >greet.txt
commit candidate
row=$(git rev-parse HEAD)
step "hyp run"
ran=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run "$row" "$G/line-1") || fail "hyp run: $ran"
printf '%s\n' "$ran" >&2
HASH=$(printf '%s\n' "$ran" | sed -n 's/^row: //p' | head -n 1)
[ -n "$HASH" ] || fail "no row in: $ran"
step "hyp select"
HYP_ACTOR=runner HYP_ROLE=runner hyp select "$G" "$HASH" >&2 || fail "hyp select failed"
git add -A && git commit -q -m events >&2 # nothing may be left unstaged
git checkout -q main >&2 || fail "checkout main"
git merge -q cand >&2 || fail "merge cand"

# The finding command does not exist on H0: print its failure and go on.
step "hyp finding add"
HYP_ACTOR=owner HYP_ROLE=owner hyp finding add "$G" --fact "a fact" --evidence R-1 >&2

export HYP_ACTOR=owner HYP_ROLE=owner
out="$work/out"
step "hyp land"
hyp land "$G" >"$out" 2>&1
code=$?
sed -e "s/$G/G/g" "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
if [ "$code" -eq 0 ]; then echo "land recorded: yes"; else echo "land recorded: no"; fi
echo "exit $code"
exit 0
