#!/bin/sh
# Probe of G-SZ39PG line-6/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a temp git repo with a Goal G and its
# .tree/ committed, and runs the example's run section line by line with G
# replaced by the Goal and F by the id the add printed (F-NONE when none).
# It prints the Goal state lines before and after, each command with its
# output, then ".tree/ changed: no" when git status --short .tree printed
# nothing, else ".tree/ changed: yes". The last line is "exit N", the exit code
# of the last command of the run section. A build or setup failure exits 3.
# A hyp finding command that fails (it does not exist on H0) is printed and
# the run goes on.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
git add -A && git commit -q -m goal >&2 || fail "commit goal"

export HYP_ACTOR=owner HYP_ROLE=owner

state() { hyp status "$G" 2>&1 | grep -m 1 '^G-' || echo "(no status line)"; }
echo "before: $(state)"

printf '%s\n' "$HYP_RUN" >"$work/lines"
F=F-NONE
code=0
while IFS= read -r line; do
  [ -n "$line" ] || continue
  cmd=$(printf '%s' "$line" | sed -e "s# G\([ /]\)# $G\1#g" -e "s# G\$# $G#" \
    -e "s# F\([ /]\)# $F\1#g" -e "s# F\$# $F#")
  echo "\$ $cmd"
  sh -c "$cmd" >"$work/o" 2>&1
  code=$?
  if [ "$code" = 0 ]; then cat "$work/o"; else tail -n 1 "$work/o"; fi
  if [ -n "$(tail -c 1 "$work/o")" ]; then echo; fi
  if [ "$code" = 0 ]; then
    id=$(sed -n 's/.*\(F-[A-Z0-9][A-Z0-9]*\).*/\1/p' "$work/o" | head -n 1)
    [ -n "$id" ] && F=$id
  fi
done <"$work/lines"

echo "after: $(state)"
if [ -z "$(git status --short .tree)" ]; then
  echo ".tree/ changed: no"
else
  echo ".tree/ changed: yes"
fi
echo "exit $code"
exit 0
