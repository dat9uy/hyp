+{"type":"session-owner","accountUuid":"61c0dc2c-da2f-41ad-8a06-4c79a78f1d15","organizationUuid":"a1adefea-aeae-4878-8b40-371d459fc3e4","sessionId":"ea4155e0-5290-43bb-8480-42acd6eefa1d"}
