#!/bin/sh
# Probe of G-9KAEW6 line-2/a. The working directory is a copy of the subject.
# It builds hyp from the subject, runs the example's run section (hyp spec)
# with that binary and prints its stdout, then says whether every guard row of
# the guards: block holds a field "checked at replay:".
# The last line is "exit N", the exit code of the run section. Setup output
# goes to stderr. A build or setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export PATH="$work/bin:$PATH"

out="$work/out"
sh -c "$HYP_RUN" >"$out" 2>"$work/err"
code=$?
cat "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi

# The guard rows of the guards: block, one per line: "name<TAB>row". A row
# starts with two spaces and a non-space and holds a "rule:" field; the block
# ends at the first blank line. The name is the text before the row's first
# run of two spaces. "(no guard)" names no guard, so it is not a guard row.
awk '
/^guards:/ { inb = 1; next }
inb && /^$/ { exit }
inb && /^  [^ ]/ && /  rule:/ {
  row = substr($0, 3)
  name = row; sub(/  .*$/, "", name)
  if (name != "(no guard)") print name "\t" row
}
' "$out" >"$work/rows"

missing=$(awk -F '\t' 'index($2, "checked at replay:") == 0 { print $1; exit }' "$work/rows")
if [ ! -s "$work/rows" ]; then
  echo "a guard says nothing about replay: (no guard found)"
elif [ -n "$missing" ]; then
  echo "a guard says nothing about replay: $missing"
else
  echo "every guard says whether replay checks it"
fi

echo "exit $code"
exit 0
