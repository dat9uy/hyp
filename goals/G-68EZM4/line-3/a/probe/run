#!/bin/sh
# Probe of an example whose store holds an event of a kind written by hand. The working directory is a copy of
# the subject. It builds hyp from the subject and makes a test repo whose Goal has one gap line and one example,
# added by the owner and committed. Then it writes by hand, outside hyp, one event file of the kind the example
# names: for line-3/a a budget.reset under .tree/events/owner/ committed in git, for line-3/b a result.retract
# in the clone's trace. The file is well formed (version 2, a valid ULID later than the goal.add, the actor of
# its folder or file), so its only fault is its type. GOAL in the run section is replaced by the Goal id. It
# prints the stdout with ids mapped to tokens, then a last line "exit N". Setup output goes to stderr. A setup
# failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'bad\n' >counter

mkdir -p goals/draft-g/line-1/a/probe || fail "mkdir example"
printf '%s\n' '-- words --' 'The counter says ok.' '-- run --' 'cat counter' \
  '-- floor: contains --' 'ok' >goals/draft-g/line-1/a/example.txtar || fail "example"
cp "$work/generic-run" goals/draft-g/line-1/a/probe/run && chmod +x goals/draft-g/line-1/a/probe/run || fail "probe copy"
git add -A && git commit -q -m base >&2 || fail "commit base"

owner() { HYP_ACTOR=owner HYP_ROLE=owner hyp "$@"; }

owner add goal --base HEAD --words 'Count.' --line 'gap:the counter says ok.' --examples goals/draft-g >"$work/add" 2>&1 || { cat "$work/add" >&2; fail "add goal"; }
cat "$work/add" >&2
goal=$(grep -o 'G-[0-9A-Z]\{6\}' "$work/add" | head -1)
[ -n "$goal" ] || fail "no Goal id"
git add -A && git commit -q -m goal >&2 || fail "commit goal"

# a ULID later than the goal.add: a fixed id in the far future, so every id hyp writes in the test repo sorts before it
late=01ZZZZZZZZZZZZZZZZZZZZZZZZ
mkdir -p .tree/events/owner || fail "mkdir events"
printf '{"v":2,"id":"%s","ts":"2026-01-01T00:00:00.000Z","actor":"owner","type":"budget.reset","node":"%s","payload":{"role":"owner"},"why":""}\n' \
  "$late" "$goal" >".tree/events/owner/$late.json" || fail "write budget.reset"
git add -A && git commit -q -m 'budget.reset by hand' >&2 || fail "commit budget.reset"

run=$(printf '%s' "$HYP_RUN" | sed -e "s/GOAL/$goal/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$goal/GOAL/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
