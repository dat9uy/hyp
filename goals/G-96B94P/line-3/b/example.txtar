-- words --
2b wrong kind: a Hypothetical item held by a finding gives holder-kind for that item and exits 1.
-- input/body.md --
| Item | Tag | Holder |
|---|---|---|
| demo-I1 | Fact | F-ABC123 |
| demo-I3 | Hypothetical | F-ABC123 |
-- run --
python3 skills/hyp-grill/scripts/check_holders.py "$HYP_EXAMPLE/input/body.md"
echo "exit code: $?"
-- floor: contains --
holder-kind demo-I3
-- floor: contains --
exit code: 1
-- ceiling --
demo-I1
