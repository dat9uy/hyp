-- words --
When the model has more states than the chart budget, goal.md shows no variant as separated by none, and lists every example to try on the patch of every variant: a counter model with more than 500 states and one example, line-1/a.
-- run --
out=$(mktemp -d); skills/hyp-statechart/scripts/statechart goals/G-TEST00/specs/goal.tla --config goals/G-TEST00/specs/goal.cfg --view goals/G-TEST00/specs/goal-view.mjs --out "$out" >"$out/log" 2>&1; echo "tool exit $?"; cat goals/G-TEST00/specs/goal.md "$out/log"
-- floor: contains --
Try each one on the patch of every variant
-- floor: contains --
- line-1/a
-- ceiling --
| Separated by | none
-- findings --
F-M9T1KP
