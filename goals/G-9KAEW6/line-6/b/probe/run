#!/bin/sh
# Probe of G-9KAEW6 line-6/b. The working directory is a copy of the subject.
# It builds hyp from the subject and makes a test git repository, clone A,
# with a test Goal: one gap line and one fixture example with the generic
# Probe, placed. The example reads $HOME/greet.txt, which says hello at the
# place, so git holds "failed". Then the file says bye, and a fresh clone of
# clone A, clone B, with an empty trace, runs the `hyp try` line that
# `hyp status G` prints, else `hyp try G line-1/a`: this clone gets "met".
# Then it runs the example's run section in clone B with "G" replaced by the
# test Goal. It prints the run's stdout with the test Goal's id replaced by
# "G", then a last line "exit N". Setup output goes to stderr. A build or
# setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }
step() { echo "setup: $*" >&2; }
commit() { git add -A && git commit -q -m "$1" >&2 || fail "commit $1"; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

# Clone A: the test Goal, its fixture example, placed.
repo="$work/a"
mkdir -p "$repo" && cd "$repo" || fail "mkdir clone A"
git init -q -b main >&2 || fail "git init"
echo base >base.txt; echo hello >"$HOME/greet.txt"
commit base
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit goal
d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
{
  echo '-- words --'
  echo "Fixture line-1/a."
  echo '-- run --'
  echo "cat \"\$HOME/greet.txt\""
  echo '-- floor: contains --'
  echo "bye"
} >"$d/example.txtar"
cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
# Run the example's run section in the subject copy (the working directory),
# print its stdout, then a last line "exit N" with its exit code.
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
chmod +x "$d/probe/run"
mkdir -p "goals/$G/specs" && echo spec >"goals/$G/specs/spec.txt" || fail "spec"
commit fixtures
step "hyp place $G"
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
git add -A && { git diff --cached --quiet || git commit -q -m placed >&2; } || fail "commit placed"

# The file the fixture reads now says bye: clone B gets a different verdict.
echo bye >"$HOME/greet.txt"

# Clone B: a fresh clone of clone A, with an empty trace.
b="$work/b"
git clone -q "$repo" "$b" >&2 || fail "git clone"
cd "$b" || fail "cd clone B"

# Run the cell again in clone B with the try line that `hyp status G` prints.
export HYP_ACTOR=reader
before=$(hyp status "$G") || fail "hyp status: $before"
printf '%s\n' "$before" >&2
try=$(printf '%s\n' "$before" | grep -m 1 '^ *hyp try G' | sed -e 's/^ *//' -e 's/`.*$//')
[ -n "$try" ] || try="hyp try $G line-1/a"
step "$try"
sh -c "$try" >&2; step "exit $?"

# The run section names the Goal "G": put the test Goal's id in its place.
export G HYP_ACTOR=reader
cmd=$(printf '%s\n' "$HYP_RUN" | sed -E "s/(^|[^A-Za-z0-9_-])G([^A-Za-z0-9_-]|\$)/\1$G\2/g")
out="$work/out"
sh -c "$cmd" >"$out"
code=$?
sed "s/$G/G/g" "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
echo "exit $code"
exit 0
