#!/bin/sh
# Probe of G-9KAEW6 line-3/c. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test store with a test Goal (one gap
# line, one fixture example with the generic Probe), places the example and
# commits the place. It runs the example's run section in that same repo, the
# clone that placed, and prints its stdout with the Goal id replaced by G. It
# then looks in that clone's trace,
# $HOME/.hyp/traces/<sha256 of the clone's git common dir>/outputs, for a file
# that holds exactly the bytes hyp stores for the fixture example's H0 output. The last
# line is "exit N", the exit code of the run section. Setup output goes to
# stderr. A build or store failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') ||
  fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
git add -A && git commit -q -m goal >&2 || fail "commit goal"

d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
{
  echo '-- words --'
  echo "Fixture line-1/a."
  echo '-- run --'
  echo "cat greet.txt"
  echo '-- floor: contains --'
  echo "bye"
} >"$d/example.txtar"
cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
# Run the example's run section in the subject copy (the working directory),
# print its stdout, then a last line "exit N" with its exit code.
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
chmod +x "$d/probe/run"
git add -A && git commit -q -m fixtures >&2 || fail "commit fixtures"
echo "setup: hyp place $G" >&2
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
git add -A && git commit -q -m placed >&2 || fail "commit placed"

export G HYP_ACTOR=owner HYP_ROLE=owner
out="$work/out"
# The run section names the Goal G: replace that word with the test Goal id.
run=$(printf "%s\n" "$HYP_RUN" | sed -E "s/(^|[^A-Za-z0-9_-])G([^A-Za-z0-9_-]|\$)/\\1$G\\2/g")
sh -c "$run" >"$out"
code=$?
sed "s/$G/G/g" "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi

# The fixture's H0 output as hyp stores it: the generic Probe prints
# "hello\nexit 0\n"; hyp drops the last line "exit N" and one final newline.
printf 'hello' >"$work/expected"

common=$(cd "$(git rev-parse --path-format=absolute --git-common-dir)" && pwd -P) ||
  fail "git common dir"
key=$(printf '%s' "$common" | shasum -a 256 | cut -d ' ' -f 1)
trace="$HOME/.hyp/traces/$key"
found=no
if [ -d "$trace/outputs" ]; then
  for f in $(find "$trace/outputs" -type f); do
    if cmp -s "$f" "$work/expected"; then
      found=yes
      break
    fi
  done
fi
if [ "$found" = yes ]; then
  echo "H0's output is in this clone's trace"
else
  echo "H0's output is not in this clone's trace"
fi

echo "exit $code"
exit 0
