ash(rel)\n\n\tvar b strings.Builder\n\tfmt.Fprintf(&b, \"/goal Run the hyp tree in %s with the hyp-goal-run skill, as HYP_ACTOR=%s. Its Goal is %s: read it with hyp show %s, read hyp status %s, and name --goal %s on every hyp checkpoint.\\n\", rel, *actor, g, g, g, g)\n\tfmt.Fprintf(&b, \"Done when the latest printed hyp status %s shows \\\"runner owes nothing: stop and report to the owner\\\" under OWED, or %d Results have been recorded under %s, or you cannot take the next step honestly and say why.\\n\", g, *experiments, *actor)\n\tfor _, l := range block {\n\t\tb.WriteString(l)\n\t\tb.WriteString(\"\\n\")\n\t}\n\tif *branch != \"\" {\n\t\tfmt.Fprintf(&b, \"Commit on the branch %s.\\n\", *branch)\n\t}\n\tif *pr > 0 {\n\t\tfmt.Fprintf(&b, \"The run's PR is #%d.\\n\", *pr)\n\t}\n\tfmt.Fprint(stdout, b.String())\n\treturn nil\n}\n9c8e498 Merge pull request #140 from dat9uy/feat/goal-prompt\n6f39ec0 docs: record the goal-prompt select of 04142f3 and the stop\naef2d5b docs: record the goal-prompt reviews of 3cfd08d, d2d5d14 and 04142f3, their gates and the stop\n04142f3 fix: test that a bad block line in a store outside every repository exits 1\nd2d5d14 fix: test that an invalid block in a store outside every repository exits 1\nafc5aea docs: record the goal-prompt review of 2284172, the gate of 3cfd08d and the stop\n3cfd08d fix: test a CRLF body's printed block and a store outside every repository with no block, and state the check order\n6cb84e8 docs: record the goal-prompt answers applied, the review of 5c5902d and the gate of 2284172\n2284172 fix: test that a store linked into a repository from outside exits 3, and state it in the spec\nabc61fe docs: record the owner's answers to the goal-prompt readings\n867c02b Merge pull request #139 from dat9uy/docs/goal-prompt-tree\n350db2c docs: record the goal-prompt build runs on 5c5902d and the stop\n5c5902d fix: hyp prompt reads the store's real path and states its line rules\n9414185 docs: record the goal-prompt build r