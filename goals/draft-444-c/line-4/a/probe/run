#!/bin/sh
# Probe of line-4/a. The working directory is a copy of the subject. It builds hyp from the subject and
# makes a test repo whose Goal (added by the owner without examples, its one gap example written and placed)
# has a runner's commit ROW, a child of the Goal's base, built for this example (MODE=other). ROW and GOAL
# in the run section are replaced by the commit and the Goal id. It prints the stdout, then the stderr, with
# ids and hashes mapped to tokens, then a last line "exit N". Setup output goes to stderr. A setup failure
# exits 3.
mode=other

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'bad\n' >counter
if [ "$mode" = delete ]; then
  mkdir -p goals/draft-x && printf 'x\n' >goals/draft-x/f || fail "draft-x"
fi
git add -A && git commit -q -m base >&2 || fail "commit base"
base=$(git rev-parse HEAD) || fail "base"

owner() { HYP_ACTOR=owner HYP_ROLE=owner hyp "$@"; }

addgoal() {
  owner add goal --base "$base" --words "$1" --line "gap:$2" >"$work/add" 2>&1 || { cat "$work/add" >&2; fail "add goal"; }
  cat "$work/add" >&2
  grep -o 'G-[0-9A-Z]\{6\}' "$work/add" | head -1
}

goal=$(addgoal 'Count.' 'the counter says ok.')
[ -n "$goal" ] || fail "no Goal id"
git add -A && git commit -q -m goal >&2 || fail "commit goal"

ex="goals/$goal/line-1/a"
mkdir -p "$ex/probe" || fail "mkdir example"
printf '%s\n' '-- words --' 'The counter says ok.' '-- run --' 'cat counter' \
  '-- floor: contains --' 'ok' >"$ex/example.txtar" || fail "example"
cp "$work/generic-run" "$ex/probe/run" && chmod +x "$ex/probe/run" || fail "probe copy"
git add -A && git commit -q -m example >&2 || fail "commit example"
owner place "$goal" >&2 || fail "place"

if [ "$mode" = other ]; then
  other=$(addgoal 'Other.' 'the other thing holds.')
  [ -n "$other" ] || fail "no other Goal id"
fi
git add -A && git commit -q -m events >&2 || fail "commit events"

# the runner's commit: a child of the Goal's base
git checkout -q -b row "$base" >&2 || fail "checkout row"
case "$mode" in
  add)    mkdir -p goals/draft-x && printf 'y\n' >goals/draft-x/f || fail "row file" ;;
  delete) git rm -q goals/draft-x/f >&2 || fail "row rm" ;;
  other)  mkdir -p "goals/$other" && printf 'y\n' >"goals/$other/f" || fail "row file" ;;
esac
git add -A >&2 && git commit -q -m row >&2 || fail "commit row"
row=$(git rev-parse HEAD) || fail "row"
git checkout -q main >&2 || fail "checkout main"

run=$(printf '%s' "$HYP_RUN" | sed -e "s/GOAL/$goal/g" -e "s/ROW/$row/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$goal/GOAL/g" -e "s/${other:-NOOTHER}/OTHER/g" -e "s/$row/ROW/g" -e "s/$base/BASE/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/\b[0-9a-f]\{40\}\b/HASH/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err"
echo "exit $code"
exit 0
