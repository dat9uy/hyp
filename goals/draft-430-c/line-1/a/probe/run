#!/bin/sh
# Probe of line-1/a. The working directory is a copy of the subject. It builds hyp from the
# subject, puts it on PATH, runs the example's run section, prints its stdout, then a last
# line "exit N". Build output goes to stderr. A build failure exits 3.
work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT
mkdir -p "$work/bin" || exit 3
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || { echo "probe: go build failed" >&2; exit 3; }
export PATH="$work/bin:$PATH"
sh -c "$HYP_RUN" >"$work/out" 2>"$work/err"
code=$?
cat "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
cat "$work/err" >&2
echo "exit $code"
exit 0
