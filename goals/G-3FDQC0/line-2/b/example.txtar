-- words --
After hyp refuses runner's run and the owner then changes the log, the owner runs hyp show runner and reads the exact refusal and state block that runner got.
-- run --
bin=$(mktemp -d) && go build -o "$bin/hyp" ./cmd/hyp || exit 90
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
repo=$(mktemp -d) && cd "$repo" && git init -q && git commit -q --allow-empty -m base || exit 91
g=$(HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" add goal --base HEAD --words 'Say hello.' --line 'gap:hyp says hello.' | sed -n 's/^recorded //p') && [ -n "$g" ] || exit 92
git add -A && git commit -q -m 'record the Goal' || exit 93
HYP_ACTOR=runner HYP_ROLE=runner "$bin/hyp" run HEAD "$g/line-1" >"$bin/out" 2>"$bin/err"; rc=$?
HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" add goal "$g" --base HEAD --words 'Say hello twice.' --line 'gap:hyp says hello.' --line 'gap:hyp says hello again.' >/dev/null 2>&1 || exit 94
HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" show runner >"$bin/view" 2>&1; vc=$?
out=$(cat "$bin/out"); err=$(cat "$bin/err"); view=$(cat "$bin/view")
case "$out" in *"$g"*) n=yes ;; *) n=no ;; esac
echo "runner: hyp run HEAD G/line-1: exit $rc, state block names the Goal: $n"
echo "owner: hyp show runner: exit $vc"
if [ -n "$err" ]; then case "$view" in *"$err"*) h=yes ;; *) h=no ;; esac; else h='no, the refusal is empty'; fi
echo "the owner's view holds the runner's refusal byte for byte: $h"
if [ -n "$out" ]; then case "$view" in *"$out"*) h=yes ;; *) h=no ;; esac; else h='no, the state block is empty'; fi
echo "the owner's view holds the runner's state block byte for byte: $h"
-- floor: equals --
runner: hyp run HEAD G/line-1: exit 1, state block names the Goal: yes
owner: hyp show runner: exit 0
the owner's view holds the runner's refusal byte for byte: yes
the owner's view holds the runner's state block byte for byte: yes
