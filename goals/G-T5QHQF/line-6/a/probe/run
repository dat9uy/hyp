#!/bin/sh
# Probe of G-T5QHQF line-6. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with a base commit holding
# greet.txt (hello) and the draft folder goals/draft-greet with line-1/a (floor
# bye) on main. It adds Goal G-ONE from the draft (the new form first, else H0's
# form: add, copy the draft, place), makes commit C1 (bye now) and C2 (bye) on
# their own branches, each with a chart in the Goal's specs folder, runs line-1 on C1 and, when status does not show the
# Goal selected, selects as status prints it. Then it runs the example's run
# section with G-ONE and C1 replaced by the real ids, prints its stdout with the
# real ids mapped back, then a last line "exit N". Setup output goes to stderr.
# A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/draft-probe" || fail "copy draft probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add -A && git commit -q -m base >&2 || fail "commit base"
# The draft folder, committed on main.
mkdir -p goals/draft-greet/line-1/a/probe || fail "mkdir draft"
cat >goals/draft-greet/line-1/a/example.txtar <<'DRAFT'
-- words --
The subject says bye.
-- run --
cat greet.txt
-- floor: contains --
bye
DRAFT
cp "$work/draft-probe" goals/draft-greet/line-1/a/probe/run
chmod +x goals/draft-greet/line-1/a/probe/run
commit_staged draft || fail "commit draft"

export HYP_ACTOR=owner HYP_ROLE=owner
if added=$(hyp add goal --base HEAD --words 'Greet.' --line 'gap:the subject says bye.' \
    --examples goals/draft-greet 2>"$work/adderr"); then
  :
else
  cat "$work/adderr" >&2
  # H0's form: add without examples, copy the draft, the grill places.
  added=$(hyp add goal --base HEAD --words 'Greet.' --line 'gap:the subject says bye.') \
    || fail "hyp add goal: $added"
  G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$G" ] || fail "no Goal id in: $added"
  commit_staged "goal $G" || fail "commit goal"
  mkdir -p "goals/$G" || fail "mkdir goal"
  cp -R goals/draft-greet/line-1 "goals/$G/line-1" || fail "copy draft"
  commit_staged "example of $G" || fail "commit example"
  HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
fi
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit_staged "goal $G" || fail "commit goal"

# C1 and C2 carry a chart in the Goal's specs folder, as a select needs.
mkspec() {
  mkdir -p "goals/$G/specs" || return 1
  printf '%s\n' 'stateDiagram-v2' '  hello --> bye' >"goals/$G/specs/chart.mmd"
}
git checkout -q -b c1 main >&2 || fail "checkout c1"
echo 'bye now' >greet.txt
mkspec || fail "spec c1"
git add -A && git commit -q -m c1 >&2 || fail "commit c1"
C1=$(git rev-parse HEAD)
git checkout -q -b c2 main >&2 || fail "checkout c2"
echo bye >greet.txt
mkspec || fail "spec c2"
git add -A && git commit -q -m c2 >&2 || fail "commit c2"
C2=$(git rev-parse HEAD)
git checkout -q main >&2 || fail "checkout main"

ran=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run "$C1" "$G/line-1") || fail "hyp run failed: $ran"
printf '%s\n' "$ran" >&2
commit_staged "run on c1" || fail "commit run"
if ! hyp status "$G" | head -1 | grep -q selected; then
  sel=$(HYP_ACTOR=runner HYP_ROLE=runner hyp status "$G" --role runner | grep -o "hyp select $G [^ ]*" | head -n 1)
  [ -n "$sel" ] || fail "no select line in status"
  echo "probe: $sel" >&2
  HYP_ACTOR=runner HYP_ROLE=runner $sel --why check >&2 || fail "select failed: $sel"
  commit_staged select || fail "commit select"
fi
hyp status "$G" | head -1 >&2

run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g" -e "s/C1/$C1/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() { sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" -e "s/$C1/C1/g" -e "s/$C2/C2/g" \
  -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
  -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"; }
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
