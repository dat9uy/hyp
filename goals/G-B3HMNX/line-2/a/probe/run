#!/bin/sh
# Probe of an example at a runner's run on a merge of its own fix and another Goal's fix R1.
# The working directory is a copy of the subject. It builds hyp from the subject and makes a test repo:
# H0 holds counter "counter: bad"; Goals A and B each have line-1 (gap: the counter says ok) and the
# generic Probe, both with H0 as their base. A's add commit is on main; B's add commit is made on a
# branch and merged into main with a merge commit, so the first-parent walk of the Own path guard stops
# at it. R1 is A's runner's fix on A's add commit: it adds a file other, which no example measures.
# ROW is B's runner's merge commit: B's fix (counter ok, a spec) on main, plus a merge of R1. ROW and
# GOAL in the run section are replaced by that commit and B's id. The runner's setup comes before the
# run section (none here).
# tokens, then a last line "exit N". Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'counter: bad\n' >counter
git add -A && git commit -q -m base >&2 || fail "commit base"
base=$(git rev-parse HEAD)

owner() { HYP_ACTOR=owner HYP_ROLE=owner hyp "$@"; }

# addgoal NAME: adds a Goal with the draft NAME of one example, on the base commit; sets goal
addgoal() {
  draft=$(HYP_ACTOR=owner hyp draft path "$1") || fail "draft path"
  d="$draft/line-1/a"
  mkdir -p "$d/probe" || fail "mkdir example"
  printf '%s\n' '-- words --' 'Example.' '-- run --' 'cat counter' '-- floor: contains --' 'counter:' '-- floor: contains --' 'ok' >"$d/example.txtar"
  cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
  owner add goal --base "$base" --words 'Count.' --line 'gap:the counter says ok.' --draft "$1" >"$work/add" 2>&1 || { cat "$work/add" >&2; fail "add goal"; }
  cat "$work/add" >&2
  goal=$(grep -o 'G-[0-9A-Z]\{6\}' "$work/add" | head -1)
  [ -n "$goal" ] || fail "no Goal id"
  git add -A && git commit -q -m "add $1" >&2 || fail "commit add $1"
}

# Goal A is added on main
addgoal x
goala=$goal
# Goal B is added on a branch, which main takes in with a merge commit
git checkout -q -b badd || fail "checkout badd"
addgoal y
goalb=$goal
git checkout -q main || fail "checkout main"
git merge -q --no-ff -m "merge add B" badd >&2 || fail "merge badd"
badd=$(git rev-parse HEAD)

# R1: A's runner's fix on A's add commit
git checkout -q -b r1 "$(git rev-list --max-parents=1 --grep='add x' -1 main)" || fail "checkout r1"
printf 'x\n' >other
git add -A && git commit -q -m "fix R1" >&2 || fail "commit R1"
r1=$(git rev-parse HEAD)

# ROW: B's runner's fix on main, plus a merge of R1
git checkout -q -b row main || fail "checkout row"
printf 'counter: ok\n' >counter
mkdir -p "goals/$goalb/specs" && printf 'spec\n' >"goals/$goalb/specs/spec.md" || fail "spec"
git add -A && git commit -q -m "fix B" >&2 || fail "commit fix B"
git merge -q --no-ff -m "merge R1" r1 >&2 || fail "merge R1"
row=$(git rev-parse HEAD)
git checkout -q main || fail "checkout main"

# BEFORE: the run section's setup

short() { echo "$1" | cut -c1-7; }
tokens() { sed -e "s/$goala/GOALA/g" -e "s/$goalb/GOAL/g" \
    -e "s/$row/ROW/g" -e "s/$r1/R1/g" -e "s/$badd/B_ADD/g" \
    -e "s/$(short "$row")[0-9a-f]*/ROW/g" -e "s/$(short "$r1")[0-9a-f]*/R1/g" -e "s/$(short "$badd")[0-9a-f]*/B_ADD/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"; }

run=$(printf '%s' "$HYP_RUN" | sed -E -e "s/(^|[^A-Za-z0-9_-])ROW([^A-Za-z0-9_-]|$)/\\1$row\\2/g" -e "s/(^|[^A-Za-z0-9_-])ROW([^A-Za-z0-9_-]|$)/\\1$row\\2/g" -e "s/GOAL/$goalb/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
tokens "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
tokens "$work/err" >&2
echo "exit $code"
exit 0
