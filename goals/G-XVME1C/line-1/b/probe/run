#!/bin/sh
# Probe of G-XVME1C line-1/b. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo whose base commit holds a
# kept model (rules OldRule and KeepsCount, one step tagged toy add), adds a
# Goal of one gap line with one placed example, commits one Hypothesis that
# changes the kept model (case b), runs the line on it and selects it. Then
# it runs the example's run section with G-ONE replaced by the real Goal id,
# prints its stdout with the real id replaced by G-ONE and timestamps by TIME,
# then a last line "exit N". Setup output goes to stderr. A setup failure
# exits 3.

case_id=b
work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
mkdir -p goals/model || fail "mkdir model"
printf '%s\n' '---- MODULE model ----' 'VARIABLE n' 'Init == n = 0' \
  '\* command: toy add' 'Inc == n'"'"' = n + 1' \
  'Spec == Init /\ [][Inc]_n' \
  '\* source: model only' 'OldRule == n \in {0, 1}' \
  '\* source: model only' 'KeepsCount == n >= 0' '====' >goals/model/model.tla || fail "model.tla"
printf '%s\n' 'SPECIFICATION Spec' 'INVARIANTS OldRule KeepsCount' >goals/model/model.cfg || fail "model.cfg"
git add -A && git commit -q -m base >&2 || fail "commit base"

# The owner adds the Goal.
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit_staged "goal $G" || fail "commit goal"

# The grill places one example, run by the generic Probe: the base fails it.
d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
cat >"$d/example.txtar" <<'EXAMPLE'
-- words --
The subject says bye.
-- run --
cat greet.txt
-- floor: contains --
bye
EXAMPLE
cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
chmod +x "$d/probe/run"
commit_staged "example of $G" || fail "commit example"
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
commit_staged placed || fail "commit placed"

specs="goals/$G/specs"

# The Hypothesis: bye, a chart, a variant config and the case's kept model.
git checkout -q -b h1 main >&2 || fail "checkout h1"
echo bye >greet.txt
mkdir -p "$specs/variants" || fail "mkdir specs"
printf '%s\n' 'stateDiagram-v2' '  hello --> bye' >"$specs/chart.mmd"
head='---- MODULE model ----
VARIABLE n
Init == n = 0'
inc='\* command: toy add
Inc == n'"'"' = n + 1'
fold='\* command: toy fold
Fold == n'"'"' = n'
spec='Spec == Init /\ [][Inc]_n'
old='\* source: model only
OldRule == n \in {0, 1}'
keeps='\* source: model only
KeepsCount == n >= 0'
new="\\* source: $G:line-1
NewRule == n \\in {0, 1, 2}"
invs='OldRule KeepsCount'
case "$case_id" in
  a|d) invs="$invs NewRule"; keeps="$keeps
$new" ;;
  b) old='\* source: model only
OldRule == n \in {0, 1, 3}' ;;
  c) inc="$inc
$fold"; spec='Spec == Init /\ [][Inc \/ Fold]_n'; invs="$invs NewRule"
     keeps="$keeps
$new" ;;
esac
printf '%s\n' "$head" "$inc" "$spec" "$old" "$keeps" '====' >goals/model/model.tla || fail "model.tla h1"
printf '%s\n' 'SPECIFICATION Spec' "INVARIANTS $invs" >goals/model/model.cfg || fail "model.cfg h1"
# Breaks.cfg names every rule the commit adds or changes.
case "$case_id" in
  b) vinv='OldRule' ;;
  *) vinv='NewRule' ;;
esac
printf '%s\n' 'SPECIFICATION Spec' "INVARIANTS $vinv" >"$specs/variants/Breaks.cfg"
commit_staged "hypothesis h1" || fail "commit h1"
c=$(git rev-parse HEAD)
git checkout -q main >&2 || fail "checkout main"
ran=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run "$c" "$G/line-1") || fail "hyp run failed: $ran"
printf '%s\n' "$ran" >&2
commit_staged "events of h1" || fail "commit events"

# The runner selects the candidate that its status offers.
sel=$(HYP_ACTOR=runner HYP_ROLE=runner hyp status "$G" --role runner | grep -o "hyp select $G [^ ]*" | head -n 1)
[ -n "$sel" ] || fail "no select line in status"
echo "probe: $sel" >&2
HYP_ACTOR=runner HYP_ROLE=runner $sel --why check >&2 || fail "select failed: $sel"
commit_staged "select" || fail "commit select"

export HYP_ACTOR=owner HYP_ROLE=owner
run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" -e 's/[0-9]\{4\}-[0-9-]*T[0-9:.]*Z/TIME/g' "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" "$work/err" >&2
echo "exit $code"
exit 0
