-- words --
Five files, one defect each, each giving its code and exit 1: the file whose only defect is id-missing.
-- input/page.json --
{
 "id": "demo",
 "items": [
  {
   "tag": "Proposed",
   "date": "2026-11-28",
   "text": "Store items as data."
  }
 ],
 "parties": [
  {
   "id": "owner",
   "label": "Owner"
  },
  {
   "id": "agent",
   "label": "Agent"
  },
  {
   "id": "tool",
   "label": "Tool"
  }
 ],
 "approaches": [
  {
   "name": "A",
   "concept_at": "owner",
   "steps": [
    "The owner writes the item."
   ]
  },
  {
   "name": "B",
   "concept_at": "agent",
   "steps": [
    "The agent writes the item."
   ]
  },
  {
   "name": "C",
   "concept_at": "tool",
   "steps": [
    "The tool writes the item."
   ]
  }
 ]
}
-- run --
test -f skills/hyp-rethinking/scripts/check_items.py && echo 'check_items.py ships'
python3 skills/hyp-rethinking/scripts/check_items.py "$HYP_EXAMPLE/input/page.json"
echo "exit code: $?"
-- floor: contains --
check_items.py ships
-- floor: contains --
id-missing
-- floor: contains --
items[0]
-- floor: contains --
exit code: 1
-- ceiling --
id-duplicate
-- ceiling --
id-prefix
-- ceiling --
tag-unknown
-- ceiling --
field-unknown
