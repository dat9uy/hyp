#!/bin/sh
# Probe of G-FZ9E1G line-5/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with no goals/model/,
# adds an open Goal with one placed example, records a finding with free text
# that no Goal names, then runs the example's run section with G-ONE replaced
# by the real Goal id. It prints the stdout with the real Goal id replaced by
# G-ONE, finding ids by F-XXXXXX and timestamps by TIME, then a last line
# "exit N". Setup output goes to stderr. A setup failure exits 3.

case_id=a
work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"
export HYP_ACTOR=owner HYP_ROLE=owner
export TOYBIN="$work/toybin"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add -A && git commit -q -m base >&2 || fail "commit base"

added=$(hyp add goal --base HEAD --words 'Greet.' --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit_staged "goal $G" || fail "commit goal"

d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
cat >"$d/example.txtar" <<'EXAMPLE'
-- words --
The subject says bye.
-- run --
toy list
-- floor: contains --
bye
EXAMPLE
cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
mkdir -p "$TOYBIN" && printf '#!/bin/sh\necho "toy $*"\n' >"$TOYBIN/toy" && chmod +x "$TOYBIN/toy"
PATH="$TOYBIN:$PATH"
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
chmod +x "$d/probe/run"
commit_staged "example of $G" || fail "commit example"
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
commit_staged placed || fail "commit placed"
hyp finding add --fact 'nothing shows' --evidence 'seen in a run' >&2 || fail "finding add"
commit_staged finding || fail "commit finding"

export HYP_ACTOR=owner HYP_ROLE=owner
run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" -e 's/F-[A-Z0-9]\{6\}/F-XXXXXX/g' -e 's/[0-9]\{4\}-[0-9-]*T[0-9:.]*Z/TIME/g' "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" "$work/err" >&2
echo "exit $code"
exit 0
