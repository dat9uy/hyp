#!/bin/sh
# Probe of G-MH24W6 line-5/a. The working directory is a copy of the subject.
# It builds hyp from the subject, then makes a store with one written Goal, one
# open Goal, one selected Goal and one landed Goal, runs hyp status with no
# Goal as the owner and prints its stdout, then a last line "exit N". Setup
# output goes to stderr. A build or setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }
step() { echo "setup: $*" >&2; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo ".tree/" >.git/info/exclude
echo bad >counter
git add counter && git commit -q -m base >&2 || fail "commit base"
base=$(git rev-parse HEAD)

# newgoal NAME: add a Goal with one gap line; print its id.
newgoal() {
  out=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base "$base" --words "Goal $1." \
    --line 'gap:the counter does not hold ok.') || fail "hyp add goal $1: $out"
  id=$(printf '%s\n' "$out" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$id" ] || fail "no Goal id in: $out"
  echo "$id"
}

# example G: commit the example folder of line-1/a of G.
example() {
  d="goals/$1/line-1/a"
  mkdir -p "$d/probe" || fail "mkdir $d"
  printf -- '-- words --\nThe counter holds ok.\n-- run --\ncat counter\n-- floor: contains --\nok\n' >"$d/example.txtar"
  cat >"$d/probe/run" <<'PROBE'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
PROBE
  chmod +x "$d/probe/run"
  git add -A && git commit -q -m "example $1" >&2 || fail "commit example $1"
}

place() {
  step "place $1"
  HYP_ACTOR=grill HYP_ROLE=grill hyp place "$1" >&2 || fail "hyp place $1"
}

# pick G: run a fix commit (counter ok, with a spec) on a branch from base,
# select it, then return to main.
pick() {
  git checkout -q -b "fix-$1" "$base" || fail "branch fix-$1"
  echo ok >counter
  mkdir -p "goals/$1/specs" && echo "spec" >"goals/$1/specs/spec.md"
  git add -A && git commit -q -m "fix $1" >&2 || fail "commit fix $1"
  step "run $1"
  ran=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run HEAD "$1/line-1") || fail "hyp run $1: $ran"
  echo "$ran" >&2
  tree=$(printf '%s\n' "$ran" | sed -n 's/^row: //p' | head -n 1)
  [ -n "$tree" ] || fail "no row in: $ran"
  step "select $1"
  HYP_ACTOR=runner HYP_ROLE=runner hyp select "$1" "$tree" >&2 || fail "hyp select $1"
  git checkout -q main || fail "checkout main"
}

W=$(newgoal written)
O=$(newgoal open)
S=$(newgoal selected)
L=$(newgoal landed)

example "$O"; example "$S"; example "$L"
place "$O"; place "$S"; place "$L"
pick "$S"
pick "$L"
step "land $L"
HYP_ACTOR=owner HYP_ROLE=owner hyp land "$L" >&2 || fail "hyp land $L"

export HYP_ACTOR=owner HYP_ROLE=owner
out="$work/out"
hyp status >"$out"
code=$?
sed -e "s/$W/G-WRITTEN/g" -e "s/$O/G-OPEN/g" -e "s/$S/G-SELECTED/g" -e "s/$L/G-LANDED/g" "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
echo "exit $code"
exit 0
