#!/bin/sh
# Probe of the examples of the Goal that lets the owner place after a select. The working
# directory is a copy of the subject. It builds hyp from the subject, makes a test repo with
# counter = bad and a Goal whose line-1 example wants "ok" in counter, runs the example's run
# section in that repo, prints its stdout with ids, hashes and timestamps mapped to tokens,
# then a last line "exit N". Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo bad >counter
d=goals/draft-goal/line-1/a
mkdir -p "$d/probe" || fail "mkdir draft"
printf '%s\n' '-- words --' 'The counter says ok.' '-- run --' 'cat counter' \
  '-- floor: contains --' 'ok' >"$d/example.txtar"
cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
git add -A && git commit -q -m base >&2 || fail "commit base"
base=$(git rev-parse HEAD) || fail "base"

addout=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Count.' --line 'gap:the counter says ok.' --examples goals/draft-goal 2>&1) || { echo "$addout" >&2; fail "add goal"; }
echo "$addout" >&2
goal=$(printf '%s' "$addout" | grep -o 'G-[0-9A-Z]\{6\}' | head -1)
[ -n "$goal" ] || fail "no goal id"
git add -A && git commit -q -m goal >&2 || fail "commit goal"
goalhead=$(git rev-parse HEAD)

leaf() { # name value spec
  git checkout -q "$base" >&2 || fail "checkout base"
  git checkout -q -b "$1" >&2 || fail "branch $1"
  echo "$2" >counter
  if [ "$3" = spec ]; then mkdir -p "goals/$goal/specs" && echo spec >"goals/$goal/specs/spec.md"; fi
  git add -A && git commit -q -m "$1" >&2 || fail "commit $1"
  git rev-parse HEAD
}
git checkout -q "$goalhead" >&2 || fail "checkout goal"
c1=$(leaf c1 ok spec) || exit 3
c2=$(leaf c2 "ok ok" spec) || exit 3
git checkout -q main >&2
for c in $c1 $c2; do
  HYP_ACTOR=runner-1 HYP_ROLE=runner hyp run "$c" "$goal/line-1" >&2 || fail "run $c"
done
tree1=$(HYP_ACTOR=owner hyp status "$goal" | awk '/^  row /{r=$2} /met  exit 0.* bytes: ok$/{print r; exit}')
[ -n "$tree1" ] || fail "no row of C1"
HYP_ACTOR=owner HYP_ROLE=owner hyp select "$goal" "$tree1" >&2 || fail "select"
HYP_ACTOR=owner hyp status "$goal" | head -1 | grep -q "^$goal  selected" || fail "goal not selected"
mkdir -p goals/draft-more && cp -r "goals/$goal/"line-* goals/draft-more/ || fail "copy set"
mkdir -p goals/draft-more/line-1/b/probe
printf '%s\n' '-- words --' 'The counter says ok twice.' '-- run --' 'cat counter' \
  '-- floor: contains --' 'ok ok' >goals/draft-more/line-1/b/example.txtar
cp "$work/generic-run" goals/draft-more/line-1/b/probe/run && chmod +x goals/draft-more/line-1/b/probe/run || fail "probe b"
git add -A && git commit -q -m more >&2 || fail "commit more"
export HYP_ROLE=owner
run=$(printf '%s' "$HYP_RUN" | sed -e "s/GOAL/$goal/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?

map() {
  sed -e "s/$goal/GOAL/g" -e "s/$c1[0-9a-f]*/C1/g" ${c2:+-e "s/$c2[0-9a-f]*/C2/g"} \
    -e "s/$(printf '%s' "$c1" | cut -c1-7)[0-9a-f]*/C1/g" ${c2:+-e "s/$(printf '%s' "$c2" | cut -c1-7)[0-9a-f]*/C2/g"} \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
