#!/bin/sh
# Probe of the draft examples of #397 goal 3. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with greet.txt = hello and a draft folder
# for Goal G-ONE, adds the Goal with the subject's form, then makes commits C1 (on c1, from
# main) and C2 (on c2, from c1), greet.txt = "bye" and "bye now", after the Goal exists.
# The runner runs line-1 on C1 and then on C2. Then it runs the example's run section with
# G-ONE, C1 and C2 replaced by the real ids, prints its stdout with real ids mapped back,
# then a last line "exit N". Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
d=goals/draft-greet/line-1/a
mkdir -p "$d/probe" || fail "mkdir draft"
printf '%s\n' '-- words --' 'The subject says bye.' '-- run --' 'cat greet.txt' \
  '-- floor: contains --' 'bye' >"$d/example.txtar"
cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
git add -A && git commit -q -m base >&2 || fail "commit base"

export HYP_ACTOR=owner HYP_ROLE=owner
added=$(hyp add goal --base HEAD --words 'Greet.' --line 'gap:the subject says bye.' --examples goals/draft-greet 2>"$work/adderr") \
  || fail "hyp add goal: $(cat "$work/adderr")"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || G=$(hyp status --all 2>/dev/null | sed -n 's/^\(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit_staged "goal $G" || fail "commit goal"

git checkout -q -b c1 main >&2 || fail "checkout c1"
echo bye >greet.txt
mkdir -p "goals/$G/specs" || fail "mkdir specs"
printf '%s\n' 'stateDiagram-v2' '  hello --> bye' >"goals/$G/specs/chart.mmd"
commit_staged c1 || fail "commit c1"
git checkout -q -b c2 c1 >&2 || fail "checkout c2"
echo 'bye now' >greet.txt
commit_staged c2 || fail "commit c2"
git checkout -q main >&2 || fail "checkout main"
C1=$(git rev-parse c1) || fail "rev-parse c1"
C2=$(git rev-parse c2) || fail "rev-parse c2"

for c in "$C1" "$C2"; do
  HYP_ACTOR=runner-one HYP_ROLE=runner hyp run "$c" "$G/line-1" >&2 || fail "hyp run $c failed"
  commit_staged "run $c" || fail "commit run"
done

run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g" -e "s/C1/$C1/g" -e "s/C2/$C2/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" -e "s/$C1/C1/g" -e "s/$C2/C2/g" \
    -e "s/$(printf '%s' "$C1" | cut -c1-8)[0-9a-f]*/C1/g" \
    -e "s/$(printf '%s' "$C2" | cut -c1-8)[0-9a-f]*/C2/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
