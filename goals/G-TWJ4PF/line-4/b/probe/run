#!/bin/sh
# Probe of G-TWJ4PF line-4/b. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with a base commit holding
# greet.txt, lets the owner add Goal G-ONE and commits .tree, runs the example's
# run section with G-ONE replaced by the real Goal id, prints its stdout with
# real ids replaced by stable tokens, then a last line "exit N". Setup output
# goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add -A && git commit -q -m base >&2 || fail "commit base"


# A store of the older form, written by hand as H0 writes it: one events
# file per actor, holding one goal.add event, and the union merge line.
base=$(git rev-parse HEAD) || fail "rev-parse"
tree=$(git rev-parse 'HEAD^{tree}') || fail "rev-parse tree"
mkdir -p .tree/events || fail "mkdir store"
printf 'events/*.jsonl merge=union\n' >.tree/.gitattributes
printf '{"v":2,"id":"01M00000000000000000ABCDEF","ts":"2026-01-01T00:00:00Z","actor":"owner","type":"goal.add","node":"01M00000000000000000ABCDEF","payload":{"role":"owner","words":"Greet.","base":"%s","base_tree":"%s","budget":3,"from":"","lines":[{"key":"line-1","text":"the subject says bye.","kind":"gap"}]}}\n' "$base" "$tree" >.tree/events/owner.jsonl
commit_staged "older store" || fail "commit store"
export HYP_ACTOR=owner HYP_ROLE=owner
G=G-ABCDEF

run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
sed -e "s/$g/g-abcdef/g" \
  -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
  -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
cat "$work/err" >&2
echo "exit $code"
exit 0
