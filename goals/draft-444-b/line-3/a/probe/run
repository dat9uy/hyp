#!/bin/sh
# Probe of line-3/a. The working directory is a copy of the subject. It builds hyp from the subject and
# makes a test repo whose Goal has one gap line and one example, added by the owner and committed. The
# example's own Probe is flaky: it counts its runs in $HOME/count, outside the subject copy, and prints bad on
# its first two runs and ok on every later one. The owner's add runs it on H0 (bad, failed). The runner
# commits a child of the Goal commit that adds a file the example does not read, that is ROW, and runs the
# example on it once as setup (bad, failed). Then the run section is executed with ROW and GOAL replaced by
# that commit and the Goal id: that run prints ok (met), and the Stable guard refuses it. It prints the stdout
# and the stderr of the run with ids, hashes and timestamps mapped to tokens, then a last line "exit N".
# Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'subject\n' >subject

# the example's own Probe: counts its runs in $HOME/count, which lies outside the subject copy
mkdir -p goals/draft-g/line-1/a/probe || fail "mkdir example"
printf '%s\n' '-- words --' 'The probe says ok.' '-- run --' 'true' \
  '-- floor: contains --' 'ok' >goals/draft-g/line-1/a/example.txtar || fail "example"
cat >goals/draft-g/line-1/a/probe/run <<'INNER'
#!/bin/sh
n=$(cat "$HOME/count" 2>/dev/null || echo 0)
echo $((n + 1)) >"$HOME/count"
if [ "$n" -lt 2 ]; then echo bad; else echo ok; fi
echo "exit 0"
INNER
chmod +x goals/draft-g/line-1/a/probe/run || fail "probe mode"
git add -A && git commit -q -m base >&2 || fail "commit base"
h0=$(git rev-parse HEAD) || fail "rev-parse"

owner() { HYP_ACTOR=owner HYP_ROLE=owner hyp "$@"; }
runner() { HYP_ACTOR=runner-1 HYP_ROLE=runner hyp "$@"; }

owner add goal --base HEAD --words 'Say ok.' --line 'gap:the probe says ok.' --examples goals/draft-g >"$work/add" 2>&1 || { cat "$work/add" >&2; fail "add goal"; }
cat "$work/add" >&2
goal=$(grep -o 'G-[0-9A-Z]\{6\}' "$work/add" | head -1)
[ -n "$goal" ] || fail "no Goal id"
git add -A && git commit -q -m goal >&2 || fail "commit goal"
printf 'change\n' >note || fail "write note"
git add -A && git commit -q -m row >&2 || fail "commit row"
row=$(git rev-parse HEAD) || fail "rev-parse row"
runner run "$row" "$goal/line-1" >&2 || fail "setup run"
target=$row

run=$(printf '%s' "$HYP_RUN" | sed -e "s/GOAL/$goal/g" -e "s/H0/$target/g" -e "s/ROW/$target/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$goal/GOAL/g" \
    -e 's/[0-9a-f]\{64\}/HASH/g' \
    -e 's/[0-9a-f]\{40\}/COMMIT/g' \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err"
if [ -n "$(tail -c 1 "$work/err")" ]; then echo; fi
echo "exit $code"
exit 0
