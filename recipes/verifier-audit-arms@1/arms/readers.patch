diff --git a/internal/replay/audit_test.go b/internal/replay/audit_test.go
new file mode 100644
index 0000000..078b4e8
--- /dev/null
+++ b/internal/replay/audit_test.go
@@ -0,0 +1,206 @@
+package replay
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/dat9uy/hyp/internal/event"
+	"github.com/dat9uy/hyp/internal/testutil"
+)
+
+// auditTree is a question with a selected Hypothesis and a rival, each with one
+// Result by actor a, selected by a.
+type auditTree struct {
+	b           *testutil.B
+	q, h, r     string
+	sel, rh, rr string
+}
+
+func newAuditTree() auditTree {
+	b := testutil.New()
+	g := b.Goal("g")
+	q := b.DQ(g, "q")
+	h := b.Hyp(q, "h")
+	rh := b.Hyp(q, "rival")
+	r := b.Result(b.Exp(h, event.RecipeNone, rh), map[string]string{h: event.VerdictSupports, rh: event.VerdictInconclusive})
+	rr := b.Result(b.Exp(rh, event.RecipeNone, h), map[string]string{rh: event.VerdictContradicts})
+	sel := b.Select(q, h, "", false)
+	return auditTree{b: b, q: q, h: h, r: r, sel: sel, rh: rh, rr: rr}
+}
+
+func (a auditTree) confirm() { a.b.Confirm(a.q, a.sel, event.RoleVerifier, event.ConfirmSufficient) }
+
+func TestAuditRefusals(t *testing.T) {
+	audit := func(actor, node string, p event.ResultAudit) string {
+		a := newAuditTree()
+		if node == "" {
+			node = a.r
+		}
+		if p.Hypothesis == "" {
+			p.Hypothesis = a.h
+		}
+		a.b.As(actor).Emit(event.TypeResultAudit, node, p)
+		rej := replayB(a.b).Rejections
+		if len(rej) == 0 {
+			return ""
+		}
+		return rej[0].Reason
+	}
+	good := func(mod func(*event.ResultAudit)) event.ResultAudit {
+		p := event.ResultAudit{Verdict: event.AuditHolds, Quote: "a quote", Pointer: testutil.EvidencePointer}
+		if mod != nil {
+			mod(&p)
+		}
+		return p
+	}
+	cases := []struct {
+		name, actor, node string
+		p                 event.ResultAudit
+		want              string
+	}{
+		{"accepted", "b", "", good(nil), ""},
+		{"unclear needs no quote", "b", "", event.ResultAudit{Verdict: event.AuditUnclear}, ""},
+		{"no such verdict", "b", "", good(func(p *event.ResultAudit) { p.Hypothesis = "01JB0000000000000000000099" }), "has no verdict on"},
+		{"unknown word", "b", "", good(func(p *event.ResultAudit) { p.Verdict = "maybe" }), "unknown verdict"},
+		{"the recorder", "a", "", good(nil), "separation of duties"},
+		{"no quote", "b", "", good(func(p *event.ResultAudit) { p.Quote = "" }), "needs a quote"},
+		{"no pointer", "b", "", good(func(p *event.ResultAudit) { p.Pointer = "" }), "needs a quote"},
+		{"not its evidence", "b", "", good(func(p *event.ResultAudit) { p.Pointer = ".tree/evidence/other" }), "is no evidence of"},
+		{"long quote", "b", "", good(func(p *event.ResultAudit) { p.Quote = strings.Repeat("x", event.MaxEvidenceItem+1) }), "over limit: quote"},
+		{"long pointer", "b", "", good(func(p *event.ResultAudit) { p.Pointer = strings.Repeat("x", event.MaxEvidenceItem+1) }), "over limit: pointer"},
+	}
+	for _, c := range cases {
+		t.Run(c.name, func(t *testing.T) {
+			got := audit(c.actor, c.node, c.p)
+			if (c.want == "") != (got == "") || !strings.Contains(got, c.want) {
+				t.Fatalf("rejection %q, want %q", got, c.want)
+			}
+		})
+	}
+	t.Run("not a Result", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b").Emit(event.TypeResultAudit, a.h, good(func(p *event.ResultAudit) { p.Hypothesis = a.h }))
+		if rej := replayB(a.b).Rejections; len(rej) != 1 || !strings.Contains(rej[0].Reason, "wrong kind") {
+			t.Fatalf("rejections %v", rej)
+		}
+	})
+	t.Run("retracted", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.Retract(a.r)
+		a.b.As("b").Audit(a.r, a.h, event.AuditHolds)
+		if rej := replayB(a.b).Rejections; len(rej) != 1 || !strings.Contains(rej[0].Reason, "is retracted") {
+			t.Fatalf("rejections %v", rej)
+		}
+	})
+}
+
+func TestCoverage(t *testing.T) {
+	all := func(a auditTree, word string) {
+		a.b.Audit(a.r, a.h, event.AuditHolds)
+		a.b.Audit(a.r, a.rh, event.AuditHolds)
+		a.b.Audit(a.rr, a.rh, word)
+	}
+	answered := func(t *testing.T, a auditTree) {
+		t.Helper()
+		wantStatus(t, replayB(a.b), a.q, DQAnswered, "")
+	}
+	waiting := func(t *testing.T, a auditTree) {
+		t.Helper()
+		wantStatus(t, replayB(a.b), a.q, DQOpen, ReasonAwaitingVerifier)
+	}
+	t.Run("no audits", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b")
+		a.confirm()
+		waiting(t, a)
+	})
+	t.Run("partial", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b").Audit(a.r, a.h, event.AuditHolds)
+		a.confirm()
+		waiting(t, a)
+	})
+	t.Run("all holds by the same actor", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b")
+		all(a, event.AuditHolds)
+		a.confirm()
+		answered(t, a)
+	})
+	t.Run("all holds by another actor", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("c")
+		all(a, event.AuditHolds)
+		a.b.As("b")
+		a.confirm()
+		waiting(t, a)
+	})
+	t.Run("one wrong", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b")
+		all(a, event.AuditWrong)
+		a.confirm()
+		waiting(t, a)
+	})
+	t.Run("one unclear", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b")
+		all(a, event.AuditUnclear)
+		a.confirm()
+		waiting(t, a)
+	})
+	t.Run("the latest audit of a verdict reads", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b")
+		all(a, event.AuditWrong)
+		a.b.Audit(a.rr, a.rh, event.AuditHolds)
+		a.confirm()
+		answered(t, a)
+	})
+	t.Run("audit after the confirm in merge order", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b")
+		a.confirm()
+		all(a, event.AuditHolds)
+		waiting(t, a)
+	})
+	t.Run("owner confirm unaffected", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b")
+		all(a, event.AuditHolds)
+		a.confirm()
+		a.b.As("o").Confirm(a.q, a.sel, event.RoleOwner, event.ConfirmSufficient)
+		answered(t, a)
+	})
+	t.Run("insufficient needs no audits", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b").Confirm(a.q, a.sel, event.RoleVerifier, event.ConfirmInsufficient)
+		wantStatus(t, replayB(a.b), a.q, DQOpen, ReasonVerifierInsufficient)
+	})
+	t.Run("a new Result lapses the confirm and only its verdict needs auditing", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b")
+		all(a, event.AuditHolds)
+		a.confirm()
+		answered(t, a)
+		a.b.As("a")
+		r2 := a.b.Result(a.b.Exp(a.h, event.RecipeNone, a.rh), map[string]string{a.h: event.VerdictSupports})
+		wantStatus(t, replayB(a.b), a.q, DQReopened, ReasonAwaitingVerifier)
+		a.b.As("b").Audit(r2, a.h, event.AuditHolds)
+		a.confirm()
+		answered(t, a)
+	})
+	t.Run("an uncovered sufficient keeps the chain", func(t *testing.T) {
+		a := newAuditTree()
+		a.b.As("b").Confirm(a.q, a.sel, event.RoleVerifier, event.ConfirmInsufficient)
+		a.confirm()
+		if got := len(replayB(a.b).Decisions[a.q].Chain); got != 1 {
+			t.Fatalf("chain %d, want 1", got)
+		}
+		all(a, event.AuditHolds)
+		a.confirm()
+		if got := len(replayB(a.b).Decisions[a.q].Chain); got != 0 {
+			t.Fatalf("chain %d, want 0", got)
+		}
+	})
+}
