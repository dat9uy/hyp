-- run --
bin=$(mktemp -d) && go build -o "$bin/hyp" ./cmd/hyp || exit 90
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
repo=$(mktemp -d) && cd "$repo" && git init -q && GIT_AUTHOR_DATE=2026-11-19T00:00:00Z GIT_COMMITTER_DATE=2026-11-19T00:00:00Z git commit -q --allow-empty -m base || exit 91
[ "$(git rev-parse HEAD)" = d728bd66c6e7d78d69e928ad21388b2f22ebfab4 ] || exit 92
cp -R "$HYP_EXAMPLE/input/store/." . && git add -A && git commit -q -m 'the store hyp wrote before this change' || exit 93
g=G-9V74J9
h=$(git rev-parse HEAD)
hy() { a=$1 r=$2; shift 2; out=$(HYP_ACTOR=$a HYP_ROLE=$r "$bin/hyp" "$@" 2>"$bin/err"); c=$?; case "$out" in *"$g"*) n=yes ;; *) n=no ;; esac; if [ -s "$bin/err" ]; then w=yes; else w=no; fi; echo "$a: hyp $*: exit $c, names the Goal: $n, stderr: $w"; }
hy owner owner status
hy runner-1 runner status "$g"
ch=$(git status --porcelain --untracked-files=all); echo 'changes git sees:'; if [ -n "$ch" ]; then printf '%s\n' "$ch"; else echo none; fi
if [ "$(git rev-parse HEAD)" = "$h" ]; then echo 'HEAD moved: no'; else echo 'HEAD moved: yes'; fi
echo "files git is told to skip: $(git ls-files -v | grep -c '^[a-zS]')"
