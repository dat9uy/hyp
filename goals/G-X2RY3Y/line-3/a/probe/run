#!/bin/sh
# Probe of an example of the move onto a refused base. The working directory is a copy of the subject.
# It builds hyp from the subject and makes a test repo: H0 (counter bad, name hyp), the Goal GOAL added by
# the owner with a draft x (line-1 gap: counter says ok; line-2 guard: name stays hyp), and the builds
# N, V, P (children of H0) and C1, CN, CV, CP, M (runner commits that hold a spec). SETUP runs before
# the run section. The tokens GOAL, C1, CN, CV, CP, M, BASE_N, BASE_V, BASE_P in the run section are
# replaced by ids and mapped back in the output. It prints the stdout with a last line "exit N".
# Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'counter: bad\n' >counter
printf 'hyp\n' >name
git add -A && git commit -q -m base >&2 || fail "commit base"
h0=$(git rev-parse HEAD)

owner() { HYP_ACTOR=owner HYP_ROLE=owner hyp "$@"; }
runner() { HYP_ACTOR=runner-1 HYP_ROLE=runner hyp "$@"; }

# the draft x
dr=$(HYP_ACTOR=probe-writer-432 HYP_ROLE=probe-writer hyp draft path x) || fail "draft path"
mkex() { # LINE WORDS RUN FLOOR...
  d="$dr/$1/a"; w=$2; r=$3; shift 3
  mkdir -p "$d/probe" || fail "mkdir example"
  { printf '%s\n' '-- words --' "$w" '-- run --' "$r"
    for f in "$@"; do printf '%s\n' '-- floor: contains --' "$f"; done; } >"$d/example.txtar"
  cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
}
mkex line-1 'The counter says ok.' 'cat counter' 'counter:' 'ok'
mkex line-2 'The name stays hyp.' 'cat name' 'hyp'

owner add goal --base "$h0" --words 'Count.' --line 'gap:the counter says ok' --line 'guard:the name stays hyp' --draft x >"$work/add" 2>&1 || { cat "$work/add" >&2; fail "add goal"; }
cat "$work/add" >&2
goal=$(grep -o 'G-[0-9A-Z]\{6\}' "$work/add" | head -1)
[ -n "$goal" ] || fail "no Goal id"
git add -A && git commit -q -m goal >&2 || fail "commit goal"
main=$(git rev-parse HEAD)

# build BRANCH PARENT FILE CONTENT [spec]: a commit on PARENT
build() {
  git checkout -q -b "$1" "$2" || fail "checkout $1"
  printf '%s\n' "$4" >"$3"
  if [ -n "$5" ]; then
    mkdir -p "goals/$goal/specs" && printf 'spec %s\n' "$1" >"goals/$goal/specs/spec.md" || fail "spec"
  fi
  git add -A && git commit -q -m "build $1" >&2 || fail "commit $1"
  git rev-parse HEAD
}
n=$(build n "$h0" other x)
v=$(build v "$h0" name xyz)
p=$(build p "$h0" counter 'count: bad')
c1=$(build c1 "$h0" counter 'counter: ok' spec)
cn=$(build cn "$n" counter 'counter: ok' spec)
cv=$(build cv "$v" counter 'counter: ok' spec)
cp_=$(build cp "$p" counter 'counter: ok' spec)
git checkout -q -b m "$c1" || fail "checkout m"
git merge -q --no-ff -m merge "$n" >&2 || fail "merge N"
m=$(git rev-parse HEAD)
git checkout -q main || fail "checkout main"

# setup: the runner runs CV on line-1; either exit is accepted, the command must run
runner run "$cv" "$goal/line-1" >"$work/setup" 2>&1
rc=$?; cat "$work/setup" >&2
[ "$rc" -le 1 ] || fail "run CV exit $rc"

# the Goal id is put in last: it may hold letters that look like a token
B='(^|[^A-Za-z0-9_])'; E='([^A-Za-z0-9_]|$)'
run=$(printf '%s' "$HYP_RUN" | sed -E   -e "s/BASE_N/$n/g" -e "s/BASE_V/$v/g" -e "s/BASE_P/$p/g"   -e "s/${B}M${E}/\1$m\2/g" -e "s/${B}CN${E}/\1$cn\2/g" -e "s/${B}CV${E}/\1$cv\2/g"   -e "s/${B}CP${E}/\1$cp_\2/g" -e "s/${B}C1${E}/\1$c1\2/g"   -e "s/GOAL/$goal/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$goal/GOAL/g" \
    -e "s/$m/M/g" -e "s/$cn/CN/g" -e "s/$cv/CV/g" -e "s/$cp_/CP/g" -e "s/$c1/C1/g" \
    -e "s/$n/BASE_N/g" -e "s/$v/BASE_V/g" -e "s/$p/BASE_P/g" \
    -e "s/$(echo "$m" | cut -c1-7)[0-9a-f]*/M/g" -e "s/$(echo "$cn" | cut -c1-7)[0-9a-f]*/CN/g" \
    -e "s/$(echo "$cv" | cut -c1-7)[0-9a-f]*/CV/g" -e "s/$(echo "$cp_" | cut -c1-7)[0-9a-f]*/CP/g" \
    -e "s/$(echo "$c1" | cut -c1-7)[0-9a-f]*/C1/g" \
    -e "s/$(echo "$n" | cut -c1-7)[0-9a-f]*/BASE_N/g" -e "s/$(echo "$v" | cut -c1-7)[0-9a-f]*/BASE_V/g" \
    -e "s/$(echo "$p" | cut -c1-7)[0-9a-f]*/BASE_P/g" "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
