+// quoteRunes bound a quote: long enough to be found by reading, short enough
+// to stay a quote.
+const (
+	minQuoteRunes = 20
+	maxQuoteRunes = 300
+)
+
+func cmdAudit(args []string, stdout, stderr io.Writer) error {
+	w := newWriter("audit", stdout, stderr)
+	hyp := w.fs.String("hypothesis", "", "the Hypothesis whose verdict this judges (required)")
+	verdict := w.fs.String("verdict", "", "holds, wrong or unclear (required)")
+	quote := w.fs.String("quote", "", fmt.Sprintf("text copied from the file (%d–%d runes; required for holds and wrong)", minQuoteRunes, maxQuoteRunes))
+	pointer := w.fs.String("pointer", "", "the Result's evidence pointer the quote is from (required for holds and wrong)")
+	pos, err := w.begin(args, 1)
+	if err != nil {
+		return err
+	}
+	if *hyp == "" || *verdict == "" {
+		return usageErr("audit needs --hypothesis and --verdict")
+	}
+	judged := *verdict == event.AuditHolds || *verdict == event.AuditWrong
+	if judged && (*quote == "" || *pointer == "") {
+		return usageErr("audit --verdict %s needs --quote and --pointer", *verdict)
+	}
+	if n := event.Runes(*quote); *quote != "" && (n < minQuoteRunes || n > maxQuoteRunes) {
+		return usageErr("--quote has %d runes (want %d–%d)", n, minQuoteRunes, maxQuoteRunes)
+	}
+	return w.run(func() (draft, error) {
+		res, err := w.ref(pos[0])
+		if err != nil {
+			return draft{}, err
+		}
+		h, err := w.ref(*hyp)
+		if err != nil {
+			return draft{}, err
+		}
+		p := event.ResultAudit{Hypothesis: h, Verdict: *verdict, Quote: *quote, Pointer: *pointer}
+		if n := w.p.Nodes[res]; n != nil && *pointer != "" {
+			if p.Pointer, err = auditPointer(w.root, n.Evidence, *pointer, *quote, judged); err != nil {
+				return draft{}, err
+			}
+		}
+		return draft{event.TypeResultAudit, res, p}, nil
+	})
+}
+
+// auditPointer returns the evidence entry pointer names, after checking that
+// the quote is in that file with runs of whitespace collapsed. A pointer that
+// is no entry comes back as given, for replay's rule to refuse.
+func auditPointer(root string, evidence []string, pointer, quote string, judged bool) (string, error) {
+	entry := ""
+	for _, e := range evidence {
+		if e == pointer || path.Clean(e) == path.Clean(pointer) {
+			entry = e
+			break
+		}
+	}
+	if entry == "" {
+		return pointer, nil
+	}
+	if strings.HasPrefix(entry, "http://") || strings.HasPrefix(entry, "https://") {
+		if judged {
+			return "", refusedErr("%s is a URL, so hyp cannot check a quote from it; only --verdict unclear may point at it", entry)
+		}
+		return entry, nil
+	}
+	if quote == "" {
+		return entry, nil
+	}
+	file := filepath.Join(root, filepath.FromSlash(path.Clean(entry)))
+	if ref, ok := event.EvidenceRef(entry); ok {
+		r, err := recipe.Load(root, ref.String())
+		if err != nil {
+			return "", herr.New(herr.KindOf(err), "evidence %s: %s", entry, herr.Text(err))
+		}
+		_, rest, _ := strings.Cut(strings.TrimPrefix(path.Clean(entry), "recipes/"), "/")
+		file = filepath.Join(r.Path, filepath.FromSlash(rest))
+	}
+	data, err := os.ReadFile(file)
+	if err != nil {
+		return "", herr.Env("evidence %s cannot be read: %v", entry, err)
+	}
+	collapse := func(s string) string { return strings.Join(strings.Fields(s), " ") }
+	if !strings.Contains(collapse(string(data)), collapse(quote)) {
+		return "", refusedErr("quote not in %s", entry)
+	}
+	return entry, nil
+}
