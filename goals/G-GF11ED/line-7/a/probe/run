#!/bin/sh
# Probe of G-GF11ED line-7/a. The working directory is a copy of the subject.
# The subject copy holds no store, so the Probe puts hyp's own log of G-9XX4KB
# (the store and the Goal's folder, as they were before close existed) into
# it from probe/fixture. It builds hyp from the subject, then runs the
# example's run section in the subject copy as the owner. It prints the run's
# stdout, then a last line "exit N". A build or setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export PATH="$work/bin:$PATH"
export HYP_ACTOR=owner HYP_ROLE=owner

fixture="$HYP_EXAMPLE/probe/fixture"
cp -R "$fixture/.tree" .tree || fail "copy .tree"
cp -R "$fixture/goals" goals || fail "copy goals"

# hyp reads git for leaf marks: the copy needs a repository of its own.
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
if [ "$(git rev-parse --show-toplevel 2>/dev/null)" != "$(pwd -P)" ]; then
  git init -q -b main >&2 || fail "git init"
fi
git add -A >&2 && git commit -q -m subject >&2 || fail "git commit"

out="$work/out"
sh -c "$HYP_RUN" >"$out"
code=$?
cat "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
echo "exit $code"
exit 0
