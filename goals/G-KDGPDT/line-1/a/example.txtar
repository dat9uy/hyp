-- words --
One step log per run: Goal G-ONE's example line-1/a has a Probe that makes a repository and runs one hyp add goal. After the runner's hyp run of line-1 on C1, the clone's trace holds one step log, with exactly one line, step AddGoal.
-- run --
HYP_ACTOR=runner-one HYP_ROLE=runner hyp run C1 G-ONE/line-1 >/dev/null 2>&1; L=$(grep -rl "^step " "$HOME/.hyp/traces" 2>/dev/null); echo "step logs: $(echo "$L" | grep -c .)"; echo "step lines: $(cat $L /dev/null | grep -c "^step ")"; echo "AddGoal lines: $(cat $L /dev/null | grep -c "^step AddGoal {")"
-- floor: contains --
step logs: 1
-- floor: contains --
step lines: 1
-- floor: contains --
AddGoal lines: 1
-- ceiling --
step logs: 0
