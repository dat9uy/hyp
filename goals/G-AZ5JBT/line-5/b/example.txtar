-- words --
An item with no date is refused with a new code, date-missing, and exit 1.
-- input/page.json --
{
 "id": "demo",
 "items": [
  {
   "id": "demo-I1",
   "tag": "Proposed",
   "text": "Store items as data."
  }
 ],
 "parties": [
  {
   "id": "owner",
   "label": "Owner"
  },
  {
   "id": "agent",
   "label": "Agent"
  },
  {
   "id": "tool",
   "label": "Tool"
  }
 ],
 "approaches": [
  {
   "name": "A",
   "concept_at": "owner",
   "steps": [
    "The owner writes the item."
   ]
  },
  {
   "name": "B",
   "concept_at": "agent",
   "steps": [
    "The agent writes the item."
   ]
  },
  {
   "name": "C",
   "concept_at": "tool",
   "steps": [
    "The tool writes the item."
   ]
  }
 ]
}
-- run --
test -f skills/hyp-rethinking/scripts/check_items.py && echo 'check_items.py ships'
python3 skills/hyp-rethinking/scripts/check_items.py "$HYP_EXAMPLE/input/page.json"
echo "exit code: $?"
-- floor: contains --
check_items.py ships
-- floor: contains --
date-missing
-- floor: contains --
exit code: 1
