#!/bin/sh
# Probe of G-G4NNT7 line-7/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test git repository whose .tree/ is
# the example's input/.tree, runs the example's run section there as HYP_ACTOR
# reader, prints its stdout, then a last line "exit N". Setup output goes to
# stderr. A build or setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

[ -d "$HYP_EXAMPLE/input/.tree" ] || fail "no input/.tree in $HYP_EXAMPLE"
repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo base >README
git add README && git commit -q -m base >&2 || fail "commit base"
cp -R "$HYP_EXAMPLE/input/.tree" .tree || fail "copy .tree"
git add -A && git commit -q -m "old lines" >&2 || fail "commit .tree"

export HYP_ACTOR=reader
out="$work/out"
sh -c "$HYP_RUN" >"$out" 2>"$work/err"
code=$?
cat "$work/err" >&2
cat "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
echo "exit $code"
exit 0
