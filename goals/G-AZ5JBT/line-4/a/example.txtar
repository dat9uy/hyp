-- words --
The drawn page shows each item's id, tag and text.
-- input/page.json --
{
 "id": "demo",
 "items": [
  {
   "id": "demo-I1",
   "tag": "Owner said",
   "date": "2026-11-27",
   "text": "Keep the words of the owner."
  },
  {
   "id": "demo-I2",
   "tag": "Proposed",
   "date": "2026-11-28",
   "text": "Store items as data."
  }
 ],
 "parties": [
  {
   "id": "owner",
   "label": "Owner"
  },
  {
   "id": "agent",
   "label": "Agent"
  },
  {
   "id": "tool",
   "label": "Tool"
  }
 ],
 "approaches": [
  {
   "name": "A",
   "concept_at": "owner",
   "steps": [
    "The owner writes the item."
   ]
  },
  {
   "name": "B",
   "concept_at": "agent",
   "steps": [
    "The agent writes the item."
   ]
  },
  {
   "name": "C",
   "concept_at": "tool",
   "steps": [
    "The tool writes the item."
   ]
  }
 ]
}
-- run --
test -f skills/hyp-rethinking/scripts/draw_page.py && echo 'draw_page.py ships'
d=$(mktemp -d) && python3 skills/hyp-rethinking/scripts/draw_page.py "$HYP_EXAMPLE/input/page.json" "$d/page.html" && cat "$d/page.html"
-- floor: contains --
draw_page.py ships
-- floor: contains --
demo-I1
-- floor: contains --
Owner said
-- floor: contains --
Keep the words of the owner.
-- floor: contains --
demo-I2
-- floor: contains --
Proposed
-- floor: contains --
Store items as data.
