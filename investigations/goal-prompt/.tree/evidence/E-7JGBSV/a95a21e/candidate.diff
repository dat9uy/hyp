index 0000000..13b189f
--- /dev/null
+++ b/internal/cli/truncated_hash_test.go
@@ -0,0 +1,41 @@
+package cli
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/dat9uy/hyp/internal/event"
+)
+
+const fullSHA = "c47a38dee2456cc6172dff28472052c0f7b28d7baf310af6e83b5ca655d10a24"
+
+// A line never changes, so a hash it names must be whole: hyp add goal
+// refuses a line that names a run of 8 to 63 hex digits followed by an
+// ellipsis, and accepts the same line with all 64 digits.
+func TestAddGoalRefusesATruncatedHash(t *testing.T) {
+	setup(t)
+	for _, short := range []string{fullSHA[:8] + "…", fullSHA[:8] + "...", fullSHA[:63] + "…", strings.ToUpper(fullSHA[:12]) + "..."} {
+		line := "[P] graded by eval_skill.py (sha256 " + short + ") with 0 errors"
+		r := hyp(t, "add", "goal", "--title", "G2", "--actor", "o", "--line", "[N] fine", "--line", line, "--why", "w")
+		want(t, r, 1, "line 2 names a hash cut to ")
+		want(t, r, 1, "name the file by its whole sha256 (64 hex digits)")
+	}
+	notIn(t, "G2")
+
+	r := hyp(t, "add", "goal", "--title", "G3", "--actor", "o", "--line", "[P] graded by eval_skill.py (sha256 "+fullSHA+") with 0 errors", "--why", "w")
+	want(t, r, 0, "line ")
+	// A hex run outside 8 to 63 digits, or one with no ellipsis, is not a cut hash.
+	for _, ok := range []string{"commit 1aba8da… on main", fullSHA + "…", "sha256 " + fullSHA[:12] + " in a list", "a tag like abcdefg..."} {
+		want(t, hyp(t, "add", "goal", "--title", "G4", "--actor", "o", "--line", ok, "--why", "w"), 0, "line ")
+	}
+}
+
+// Only the write refuses: a log that already holds a Goal whose line names a
+// cut hash, written by an older hyp, still replays.
+func TestALogWithATruncatedHashStillReplays(t *testing.T) {
+	setup(t)
+	text := "[P] graded by eval_skill.py (sha256 " + fullSHA[:8] + "…)"
+	id := rawEvent(t, "o", event.TypeNodeAdd, "", event.NodeAdd{Kind: event.KindGoal, Title: "old Goal", Lines: []event.GoalLine{{Text: text}}}, "written by an older hyp")
+	want(t, hyp(t, "check"), 0, "check: 0 errors")
+	want(t, hyp(t, "show", event.DisplayID(event.KindGoal, id)+"#1"), 0, text)
+}
diff --git a/internal/cli/write.go b/internal/cli/write.go
index ecb31e3..a059cd5 100644
--- a/internal/cli/write.go
+++ b/internal/cli/write.go
@@ -8,6 +8,7 @@ import (
 	"io"
 	"os"
 	"path/filepath"
+	"regexp"
 	"slices"
 	"strconv"
 	"strings"
@@ -289,7 +290,10 @@ func cmdAdd(args []string, stdout, stderr io.Writer) error {
 	if err != nil {
 		return err
 	}
-	for _, t := range lineTexts {
+	for i, t := range lineTexts {
+		if err := truncatedHex(i+1, t); err != nil {
+			return err
+		}
 		p.Lines = append(p.Lines, event.GoalLine{Text: t})
 	}
 	noTarget := len(targets) == 1 && targets[0] == "none"
@@ -413,6 +417,20 @@ func cmdAdd(args []string, stdout, stderr io.Writer) error {
 	return err
 }
 
+// truncatedHexRe finds a whole run of 8 to 63 hex digits followed by an
+// ellipsis, such as "c47a38de…": a shortened hash.
+var truncatedHexRe = regexp.MustCompile(`(?:^|[^0-9A-Fa-f])([0-9A-Fa-f]{8,63})(?:…|\.\.\.)`)
+
+// truncatedHex refuses line n of a new Goal when it names a shortened hash.
+// A line never changes, so a hash it names must be whole; a log that
+// already holds such a line still replays, because only the write refuses.
+func truncatedHex(n int, text string) error {
+	if m := truncatedHexRe.FindStringSubmatch(text); m != nil {
+		return refusedErr("line %d names a hash cut to %d hex digits (%s…); a line never changes, so name the file by its whole sha256 (64 hex digits)", n, len(m[1]), m[1])
+	}
+	return nil
+}
+
