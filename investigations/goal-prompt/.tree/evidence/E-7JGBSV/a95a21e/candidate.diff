iments: a flag with a default of 5.\n"],"reminderFold":false,"echoWireToolInputs":true,"contextRendering":"announced"},"type":"attachment","uuid":"3d0ac429-b5f2-40d2-9f6e-150d78930c97","timestamp":"2026-11-12T14:08:05.279Z","userType":"external","entrypoint":"sdk-cli","cwd":"/Users/datguy/.hyp-sandbox/g146-base-a-1/tmp/hyp-owner-grill-eval/standin","sessionId":"25b2d6ec-839d-4fb8-819e-71db8a3e8a03","version":"2.1.322","gitBranch":"HEAD"}
