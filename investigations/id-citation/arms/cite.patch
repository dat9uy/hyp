+// results resolves each --result ref to a Result of the locked store, or
+// refuses with exit 2, so nothing is appended.
+func (w *writer) results(refs []string) ([]string, error) {
+	var ids []string
+	for _, r := range refs {
+		id, err := resolveRef(w.p, r)
+		if err != nil {
+			return nil, herr.BadArgs("--result: %s", herr.Text(err))
+		}
+		if w.p.Nodes[id].Kind != event.KindResult {
+			return nil, herr.BadArgs("--result %s is no Result", r)
+		}
+		ids = append(ids, id)
+	}
+	return ids, nil
+}
