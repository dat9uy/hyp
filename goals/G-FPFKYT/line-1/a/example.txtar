-- words --
While Goal A is open, the owner adds Goal B with --from A and B's examples: the add is accepted, and B is written and waits for A's select.
-- run --
out=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --from GOAL_A --base H0 --words 'Done.' --line 'gap:the counter says done.' --draft xb 2>&1); code=$?; printf '%s\n' "$out"; echo "add exit $code"; g=$(printf '%s\n' "$out" | sed -n 's/^recorded //p'); HYP_ACTOR=owner hyp status "$g" 2>&1 | head -3
-- floor: contains --
add exit 0
-- floor: contains --
GOAL_B  written
-- floor: contains --
GOAL_A
-- ceiling --
From ended
