#!/bin/sh
# Probe of G-DR449G line-1/b. The working directory is a copy of the subject.
# It builds hyp from the subject, makes clone A with a test Goal and a fixture
# example, makes clone B where a runner runs the line, closes the Goal in A,
# merges B into A, then runs the example's run section in A with $G set. It
# prints the stdout with the test Goal's id replaced by "G", then a last line
# "exit N". Setup output goes to stderr. A build or store failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') ||
  fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
# The union merge for the events files.
mkdir -p .tree && printf 'events/*.jsonl merge=union\n' >.tree/.gitattributes
git add -A && git commit -q -m goal >&2 || fail "commit goal"

# fixture LINE NAME FLOOR [RUN]: write the example folder goals/$G/LINE/NAME
# with the generic Probe. On the test Goal's H0, greet.txt says hello.
fixture() {
  d="goals/$G/$1/$2"
  mkdir -p "$d/probe" || fail "mkdir $d"
  {
    echo '-- words --'
    echo "Fixture $1/$2."
    echo '-- run --'
    echo "${4:-cat greet.txt}"
    echo '-- floor: contains --'
    echo "$3"
  } >"$d/example.txtar"
  cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
# Run the example's run section in the subject copy (the working directory),
# print its stdout, then a last line "exit N" with its exit code.
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
  chmod +x "$d/probe/run"
}

commit() { git add -A && git commit -q --allow-empty -m "$1" >&2 || fail "commit $1"; }

# act ROLE ARGS: a hyp act of the setup. A refused act does not stop the
# Probe: the run shows what the build under test does.
act() { who=$1; shift; echo "setup: hyp $*" >&2; HYP_ACTOR=$who HYP_ROLE=$who hyp "$@" >&2; echo "setup: exit $?" >&2; }

# --- this example's setup ---
fixture line-1 a bye
commit fixtures
act grill place "$G"
commit placed

# Clone B: a runner runs line-1 on a commit whose greet.txt still says hello.
clone="$work/cloneB"
git clone -q "$repo" "$clone" >&2 || fail "git clone"
(
  cd "$clone" || exit 1
  echo other >other.txt
  git add other.txt && git commit -q -m "other change" >&2 || exit 1
  cand=$(git rev-parse HEAD)
  echo "setup: hyp run $cand $G/line-1" >&2
  HYP_ACTOR=runner-b HYP_ROLE=runner hyp run "$cand" "$G/line-1" >&2
  echo "setup: exit $?" >&2
  git add -A && git commit -q --allow-empty -m "log of B" >&2 || exit 1
) || fail "clone B setup"
sleep 1

# Clone A: the owner closes the Goal. H0 has no close: a refusal does not stop the Probe.
act owner close "$G" --why "done"
commit "A closes"
git fetch -q "$clone" HEAD >&2 || fail "fetch B"
git merge -q --no-edit FETCH_HEAD >&2
echo "setup: merge exit $?" >&2
# --- end of setup ---

export G HYP_ACTOR=owner HYP_ROLE=owner
out="$work/out"
HYP_ACTOR=owner HYP_ROLE=owner hyp status "$G" 2>&1 | sed "s/$G/G/g"
sh -c "$HYP_RUN" >"$out"
code=$?
sed "s/$G/G/g" "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
if grep -E 'result\.record' "$out" | grep -qE 'frozen|freezes'; then
  echo "the run's event kind is frozen by an end in hyp spec"
else
  echo "disagrees: result.record is not marked frozen"
fi
echo "exit $code"
exit 0
