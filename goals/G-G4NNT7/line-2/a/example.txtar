-- run --
hyp run HEAD "$G/line-1" >/dev/null 2>&1; echo "run exit $?"; echo "other changes: $(git status --porcelain --untracked-files=all | grep -c .)"; git status --porcelain --untracked-files=all .tree; hyp status "$G" | head -n 1
