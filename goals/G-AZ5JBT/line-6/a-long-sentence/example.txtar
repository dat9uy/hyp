-- words --
Five pages, one fault each: the page whose only fault is long sentence prints its message and exit 1.
-- input/page.html --
<!doctype html><html><body>
<h2>1. One</h2><p>word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word.</p>
</body></html>
-- run --
test -f skills/hyp-rethinking/scripts/check_page.py && echo 'check_page.py ships'
python3 skills/hyp-rethinking/scripts/check_page.py "$HYP_EXAMPLE/input/page.html"
echo "exit code: $?"
-- floor: contains --
check_page.py ships
-- floor: contains --
30 words:
-- floor: contains --
exit code: 1
