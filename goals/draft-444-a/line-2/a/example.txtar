-- words --
hyp spec lists the code payload-decode under (no guard), and lists the code payload-invalid nowhere.
-- run --
n=$(hyp spec | grep -c payload-invalid); echo "payload-invalid lines: $n"; hyp spec | grep "^  (no guard)" | grep -o "payload-decode"
-- floor: contains --
payload-invalid lines: 0
-- floor: contains --
payload-decode
