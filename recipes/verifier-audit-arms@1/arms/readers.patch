+			return
+		}
+		text = append(text, head)
+		for _, it := range list {
+			text = append(text, fmt.Sprintf("  %s on %s", event.DisplayID(event.KindResult, it.Node), event.DisplayID(event.KindHypothesis, it.To)))
+		}
+	}
+	section("not audited by "+actor+":", missing)
+	section("wrong:", wrong)
+	return []Finding{{FindRefuse, strings.Join(text, "\n")}}
+}
