+// AuditRec is one applied audit of a Result's verdict on Hypothesis.
+type AuditRec struct {
+	ID, Actor, Result, Hypothesis, Verdict, Quote, Pointer string
+}
+
+func auditKey(result, hyp string) string { return result + "|" + hyp }
+
+// latestAudits maps each verdict of audits, oldest first, to actor's latest word.
+func latestAudits(audits []AuditRec, actor string) map[string]string {
+	out := map[string]string{}
+	for _, a := range audits {
+		if a.Actor == actor {
+			out[auditKey(a.Result, a.Hypothesis)] = a.Verdict
+		}
+	}
+	return out
+}
+
+// auditsOn is actor's latest audit words on the Results items lists.
+func auditsOn(byResult map[string][]AuditRec, items []DossierItem, actor string) map[string]string {
+	out := map[string]string{}
+	for _, it := range items {
+		if it.Kind == DossierResult {
+			maps.Copy(out, latestAudits(byResult[it.Node], actor))
+		}
+	}
+	return out
+}
+
+// uncovered sorts the result items a sufficient verifier confirm still lacks:
+// missing has no audit in audits or reads unclear, and wrong reads wrong.
+func uncovered(items []DossierItem, audits map[string]string) (missing, wrong []DossierItem) {
+	for _, it := range items {
+		if it.Kind != DossierResult {
+			continue
+		}
+		switch audits[auditKey(it.Node, it.To)] {
+		case event.AuditHolds:
+		case event.AuditWrong:
+			wrong = append(wrong, it)
+		default:
+			missing = append(missing, it)
+		}
+	}
+	return missing, wrong
+}
+
+// Uncovered lists what keeps this confirm from counting as a sufficient
+// verifier confirm: nothing for any other confirm.
+func (c *ConfirmRec) Uncovered() []DossierItem {
+	if c.Role != event.RoleVerifier || c.Verdict != event.ConfirmSufficient {
+		return nil
+	}
+	missing, wrong := uncovered(c.Items, c.Audits)
+	return append(missing, wrong...)
 }
 
