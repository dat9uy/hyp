+{"v":1,"id":"01M782DS7KGGEHSY3CF482VRNB","ts":"2026-11-12T14:26:12.339703Z","actor":"claude-prompt-1","type":"node.add","node":"01M782DS7KGGEHSY3CF482VRNB","payload":{"kind":"DesignQuestion","parent":"01M782DPNRRP88AEWF55B1NVVG","title":"Which hyp commit implements hyp prompt and the constraints block check?","body":"Rivals are commits, each a Hypothesis tied to the base plus its change with hyp subject. They are added when they exist, because a one-rival Experiment is refused. A line is decided by go tests on the candidate.","alias":"q-commit"},"why":"The build's one question; its candidates are commits, added when they exist."}
