-- words --
hyp spec prints checked at replay: yes for the guards Whole set and Kind, because replay refuses a goal.add whose example is off its Goal's lines or carries the wrong verdict on H0.
-- run --
for g in 'Whole set' 'Kind'; do l=$(hyp spec | grep "^  $g  "); case "$l" in *'checked at replay: yes'*) echo "$g: yes";; *'checked at replay: no'*) echo "$g: no";; *) echo "$g: absent";; esac; done
-- floor: contains --
Whole set: yes
-- floor: contains --
Kind: yes
-- ceiling --
: no
