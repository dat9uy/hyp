{"v":2,"id":"01M835M3EJ1WNHZ853AF5KGW1Y","ts":"2026-11-23T03:01:34.80207Z","actor":"grill","type":"examples.place","node":"01M835A3GGPKCKXVHN0SDR449G","payload":{"role":"grill","examples":[{"line":"line-1","example":"a","hash":"469987c94b0a171d182443e130412e92c8a5b598","h0":{"commit":"6aa4ae6c78b09437e31352893a9c2b5ff8aee6b5","row_tree":"3ce34fb11e659e2bc073868debcbc06b22a015ea","probe":"c2694af6e2ce25fe129bbb935057c95dbb24fa18","output":"573587836644ae8293e2278aebb43d4c2479a96f93cb8f13c319c7d877a5ab1f","stderr":"d426d20b9b7e0738f8c6dca1c49d22ca1c9e3e63a752f66108c4cda46371e2ba","exit":2,"verdict":"failed"}},{"line":"line-1","example":"b","hash":"03734ff358e6839f2218a4d338726f7f034994e6","h0":{"commit":"6aa4ae6c78b09437e31352893a9c2b5ff8aee6b5","row_tree":"3ce34fb11e659e2bc073868debcbc06b22a015ea","probe":"33136b5e10b4143f6b3a80f56748602cce1c2059","output":"19e67d857281f39dc9201e52ddbb5202fae1cad95bad3318ae5441eb272ba0e8","stderr":"8f6c3e31c709be049fee3fc7ef19e511176249f0fc0621e2cc783caae2816b24","exit":2,"verdict":"failed"}},{"line":"line-2","example":"a","hash":"7d3466b0ad24ffcbab5376789ae8ab7d38cc577e","h0":{"commit":"6aa4ae6c78b09437e31352893a9c2b5ff8aee6b5","row_tree":"3ce34fb11e659e2bc073868debcbc06b22a015ea","probe":"a35d1567a49abc2fdc19f14163327f2cfd0a2a5c","output":"f2fdd8c200876ed3a5ff5d5afcd8761dc0c5d6ac38a0153dba81b07af0bc19ac","stderr":"95f19be8dd10e1cfe1e766320051e8fc51f683d0dc94505ab2ba06703f843a3c","exit":2,"verdict":"failed"}},{"line":"line-3","example":"a","hash":"4cf53204f27535c28e0e7954ac47c8fe80c950ce","h0":{"commit":"6aa4ae6c78b09437e31352893a9c2b5ff8aee6b5","row_tree":"3ce34fb11e659e2bc073868debcbc06b22a015ea","probe":"f70f1634280bd528c572a5bae8c7a619b2b3acb7","output":"ade624b2d7db2ae55f9b47857ad729bc54b8486456c6fa0247cad42242276634","stderr":"397c4fb0471a441fe1dc4fc4ae54bf9c6b4b09402785f9757e31c6a4a321dc6a","exit":2,"verdict":"failed"}},{"line":"line-4","example":"a","hash":"14284adba544033db8cb02d9586d178738c752e4","h0":{"commit":"6aa4ae6c78