#!/bin/sh
# Probe of a draft example of #397 goal 4. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with greet.txt = hello and a draft folder
# goals/draft-greet, runs the example's run section in that repo, prints its stdout with
# ids and timestamps mapped to tokens, then a last line "exit N". Setup output goes to
# stderr. A setup failure exits 3.
unset HYP_STEP_LOG

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
d=goals/draft-greet/line-1/a
mkdir -p "$d/probe" || fail "mkdir draft"
printf '%s\n' '-- words --' 'The subject says bye.' '-- run --' 'cat greet.txt' \
  '-- floor: contains --' 'bye' >"$d/example.txtar"
cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
git add -A && git commit -q -m base >&2 || fail "commit base"

sh -c "$HYP_RUN" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
