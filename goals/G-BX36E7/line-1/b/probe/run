#!/bin/sh
# Write a small model into the subject copy, run the example's run section,
# print its stdout, then a last line "exit N" with its exit code.
mkdir -p goals/G-ONE/specs || exit 1
cat > goals/G-ONE/specs/count.tla <<'TLA'
---- MODULE count ----
EXTENDS Naturals
CONSTANT Breaks
VARIABLE x

vars == <<x>>

Init == x = 1

\* source: model only
TypeOK == x \in 0..1

\* source: model only
Positive == x > 0

Stay == x' = x

Break == Breaks /\ x' = 0

Next == Stay \/ Break

Spec == Init /\ [][Next]_vars
====
TLA
cat > goals/G-ONE/specs/count.cfg <<'CFG'
SPECIFICATION Spec
CONSTANTS
  Breaks = FALSE
INVARIANTS
  TypeOK
  Positive
CFG
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
