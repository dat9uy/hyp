#!/bin/sh
# Probe of G-9KAEW6 line-1/c. The working directory is a copy of the subject.
# It builds hyp from the subject, runs the example's run section (hyp spec)
# with that binary and prints its stdout, then checks on every event-kind row
# that "changes a Goal's state: yes" goes with "stored in git" and "no" with
# "stored in trace".
# The last line is "exit N", the exit code of the run section. Setup output
# goes to stderr. A build or setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export PATH="$work/bin:$PATH"

out="$work/out"
sh -c "$HYP_RUN" >"$out" 2>"$work/err"
code=$?
cat "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi

# The event-kind rows of the events: block, one per line: "name<TAB>row".
# A row starts with two spaces and a non-space; the block ends at the first
# blank line. The name is the text before the row's first run of two spaces.
awk '
/^events:/ { inb = 1; next }
inb && /^$/ { exit }
inb && /^  [^ ]/ {
  row = substr($0, 3)
  name = row; sub(/  .*$/, "", name)
  print name "\t" row
}
' "$out" >"$work/rows"

# A row that holds the field agrees when its value is yes and it says only
# "stored in git", or its value is no and it says only "stored in trace".
awk -F '\t' -v f="changes a Goal's state: " '
{
  row = $2
  i = index(row, f)
  if (i == 0) { if (lack == "") lack = $1; next }
  held++
  v = substr(row, i + length(f))
  sub(/  .*$/, "", v); sub(/[ ,;].*$/, "", v)
  git = index(row, "stored in git") > 0
  trace = index(row, "stored in trace") > 0
  if (!((v == "yes" && git && !trace) || (v == "no" && trace && !git))) {
    print $1 " disagrees"; bad = 1
  }
}
END {
  if (held == 0) print "no event kind says whether it changes a Goal" "\047" "s state"
  else if (lack != "") print "an event kind says nothing about whether it changes a Goal" "\047" "s state: " lack
  else if (!bad) print "every kind that changes a Goal" "\047" "s state is stored in git, and every other kind in the trace"
}
' "$work/rows"

echo "exit $code"
exit 0
