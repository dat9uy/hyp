#!/bin/sh
# Probe of G-MH24W6 line-6/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repository with one landed Goal
# (a placed example, a run, a select and a land, all by the actor that added
# the Goal), then runs hyp status as the owner and prints its stdout with the
# Goal id replaced by G, then a last line "exit N". Setup output goes to
# stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }
step() { echo "setup: $*" >&2; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"
export HYP_ACTOR=owner

step "add goal"
added=$(HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"

ex="goals/$G/line-1/a"
mkdir -p "$ex/probe" || fail "mkdir example"
cat >"$ex/example.txtar" <<'TXT'
-- words --
The subject says bye.
-- run --
cat greet.txt
-- floor: contains --
bye
TXT
cat >"$ex/probe/run" <<'SH'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
SH
chmod +x "$ex/probe/run"
git add -A && git commit -q -m goal >&2 || fail "commit goal"

step "place"
HYP_ROLE=grill hyp place "$G" >&2 || fail "place"
git add -A && git commit -q -m place >&2 || fail "commit place"

echo bye >greet.txt
mkdir -p "goals/$G/specs" && echo "greeting spec" >"goals/$G/specs/greet.txt" || fail "spec"
git add -A && git commit -q -m candidate >&2 || fail "commit candidate"
cand=$(git rev-parse HEAD)

step "run"
ran=$(HYP_ROLE=runner hyp run "$cand" "$G/line-1") || fail "run: $ran"
echo "$ran" >&2
hash=$(printf '%s\n' "$ran" | sed -n 's/^row: //p' | head -n 1)
[ -n "$hash" ] || fail "no row in: $ran"

step "select"
HYP_ROLE=runner hyp select "$G" "$hash" >&2 || fail "select"
git add -A && git commit -q --allow-empty -m select >&2 || fail "commit select"

step "land"
HYP_ROLE=owner hyp land "$G" >&2 || fail "land"
git add -A && git commit -q --allow-empty -m land >&2 || fail "commit land"

out="$work/out"
HYP_ROLE=owner hyp status "$G" >"$out"
code=$?
sed -e "s/$G/G/g" "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
echo "exit $code"
exit 0
