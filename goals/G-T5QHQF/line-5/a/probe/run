#!/bin/sh
# Probe of G-T5QHQF line-5/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with base commit C0 holding
# greet.txt = hello and a draft folder goals/draft-greet. After the Goal exists it branches c1
# (greet.txt = "bye now", with a spec file) and c2 (greet.txt = "bye"). It adds Goal G-ONE: first
# with the subject's form (add goal --examples), else in H0's form (add goal,
# copy the draft to goals/<G>, grill place). One example; the runner runs line-1 on C1 and, in H0, selects it.
# Then it runs the example's run section with G-ONE, C1 and C2 replaced by the
# real Goal id and commit shas, prints its stdout with real ids replaced by
# G-ONE, C1 and C2, then a last line "exit N". Setup output goes to stderr.
# A setup failure that the fallback does not cover exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add -A && git commit -q -m base >&2 || fail "commit base"

# The draft folder: line-1/a floor bye, line-2/a floor "bye now".
draft() { # draft LINE FLOOR
  d="goals/draft-greet/line-$1/a"
  mkdir -p "$d/probe" || fail "mkdir $d"
  printf '%s\n' '-- words --' "The subject says $2." '-- run --' 'cat greet.txt' \
    '-- floor: contains --' "$2" >"$d/example.txtar"
  cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
}
draft 1 bye
draft 2 'bye now'
commit_staged draft || fail "commit draft"

# make_commits: branch c1 (greet.txt = "bye now") and c2 (greet.txt = "bye") off
# main, after the Goal exists; c1 also holds a spec file of the Goal, which H0's
# select asks for.
make_commits() {
  git checkout -q -b c1 main >&2 || fail "checkout c1"
  echo 'bye now' >greet.txt
  mkdir -p "goals/$G/specs" || fail "mkdir specs"
  printf '%s\n' 'stateDiagram-v2' '  hello --> bye' >"goals/$G/specs/chart.mmd"
  commit_staged c1 || fail "commit c1"
  git checkout -q -b c2 main >&2 || fail "checkout c2"
  echo bye >greet.txt
  commit_staged c2 || fail "commit c2"
  git checkout -q main >&2 || fail "checkout main"
  C1=$(git rev-parse c1) || fail "rev-parse c1"
  C2=$(git rev-parse c2) || fail "rev-parse c2"
}

# add_goal LINES...: each argument is a Goal line text; line-N holds draft N.
add_goal() {
  export HYP_ACTOR=owner HYP_ROLE=owner
  for t in "$@"; do set -- "$@" --line "gap:$t"; shift; done
  if added=$(hyp add goal --base HEAD --words Greet. "$@" --examples goals/draft-greet 2>"$work/adderr"); then
    :
  else
    echo "probe: new form refused, using H0's form: $(head -n 1 "$work/adderr")" >&2
    added=$(hyp add goal --base HEAD --words Greet. "$@") || fail "hyp add goal: $added"
    G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
    [ -n "$G" ] || fail "no Goal id in: $added"
    mkdir -p "goals/$G" || fail "mkdir goals/$G"
    n=1
    while [ "$n" -le $(($# / 2)) ]; do cp -R "goals/draft-greet/line-$n" "goals/$G/line-$n" || fail "copy line-$n"; n=$((n+1)); done
    commit_staged "goal $G" || fail "commit goal"
    HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
    added="recorded $G"
  fi
  G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$G" ] || G=$(hyp status --all 2>/dev/null | sed -n 's/^\(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$G" ] || fail "no Goal id"
  commit_staged "goal $G" || fail "commit goal"
}

# run_line COMMIT LINE: the runner runs one line on a commit.
run_line() {
  HYP_ACTOR=runner-one HYP_ROLE=runner hyp run "$1" "$G/$2" >&2 || fail "hyp run $1 $2 failed"
  commit_staged "run $2" || fail "commit run"
}

# select_if_offered: H0's runner selects what its status offers; the build offers nothing.
select_if_offered() {
  sel=$(HYP_ACTOR=runner-one HYP_ROLE=runner hyp status "$G" --role runner | grep -o "hyp select $G [^ ]*" | head -n 1)
  if [ -n "$sel" ]; then
    echo "probe: $sel" >&2
    HYP_ACTOR=runner-one HYP_ROLE=runner $sel --why check >&2 || fail "select failed: $sel"
    commit_staged select || fail "commit select"
  fi
}

add_goal "the subject says bye."
make_commits
run_line "$C1" line-1
select_if_offered

export HYP_ACTOR=owner HYP_ROLE=owner
run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g" -e "s/C1/$C1/g" -e "s/C2/$C2/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" -e "s/$C1/C1/g" -e "s/$C2/C2/g" \
    -e "s/$(printf '%s' "$C1" | cut -c1-8)[0-9a-f]*/C1/g" \
    -e "s/$(printf '%s' "$C2" | cut -c1-8)[0-9a-f]*/C2/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
