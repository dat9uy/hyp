#!/bin/sh
# Probe of G-KSCGXV line-5/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test git repo whose .tree/events/
# holds the example's input/events/*.jsonl, lists the Goals with `hyp status`,
# runs the example's run section (G replaced) for each Goal in state ended and
# prints one line per ended Goal, then the summary lines and a last line
# "exit N". Setup output goes to stderr. A build or setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT
fail() { echo "probe: $*" >&2; exit 3; }

ex=$(cd "$HYP_EXAMPLE" && pwd) || fail "HYP_EXAMPLE"
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export PATH="$work/bin:$PATH"
export HYP_ACTOR=reader HYP_ROLE=reader

repo="$work/repo"
mkdir -p "$repo/.tree/events" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
cp "$ex"/input/events/*.jsonl .tree/events/ || fail "copy events"
echo 'events/*.jsonl merge=union' >.tree/.gitattributes
git add -A && git commit -q -m events >&2 || fail "commit events"

list="$work/list"
hyp status >"$list" 2>"$work/list.err" || fail "hyp status: $(cat "$work/list.err")"
heading='^refused at replay:'
refused=none
grep -q "$heading" "$list" && refused=some

ids=$(awk '$1 ~ /^G-[A-Z0-9]+$/ && $2 == "ended" {print $1}' "$list")
n=0
all=yes
first=0
for G in $ids; do
  run=$(printf '%s' "$HYP_RUN" | sed -e "s/ G\$/ $G/" -e "s/ G / $G /g")
  out="$work/out.$G"
  sh -c "$run" >"$out" 2>/dev/null
  code=$?
  echo "$G exit $code"
  n=$((n + 1))
  if [ "$code" -ne 0 ]; then
    all=no
    [ "$first" -eq 0 ] && first=$code
  fi
  grep -q "$heading" "$out" && refused=some
done
echo "ended Goals: $n"
echo "exit 0 for every Goal: $all"
echo "refused at replay: $refused"
echo "exit $first"
exit 0
