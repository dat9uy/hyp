iments: a flag with a default of 5.\n"],"reminderFold":false,"echoWireToolInputs":true,"contextRendering":"announced"},"type":"attachment","uuid":"d3d23189-3661-40d3-b1cf-900efd715369","timestamp":"2026-11-12T14:20:41.983Z","userType":"external","entrypoint":"sdk-cli","cwd":"/Users/datguy/.hyp-sandbox/g146-base-a-3/tmp/hyp-owner-grill-eval/standin","sessionId":"ba3d3691-544e-463e-a377-b2d7ff675d66","version":"2.1.322","gitBranch":"HEAD"}
