#!/bin/sh
# Probe of G-T30ZAY line-3. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test store, does the setup of the
# example, replaces stand-in ids (G-ONE, F-ONE ...) by real ids in the run
# section, runs it, and prints stdout, stderr (real ids replaced back by the
# stand-ins) and a last line "exit N". Setup output goes to stderr. A setup
# step that runs a finding command of this Goal and fails is an outcome: its
# output and "exit N" are printed and the Probe exits 0. Any other setup
# failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"

map="$work/map"   # lines "REAL STANDIN"
: >"$map"
norm() {
  cp "$1" "$work/n.tmp"
  while read -r real stand; do
    sed "s#$real#$stand#g" "$work/n.tmp" >"$work/n2.tmp" && mv "$work/n2.tmp" "$work/n.tmp"
  done <"$map"
  cat "$work/n.tmp"
}
denorm() {
  s=$1
  while read -r real stand; do
    s=$(printf '%s' "$s" | sed "s#$stand#$real#g")
  done <"$map"
  printf '%s' "$s"
}
real() { sed -n "s/^\\([A-Z]-[A-Z0-9]*\\) $1\$/\\1/p" "$map"; }

# add_goal STANDIN: an owner act, a written Goal.
add_goal() {
  added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
    --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
  id=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$id" ] || fail "no Goal id in: $added"
  echo "$id $1" >>"$map"
  commit_staged "goal $1" || fail "commit goal"
}

# new_cmd: run a finding command of this Goal. On failure print the outcome
# and exit 0. Its stdout stays in $work/so.
new_cmd() {
  HYP_ACTOR=agent hyp "$@" >"$work/so" 2>"$work/se"
  code=$?
  if [ "$code" -ne 0 ]; then
    norm "$work/so"
    norm "$work/se"
    echo "exit $code"
    exit 0
  fi
  cat "$work/so" >&2
  cat "$work/se" >&2
}

add_finding() {
  new_cmd finding add --fact 'The greeting says hello.' --evidence 'greet.txt line 1'
  F=$(sed -n 's/.*recorded \(F-[A-Z0-9]*\).*/\1/p' "$work/so" | head -n 1)
  [ -n "$F" ] || fail "no finding id"
  echo "$F $1" >>"$map"
  commit_staged "finding $1" || fail "commit finding"
}

add_goal G-ONE
add_finding F-ONE
new_cmd finding refute "$(real F-ONE)"
commit_staged refute || fail "commit refute"

export HYP_ACTOR=agent
unset HYP_ROLE
run=$(denorm "$HYP_RUN")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
norm "$work/out"
norm "$work/err"
echo "exit $code"
exit 0
