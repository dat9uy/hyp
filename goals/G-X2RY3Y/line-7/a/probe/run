#!/bin/sh
# Probe of an example whose inner Goal's guard example reads $HOME/demo, which changes after the add. CN is the
# commit of a fix N, run by the runner. The working directory is a
# copy of the subject. It builds hyp from the subject and makes a test repo: H0 has counter "counter: bad"
# and name "hyp". The owner adds an inner Goal with a gap line (the counter says ok, example line-1/a) and a
# guard line (the name stays hyp, example line-2/a). N is H0 plus a new file other; CN is N plus counter ok
# and a spec. The demo file is written on before the add and off after it. GOAL, CN and BASE_N in the run
# section are replaced by the Goal id and the commits. It prints the stdout with ids mapped to tokens, then a
# last line "exit N". Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'counter: bad\n' >counter
printf 'hyp\n' >name
git add -A && git commit -q -m h0 >&2 || fail "commit H0"
h0=$(git rev-parse HEAD)

owner() { HYP_ACTOR=owner HYP_ROLE=owner hyp "$@"; }
runner() { HYP_ACTOR=runner-1 HYP_ROLE=runner hyp "$@"; }

# mkex LINE KEY WORDS RUN FLOOR...: an example of the draft x with the generic Probe
draft=$(owner draft path x) || fail "draft path"
mkex() {
  d="$draft/$1/$2"
  mkdir -p "$d/probe" || fail "mkdir example"
  { printf '%s\n' '-- words --' "$3" '-- run --' "$4"
    shift 4
    for f in "$@"; do printf '%s\n' '-- floor: contains --' "$f"; done
  } >"$d/example.txtar"
  cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
}
mkex line-1 a 'The counter says ok.' 'cat counter' 'counter:' 'ok'
mkex line-2 a 'The demo file says on.' 'cat "$HOME/demo"' 'on'

printf 'on\n' >"$HOME/demo" || fail "write demo on"
owner add goal --base "$h0" --words 'Count.' --line 'gap:the counter says ok.' --line 'guard:the name stays hyp.' --draft x >"$work/add" 2>&1 || { cat "$work/add" >&2; fail "add goal"; }
cat "$work/add" >&2
goal=$(grep -o 'G-[0-9A-Z]\{6\}' "$work/add" | head -1)
[ -n "$goal" ] || fail "no Goal id"
git add -A && git commit -q -m goal >&2 || fail "commit goal"

# N: a fix that changes nothing measured; CN: N plus the runner's change and a spec
printf 'off\n' >"$HOME/demo" || fail "write demo off"
git checkout -q -b n "$h0" || fail "checkout n"
printf 'x\n' >other
git add -A && git commit -q -m n >&2 || fail "commit N"
n=$(git rev-parse HEAD)
printf 'counter: ok\n' >counter
mkdir -p "goals/$goal/specs" && printf 'spec cn\n' >"goals/$goal/specs/spec.md" || fail "spec"
git add -A && git commit -q -m cn >&2 || fail "commit CN"
cn=$(git rev-parse HEAD)
git checkout -q main || fail "checkout main"


run=$(printf '%s' "$HYP_RUN" | sed -E -e "s/(^|[^A-Za-z0-9_-])BASE_N([^A-Za-z0-9_-]|\$)/\1$n\2/g" -e "s/(^|[^A-Za-z0-9_-])CN([^A-Za-z0-9_-]|\$)/\1$cn\2/g" -e "s/(^|[^A-Za-z0-9_-])GOAL([^A-Za-z0-9_-]|\$)/\1$goal\2/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$goal/GOAL/g" -e "s/$cn/CN/g" -e "s/$n/BASE_N/g" \
    -e "s/$(echo "$cn" | cut -c1-7)[0-9a-f]*/CN/g" -e "s/$(echo "$n" | cut -c1-7)[0-9a-f]*/BASE_N/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
