-- words --
The lamp with two examples (press and look, contains "lamp: on"; look, equals "lamp: off") and the tried verdicts of NeverOff on both and of SlowPress on the first, all met: the report holds the rules table, the grid with predicted and tried cells and a separated-by row, names the cell where SlowPress's tried verdict differs from its prediction, and holds a part for NeverOff, which no example separates, naming LampFollowsPresses, a press and the prints "lamp: on" and "lamp: off".
-- input/fx/goals/G-LAMP/specs/lamp.tla --
---- MODULE lamp ----
(* A lamp with one button. Pressing prints "pressed"; looking prints the
   lamp. SlowPress: the first press from off only half-presses. NeverOff: a
   press while on leaves the lamp on. *)
EXTENDS Naturals
CONSTANTS SlowPress, NeverOff
VARIABLES on, half, parity, said
vars == <<on, half, parity, said>>

Init == on = FALSE /\ half = FALSE /\ parity = 0 /\ said = "none"

Press ==
    /\ parity' = 1 - parity
    /\ said' = "pressed"
    /\ IF on
         THEN /\ on' = NeverOff
              /\ half' = FALSE
         ELSE IF SlowPress /\ ~half
           THEN /\ on' = FALSE
                /\ half' = TRUE
           ELSE /\ on' = TRUE
                /\ half' = FALSE

Look ==
    /\ said' = IF on THEN "on" ELSE "off"
    /\ UNCHANGED <<on, half, parity>>

Next == Press \/ Look
Spec == Init /\ [][Next]_vars

\* source: model only
TypeOK == on \in BOOLEAN /\ half \in BOOLEAN /\ parity \in {0, 1}

\* source: line-1
OnePressTurnsOn == ~half

\* source: line-2
LampFollowsPresses == on = (parity = 1)

SaidIsKnown == said \in {"none", "pressed", "on", "off"}
====
-- input/fx/goals/G-LAMP/specs/lamp.cfg --
SPECIFICATION Spec

CONSTANTS
    SlowPress = FALSE
    NeverOff = FALSE

INVARIANTS
    TypeOK
    OnePressTurnsOn
    LampFollowsPresses
    SaidIsKnown
-- input/fx/goals/G-LAMP/specs/lamp-view.mjs --
// The lamp as its user sees it. print() is what the lamp prints on a step.
export const title = "A lamp with one button";
export const state = (v) => (v.on ? "On" : v.half ? "Half pressed" : "Off");
export const step = (action) => (action === "Press" ? "you press" : "you look");
export const print = (action, from, to) =>
  action === "Press" ? "pressed" : to.on ? "lamp: on" : "lamp: off";
-- input/fx/goals/G-LAMP/line-1/a/example.txtar --
~~ words ~~
One press turns the lamp on.
~~ run ~~
press; look
~~ floor: contains ~~
lamp: on
-- input/fx/goals/G-LAMP/line-3/a/example.txtar --
~~ words ~~
A new lamp is off.
~~ run ~~
look
~~ floor: equals ~~
lamp: off
-- input/fx/goals/G-LAMP/specs/tried/NeverOff/line-1/a.txt --
verdict: met, exit 0
-- input/fx/goals/G-LAMP/specs/tried/NeverOff/line-3/a.txt --
verdict: met, exit 0
-- input/fx/goals/G-LAMP/specs/tried/SlowPress/line-1/a.txt --
verdict: met, exit 0
-- run --
t=$HYP_SUBJECT/skills/hyp-statechart/scripts/statechart
w=$(mktemp -d) && o=$(mktemp -d)/out && so=${o%/out}/stdout || exit 91
(cd "$HYP_EXAMPLE/input/fx" && find . -type f) | while read -r f; do
  mkdir -p "$w/$(dirname "$f")" && sed 's/^~~ \(.*\) ~~$/-- \1 --/' "$HYP_EXAMPLE/input/fx/$f" >"$w/$f"
done
cd "$w" || exit 91
yn() { if [ "$1" = 0 ]; then echo yes; else echo no; fi; }
"$t" goals/G-LAMP/specs/lamp.tla --config goals/G-LAMP/specs/lamp.cfg --view goals/G-LAMP/specs/lamp-view.mjs --out "$o" >"$so" 2>&1
all=$(mktemp)
cat "$so" >"$all" 2>/dev/null
find "$o" -name '*.md' -type f -exec cat {} + >>"$all" 2>/dev/null
VARIANTS='SlowPress NeverOff'
# cell ROW VARIANT: the met/fail words of the grid cell of example ROW (or
# the row whose first cell starts with ROW) under VARIANT, read from the
# Markdown table whose header names every variant of VARIANTS.
cell() {
  awk -v row="$1" -v col="$2" -v vs="$VARIANTS" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^\|/ {
      n = split($0, c, "|")
      if (!hdr) {
        k = split(vs, want, " "); found = 0
        for (i = 2; i < n; i++) for (j = 1; j <= k; j++) if (trim(c[i]) == want[j]) found++
        if (found == k) { hdr = 1; for (i = 2; i < n; i++) if (trim(c[i]) == col) ci = i }
        next
      }
      first = trim(c[2])
      if (ci && (first == row || index(first, row) == 1)) {
        s = tolower(c[ci]); out = ""
        while (match(s, /met|fail/)) { out = out (out ? " " : "") substr(s, RSTART, RLENGTH); s = substr(s, RSTART + RLENGTH) }
        print (out ? out : "empty"); exit
      }
      next
    }
    hdr { hdr = 0; ci = 0 }
  ' "$all"
}
# keys ROW VARIANT: the example keys in that cell, sorted, or "none"
keys() {
  awk -v row="$1" -v col="$2" -v vs="$VARIANTS" '
    function trim(s) { gsub(/^[ \t]+|[ \t]+$/, "", s); return s }
    /^\|/ {
      n = split($0, c, "|")
      if (!hdr) {
        k = split(vs, want, " "); found = 0
        for (i = 2; i < n; i++) for (j = 1; j <= k; j++) if (trim(c[i]) == want[j]) found++
        if (found == k) { hdr = 1; for (i = 2; i < n; i++) if (trim(c[i]) == col) ci = i }
        next
      }
      if (ci && index(tolower(trim(c[2])), row) == 1) { print c[ci]; exit }
      next
    }
    hdr { hdr = 0; ci = 0 }
  ' "$all" | { v=$(cat); k=$(printf '%s\n' "$v" | grep -o 'line-[0-9]*/[a-z0-9-]*' | sort | tr '\n' ' ' | sed 's/ $//'); if [ -n "$k" ]; then echo "$k"; elif printf '%s' "$v" | grep -qi none; then echo none; else echo empty; fi; }
}
grep '^|' "$all" | grep -i 'source' | grep -i 'broken by' | grep -qi 'an example sees it break'; echo "rules table header: $(yn $?)"
grep '^|' "$all" | grep -w OnePressTurnsOn | grep -w 'line-1' | grep -w SlowPress | grep -v -w NeverOff | grep -qiw yes; echo "OnePressTurnsOn row: line-1, broken by SlowPress, seen: $(yn $?)"
grep '^|' "$all" | grep -w LampFollowsPresses | grep -w 'line-2' | grep -w SlowPress | grep -w NeverOff | grep -qiw yes; echo "LampFollowsPresses row: line-2, broken by both, seen: $(yn $?)"
for e in line-1/a line-3/a; do echo "$e: SlowPress $(cell $e SlowPress), NeverOff $(cell $e NeverOff)"; done
echo "separated by: SlowPress $(keys 'separated by' SlowPress); NeverOff $(keys 'separated by' NeverOff)"
grep -i 'differ' "$all" | grep -w SlowPress | grep -q 'line-1/a'; echo "the differing cell is named: $(yn $?)"
grep -i 'differ' "$all" | grep -w NeverOff | grep -q 'line-'; echo "a NeverOff cell named as differing: $(yn $?)"
part=$(awk '/^#/ { p = ($0 ~ /NeverOff/) } p' "$all")
for w in LampFollowsPresses press 'lamp: on' 'lamp: off'; do printf '%s\n' "$part" | grep -qi -- "$w"; echo "NeverOff part names $w: $(yn $?)"; done
awk '/^#/ { p = ($0 ~ /SlowPress/ && $0 !~ /NeverOff/) } p' "$all" | grep -qi 'lamp: on'; echo "a gap part for SlowPress: $(yn $?)"
-- floor: equals --
rules table header: yes
OnePressTurnsOn row: line-1, broken by SlowPress, seen: yes
LampFollowsPresses row: line-2, broken by both, seen: yes
line-1/a: SlowPress fail met, NeverOff met met
line-3/a: SlowPress met, NeverOff met met
separated by: SlowPress line-1/a; NeverOff none
the differing cell is named: yes
a NeverOff cell named as differing: no
NeverOff part names LampFollowsPresses: yes
NeverOff part names press: yes
NeverOff part names lamp: on: yes
NeverOff part names lamp: off: yes
a gap part for SlowPress: no
