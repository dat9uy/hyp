#!/bin/sh
# Probe of G-T30ZAY line-2/d. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test store with the Goals and findings
# the example needs, replaces the stand-in ids (G-ONE, G-TWO, F-ONE, F-TWO) in
# the run section with the real ids, runs it, prints its stdout then its stderr
# with each real id replaced back by its stand-in, then a last line "exit N",
# the exit code of the run section. Setup output goes to stderr. A setup step
# that runs a new finding command and fails is an outcome: the Probe prints its
# output and "exit N" and exits 0. Any other setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"

# ids.sed maps each real id back to its stand-in; run.sed maps each stand-in
# to its real id.
: >"$work/ids.sed"
: >"$work/run.sed"
nG=0
nF=0

# add_goal WORDS: adds a written Goal, sets $G to its id, maps it to G-ONE...
add_goal() {
  added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words "$1" \
    --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
  G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$G" ] || fail "no Goal id in: $added"
  commit_staged "goal $G" || fail "commit goal"
  nG=$((nG + 1))
  case $nG in 1) s=G-ONE ;; 2) s=G-TWO ;; *) s=G-THREE ;; esac
  echo "s/$G/$s/g" >>"$work/ids.sed"
  echo "s/$s/$G/g" >>"$work/run.sed"
}

# place_goal G: places a fixture example with the generic Probe on G.
place_goal() {
  d="goals/$1/line-1/a"
  mkdir -p "$d/probe" || fail "mkdir $d"
  {
    echo '-- words --'
    echo "Fixture line-1/a."
    echo '-- run --'
    echo "cat greet.txt"
    echo '-- floor: contains --'
    echo "bye"
  } >"$d/example.txtar"
  cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "run exit: $code"
echo "exit $code"
rm -f "$tmp"
GENERIC
  chmod +x "$d/probe/run"
  mkdir -p "goals/$1/specs" && echo spec >"goals/$1/specs/spec.txt" || fail "spec"
  git add -A && git commit -q -m fixtures >&2 || fail "commit fixtures"
  HYP_ACTOR=grill HYP_ROLE=grill hyp place "$1" >&2 || fail "hyp place failed"
  commit_staged placed || fail "commit placed"
}

# select_goal G: runs a Hypothesis that meets line-1 on G and selects it.
select_goal() {
  git checkout -q -b "h-$1" main >&2 || fail "checkout h"
  echo bye >greet.txt
  git add -A && git commit -q -m h >&2 || fail "commit h"
  c=$(git rev-parse HEAD)
  git checkout -q main >&2 || fail "checkout main"
  ran=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run "$c" "$1/line-1") || fail "hyp run failed: $ran"
  printf '%s\n' "$ran" >&2
  row=$(printf '%s\n' "$ran" | sed -n 's/^row: //p' | head -n 1)
  [ -n "$row" ] || fail "no row in: $ran"
  commit_staged "events of h" || fail "commit events"
  HYP_ACTOR=runner HYP_ROLE=runner hyp select "$1" "$row" --why 'h meets line-1' >&2 ||
    fail "hyp select failed"
  commit_staged select || fail "commit select"
}

# setup_outcome FILE N: print the output of a setup step that failed, then
# "exit N", and exit 0. The failure is part of the outcome.
setup_outcome() {
  sed -f "$work/ids.sed" "$1"
  if [ -n "$(tail -c 1 "$1")" ]; then echo; fi
  echo "run exit: $2"
  echo "exit $2"
  exit 0
}

# add_finding: records a finding in the new form (no Goal), sets $F, maps it to
# F-ONE, F-TWO.
add_finding() {
  HYP_ACTOR=agent hyp finding add --fact 'The subject says hello.' \
    --evidence 'greet.txt line 1' >"$work/o" 2>"$work/e"
  code=$?
  if [ "$code" -ne 0 ]; then
    cat "$work/e" >>"$work/o"
    setup_outcome "$work/o" "$code"
  fi
  F=$(sed -n 's/^recorded \(F-[A-Z0-9]*\).*/\1/p' "$work/o" | head -n 1)
  [ -n "$F" ] || fail "no finding id in: $(cat "$work/o")"
  nF=$((nF + 1))
  case $nF in 1) s=F-ONE ;; *) s=F-TWO ;; esac
  echo "s/$F/$s/g" >>"$work/ids.sed"
  echo "s/$s/$F/g" >>"$work/run.sed"
}

# setup_cmd ARGS...: runs a finding act of the setup; a failure is the outcome.
setup_cmd() {
  HYP_ACTOR=agent "$@" >"$work/o" 2>"$work/e"
  code=$?
  if [ "$code" -ne 0 ]; then
    cat "$work/e" >>"$work/o"
    setup_outcome "$work/o" "$code"
  fi
}

add_goal 'Greet.'
G1=$G
HYP_ACTOR=owner HYP_ROLE=owner hyp close "$G1" --why 'done' >&2 || fail "hyp close failed"
commit_staged close || fail "commit close"
add_finding
F1=$F

export HYP_ACTOR=agent
unset HYP_ROLE
run=$(printf '%s' "$HYP_RUN" | sed -f "$work/run.sed")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
sed -f "$work/ids.sed" "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
sed -f "$work/ids.sed" "$work/err"
echo "run exit: $code"
echo "exit $code"
exit 0
