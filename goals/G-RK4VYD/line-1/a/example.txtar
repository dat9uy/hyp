-- words --
With no $XDG_STATE_HOME, the owner adds a Goal, reads it, runner-1 is refused a run, and the owner gives a bad argument; every trace is under ~/.hyp, nothing is under ~/.local, and once ~/.hyp is moved away hyp show no longer holds the owner's read.
-- run --
bin=$(mktemp -d) && go build -o "$bin/hyp" ./cmd/hyp || exit 90
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
HOME=$(mktemp -d) && export HOME && unset XDG_STATE_HOME || exit 91
mkrepo() { r=$(mktemp -d) && cd "$r" && git init -q && git commit -q --allow-empty -m base && g=$(HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" add goal --base HEAD --words "$1" --line "gap:$1" | sed -n 's/^recorded //p') && [ -n "$g" ] && git add -A && git commit -q -m 'record the Goal'; }
files() { if [ -d "$1" ] && [ -n "$(find "$1" -type f | head -n 1)" ]; then echo some; else echo none; fi; }
holds() { if [ -s "$1" ]; then perl -e 'local $/; open A, "<", $ARGV[0]; open B, "<", $ARGV[1]; my $a = <A>; my $b = <B>; print index($b, "stdout, " . length($a) . " bytes:
" . $a) >= 0 ? "yes" : "no"' "$1" "$2"; else echo 'no, the read is empty'; fi; }
holding() { n=none; if [ -s "$2" ] && [ -d "$1" ]; then n=$(find "$1" -type f -exec perl -e 'local $/; open A, "<", $ARGV[0]; open B, "<", $ARGV[1]; my $a = <A>; my $b = <B>; exit(index($b, $a) >= 0 ? 0 : 1)' "$2" {} \; -print | head -n 1 | sed 's/.*/some/'); [ -n "$n" ] || n=none; fi; echo "$n"; }
nogit() { ch=$(git status --porcelain --untracked-files=all); if [ -n "$ch" ]; then echo "changes git sees: $ch"; else echo 'changes git sees: none'; fi; }
hy() { a=$1 r=$2; shift 2; out=$(HYP_ACTOR=$a HYP_ROLE=$r "$bin/hyp" "$@" 2>"$bin/err"); c=$?; case "$out" in *"$g"*) n=yes ;; *) n=no ;; esac; if [ -s "$bin/err" ]; then w=yes; else w=no; fi; echo "$a: hyp $(echo "$*" | sed "s/$g/G/g"): exit $c, names the Goal: $n, stderr: $w"; }
mkrepo 'Say hello.' || exit 92
hy owner owner status
hy runner-1 runner run HEAD "$g/line-1"
hy owner owner status G-AAAAAA
HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" status >"$bin/read" 2>/dev/null
HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" show owner >"$bin/view" 2>&1; echo "owner: hyp show owner: exit $?"
echo "hyp show owner holds the owner's read byte for byte: $(holds "$bin/read" "$bin/view")"
echo "files under ~/.hyp: $(files "$HOME/.hyp")"
echo "files under ~/.local: $(files "$HOME/.local")"
if [ -d "$HOME/.hyp" ]; then mv "$HOME/.hyp" "$bin/moved"; fi
HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" show owner >"$bin/view2" 2>&1
echo "after ~/.hyp is moved away, hyp show owner still holds that read: $(holds "$bin/read" "$bin/view2")"
nogit
-- floor: equals --
owner: hyp status: exit 0, names the Goal: yes, stderr: no
runner-1: hyp run HEAD G/line-1: exit 1, names the Goal: yes, stderr: yes
owner: hyp status G-AAAAAA: exit 2, names the Goal: no, stderr: yes
owner: hyp show owner: exit 0
hyp show owner holds the owner's read byte for byte: yes
files under ~/.hyp: some
files under ~/.local: none
after ~/.hyp is moved away, hyp show owner still holds that read: no
changes git sees: none
