#!/bin/sh
# Probe of draft-397-3 line-3/b. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with base commit holding greet.txt = hello
# and a draft folder, adds Goals G-ONE and G-TWO, then makes C1 (greet.txt = bye, plus a file
# under G-TWO's folder). The run section runs G-ONE on C1.
# Then it runs the example's run section with G-ONE, C1 and C2 replaced by the
# real ids, prints its output with real ids mapped back, then a last line "exit N".
# Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add -A && git commit -q -m base >&2 || fail "commit base"

for n in greet greet2; do
  d="goals/draft-$n/line-1/a"
  mkdir -p "$d/probe" || fail "mkdir $d"
  printf '%s\n' '-- words --' 'The subject says bye.' '-- run --' 'cat greet.txt' \
    '-- floor: contains --' 'bye' >"$d/example.txtar"
  cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
done
commit_staged draft || fail "commit draft"

export HYP_ACTOR=owner HYP_ROLE=owner
add_one() { # add_one DRAFT: prints the new Goal id
  out=$(hyp add goal --base HEAD --words Greet. --line 'gap:the subject says bye.' --examples "goals/$1" 2>"$work/adderr") \
    || fail "hyp add goal: $(cat "$work/adderr")"
  id=$(printf '%s\n' "$out" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$id" ] || fail "no Goal id in: $out"
  commit_staged "goal $id" || fail "commit goal"
  printf '%s' "$id"
}
G=$(add_one draft-greet) || exit 3
G2=$(add_one draft-greet2) || exit 3

git checkout -q -b c1 main >&2 || fail "checkout c1"
echo bye >greet.txt
mkdir -p "goals/$G2" || fail "mkdir goals/$G2"
echo x >"goals/$G2/x.txt"
commit_staged c1 || fail "commit c1"
git checkout -q main >&2 || fail "checkout main"
C1=$(git rev-parse c1) || fail "rev-parse c1"
C2=$C1

export HYP_ACTOR=owner HYP_ROLE=owner
run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g" -e "s/G-TWO/$G2/g" -e "s/C1/$C1/g" -e "s/C2/$C2/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
g2=$(printf '%s' "$G2" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$G2/G-TWO/g" -e "s/$g2/g-two/g" -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" -e "s/$C1/C1/g" -e "s/$C2/C2/g" \
    -e "s/$(printf '%s' "$C1" | cut -c1-8)[0-9a-f]*/C1/g" \
    -e "s/$(printf '%s' "$C2" | cut -c1-8)[0-9a-f]*/C2/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
