+{"parentUuid":"433ac6bf-e212-4c54-812f-138b30ecfd41","isSidechain":false,"promptId":"e872626d-b763-4441-a602-74e1f7319ed3","type":"user","message":{"role":"user","content":[{"tool_use_id":"toolu_015PLFks1q9c43HjFMrQx3gE","type":"tool_result","content":"\t\t}\n\t\td = up\n\t}\n}\n\n// cmdPrompt prints the /goal prompt for a Goal, derived from the log: the\n// store's path, the actor, the Goal, the hyp-goal-run skill, the stop clauses\n// and the Goal body's constraints block. It reads no owner answer, so the\n// same Goal node and flags give the same bytes in any store.\nfunc cmdPrompt(args []string, stdout, stderr io.Writer) error {\n\tfs := readFlags(\"prompt\", stderr)\n\tactor := fs.String(\"actor\", \"\", \"the runner's actor name (required; $HYP_ACTOR is not read)\")\n\tbranch := fs.String(\"branch\", \"\", \"the branch the run commits on\")\n\tpr := fs.Int(\"pr\", 0, \"the number of the PR the run updates\")\n\texperiments := fs.Int(\"experiments\", 5, \"stop after this many Results recorded under the actor\")\n\tpos, err := parse(fs, args)\n\tif err != nil {\n\t\treturn err\n\t}\n\tif len(pos) != 1 {\n\t\treturn usageErr(promptUse)\n\t}\n\tif *actor == \"\" {\n\t\treturn usageErr(\"missing --actor: hyp prompt does not read $HYP_ACTOR\")\n\t}\n\tif !store.ValidActor(*actor) {\n\t\treturn usageErr(\"invalid actor %q (want ^[a-z0-9][a-z0-9-]{0,39}$)\", *actor)\n\t}\n\tif *experiments < 1 {\n\t\treturn usageErr(\"--experiments must be at least 1\")\n\t}\n\tif *pr < 0 {\n\t\treturn usageErr(\"--pr must be a PR number\")\n\t}\n\tif strings.ContainsFunc(*branch, unicode.IsSpace) || strings.ContainsFunc(*branch, unicode.IsControl) {\n\t\treturn usageErr(\"--branch %q holds a space or a control character, which would break the prompt's lines\", *branch)\n\t}\n\tr, err := openReader()\n\tif err != nil {\n\t\treturn err\n\t}\n\tid, err := resolveRef(r.full, pos[0])\n\tif err != nil {\n\t\treturn usageErr(\"%v\", err)\n\t}\n\tn := r.full.Nodes[id]\n\tif n.Kind != event.KindGoal {\n\t\treturn usageErr(\"hyp prompt takes a Goal: %s is a %s\", pos[0], n.Kind)\n\t}\n\tg := event.DisplayID(event.KindGoal, id)\n\tblock, problems, _ := constraintsBlock(n.Body)\n\tif len(problems) > 0 {\n\t\treturn herr.Refused(\"hyp prompt %s: %s\", g, strings.Join(problems, \"; \"))\n\t}\n\t// The working directory may reach the store through a symbolic link;\n\t// the store's place in its repository is read from its real path.\n\tstoreDir, err := filepath.EvalSymlinks(r.root)\n\tif err != nil {\n\t\treturn herr.Env(\"%v\", err)\n\t}\n\trepo, ok := repoRoot(storeDir)\n\tif !ok {\n\t\treturn herr.Env(\"hyp prompt %s: no repository holds the store %s, so its path relative to the repository root is not known\", g, storeDir)\n\t}\n\trel, err := filepath.Rel(repo, storeDir)\n\tif err != nil {\n\t\treturn herr.Env(\"%v\", err)\n\t}\n\trel = filepath.ToSlash(rel)\n\n\tvar b strings.Builder\n\tfmt.Fprintf(&b, \"/goal Run the hyp tree in %s with the hyp-goal-run skill, as HYP_ACTOR=%s. Its Goal is %s: read it with hyp show %s, read hyp status %s, and name --goal %s on every hyp checkpoint.\\n\", rel, *actor, g, g, g, g)\n\tfmt.Fprintf(&b, \"Done when the latest printed hyp status %s shows \\\"runner owes nothing: stop and report to the owner\\\" under OWED, or %d Results have been recorded under %s, or you cannot take the next step honestly and say why.\\n\", g, *experiments, *actor)\n\tfor _, l := range block {\n\t\tb.WriteString(l)\n\t\tb.WriteString(\"\\n\")\n\t}\n\tif *branch != \"\" {\n\t\tfmt.Fprintf(&b, \"Commit on the branch %s.\\n\", *branch)\n\t}\n\tif *pr > 0 {\n\t\tfmt.Fprintf(&b, \"The run's PR is #%d.\\n\", *pr)\n\t}\n\tfmt.Fprint(stdout, b.String())\n\treturn nil\n}\ngrep: internal/cli/record.go: No such file or directory\n71:**[added] limits**: a Result names the limits it found (`limits`): each is a case the Goal covers that no check ran on the Hypotheses the Result judged (ADR 0016). A later Result that runs the case closes it (`closes`). A limit's key is `<result-id>#<n>`: the Result's full ULID, then `n`, which counts the Result's `limits` from 1. The CLI accepts any node reference before the `#` (§2) and stores the full id. An owner checkpoint accepts a limit the runner referred (`accepts`); an old owner confirm's `accepts` is replayed as an accept. §8 derives each limit's state, and §8.2 states which move applies from which state. `hyp record` prints the key of each limit and reading it records, under the Result's line, so a later command names them without counting `--limit` or `--reading` flags, and the whole text of each limit it closes (`  closes R-…#n: <text>`). A close covers every case its limit names; a case the Result did not run is a new `--limit` on it, referred when void (ADR 0016). A close records that the case ran, whatever the verdicts: a Result that runs the case and contradicts a Hypothesis closes it too. `hyp record` warns, at exit 0, when its Experiment aims at an open limit that the Result neither closes nor follows with a new `--limit` (`warn: E-… aims at R-…#n and this Result does not close it; …`), since an instrument failure may leave an aimed limit open on purpose.\n82:It is read in this order: under a DesignQuestion, measure only; with a rubric bundle, run and rule when the recipe is pinned and reassess when it is `none`; with `reading`, reassess when the recipe is `none` and `records` is not empty, and rule by reading otherwise. An Experiment with no rubric, written before #106 or merged in, reads as run and rule when its recipe is pinned and as rule by reading when it is `none`. `hyp add exp` refuses a rubric bundle with recipe `none` and no `records`, since the rubric would have no measures to read (§5.1). `hyp show E` prints the shape. A record is a file under `.tree/evidence/`; the Experiment's own run is `.tree/evidence/<its display id>/`. `records` pins earlier records the way a Hypothesis's subject pins files: a directory given at add stands for each regular file under it, `path` is relative to the store root and is a pointer, and the sha256 is the identity. A record is never named by a Result id, because a ruling depends on the bytes, not on another Result's claim.\n86:**[added] lines**: the Goal's lines are the cases every candidate must meet (ADR 0016 amendment \"a Goal line is a limit the owner records\"). They come with the Goal: the owner adds the Goal with `lines` on its `node.add` (`hyp add goal --line TEXT`, repeatable), and no later event adds a line (ADR 0020). A line is never edited: what it means is a reading, a line the Goal no longer needs is referred and accepted, a case under it is a limit the owner returns, and a new line is a new Goal, which may sit in the same store. A line is a limit keyed on the Goal, `<goal-id>#<n>`, where `n` counts the add's `lines` from 1, and it has every move a limit has: a Result `closes` it, an Experiment `aims` at it, a checkpoint `refers` it and an answer `returns` or `accepts` it. Its scope is the Goal, so a Result under any question may close it and an Experiment under any question may aim at it. `hyp add goal` prints the key of each line it writes (`  line G-…#n: <text>`). An old Goal's lines were written on its first owner checkpoint (`hyp checkpoint --role owner --line`, no longer a command); replay still applies them, with the same keys, and that checkpoint counts as the one write. **Cites**: a line names 0 to 10 plain keys (`hyp add goal --cite N=KEY`, repeatable), each settled when the line is written: a line, an accepted or closed limit, an answered reading, or a selected or contradicted Hypothesis (by its id). Anything else is refused at exit 1 (§5 rule 31). A cite carries no relation label: what it means is derived from the key's state at the line's place in the log, a line or an accepted limit **carried**, a closed limit or a contradicted Hypothesis **forbidden**, an answered reading **applied**, a selected Hypothesis **realised**. A Goal's origin is the Goals its cited keys belong to. When a cited key's state later differs, `hyp check` warns (`warn: G-…#n cites H-…, which was realised when the line was written and is unsettled now`) and `hyp show G-…#n` prints both (`cites H-…: realised, now unsettled`); no status changes. A Goal of a store with many Goals is named on a checkpoint with `hyp checkpoint --goal G-…` (without it, exit 2).\n88:**[added] subject**: a subject has one shape, a base commit plus what is given over it: at most one patch, and input files (ADR 0020). A Hypothesis may name its subject, what embodies its claim, with `hypothesis.subject` (`hyp subject H [PATH…] [--base COMMIT [--patch FILE]]`, or `hyp add hyp --subject PATH`, which writes the add and the tie). Over a base, `--patch` names the one patch applied over it, and the PATHs are the input files given to the code; `--patch` without `--base` exits 2. `--base` is resolved in the git repository that holds the store root to a full commit id (exit 2 when it names no commit, exit 3 when `git` is not on PATH). A directory stands for each regular file under it. `path` is relative to the store root and is a pointer for readers; the sha256 is the identity. A Result keeps one subject per cited run, `subjects`, and a run's subject **holds** a Hypothesis's subject (`replay.HoldsSubject`) when, if the Hypothesis names a base, the run is at that base with the same patch, none when the Hypothesis names none, and was given each of the Hypothesis's files as an input file, compared by sha256. A patch changes the code and an input file is data given to the code (owner answer to R-0HABWN#7 in checkpoint-store), so a run at B plus a patch never holds bare B, a run at bare B never holds B plus a patch, and a run at B given input files holds bare B. If the Hypothesis names no base, as every subject before ADR 0020, the run holds it at any base when it was given each of its files, as its patch or as an input. An old Result's `fingerprints` read as one subject with no base, so the coverage they gave is unchanged. The latest tie stands until a run subject of a non-retracted Result holds it; after that the bytes ran as this Hypothesis, and a different subject is a different Hypothesis, added and superseding it. Two Hypotheses may share a subject, since the claim is what differs. A tie is a claim hyp cannot check: that these bytes embody the words. `hyp record` reads each cited `command.json` and `sandbox.json` under the store and writes one subject for each, in evidence order, keeping one of two that are alike: a command record's has no base and no patch, and the sha256 of each input and each directory entry (format 6) as its files; a sandbox record holds one run per Arm, each at its base with that Arm's one patch as its `patch` and the inputs file as its files, and with no Arm one run at its base given the inputs file; an Arm whose patch is not named by a lowercase hex sha256 gives no subject, since the code it ran is unknown. It copies them as it copies `evidence_hashes`; replay reads no files, so the log must hold them for coverage (§8) to reach the ledger.\n124:23. A `checkpoint` or `answer` move on a reading or a limit that the move tables of §8.2 refuse. The refusals that name `closes` and `revises` below read old owner checkpoints, which replay still checks as written; an answer's `answers` item is a close of an open reading and a revise of an answered one, so it meets neither the close nor the revise refusal by state. For readings: a `closes` or `revises` without the owner role (`bad checkpoint: only an owner closes a reading`, `… revises an answer`), a limit key (`bad closes: <key> is a limit; an owner accepts a limit with accepts`, `bad revises: <key> is a limit; a limit is closed, accepted or referred, never revised`), a bad key as in §4 readings (`bad reading ref: …`), a close of an answered reading (`bad closes: <key> is answered; an owner revises an answer with revises`), a revise of an open one (`bad revises: <key> is open; an owner answers an open reading with closes`), a key in both `closes` and `revises`, or a move under the actor that recorded the key's Result (separation of duties). For limits and lines: more than 10 keys in a field (`over limit`); a key that names no limit (`bad refers: …`, `bad accepts: …`, `bad returns: …`); an `accepts` or `returns` without the owner role (`bad checkpoint: only an owner accepts a limit`, `… returns a limit`); a `returns` key also in the same checkpoint's `refers` or `accepts`; a `refers` of an accepted limit (`bad refers: <key> is accepted; only the owner reopens it, with returns`); an `accepts` of a limit whose latest hand is not a refer (`bad accepts: <key> is not referred; only a referred limit is accepted, so the runner refers it first`); a `returns` of one whose latest hand is not a refer or an accept (`bad returns: <key> is not referred or accepted; only a referred or accepted limit is returned`); a `refers`, `accepts` or `returns` of a Result's limit that a Result closed (`bad refers: <key> is closed by R-…; its case ran, so there is nothing to refer`, `bad accepts: <key> is closed by R-…; its case ran, so there is nothing to accept`, `bad returns: <key> is closed by R-…`); or an `accepts` or `returns` under the actor of the latest refer (`separation of duties: <actor> referred the limit it accepts`, `… it returns`). `hyp checkpoint` refuses `--role`, `--closes`, `--revises`, `--accept`, `--returns` and `--line` at exit 2, naming `hyp answer` or `hyp add goal --line` (ADR 0020). In a merged log, a return or an accept that sorts before its limit's refer is rejected and reported.\n142:- `hyp add exp` under Hypothesis H is refused when H's question has live rivals of H (§7.1) and `targets` names none of them, unless `--target none` is passed. Such an Experiment in a merged log still shows as `one-rival` in `hyp signals`.\n145:- `hyp add exp` under a Hypothesis is refused when the Experiment has no rubric: `--rubric REF` pins a bundle, `--rubric reading` says the body decides its verdicts by reading. `hyp add exp` is refused, at exit 1, when its `--recipe` is a bundle whose known answers expect a `verdict:` line (`a recipe measures and never prints a verdict; put the rule in a rubric`), when its `--rubric` names a bundle with a step section or not exactly one Standalone command, or a bundle with no known-answer case, or one where a label its cases print has no case printing `supports` or none printing `contradicts`, when `--rubric` names a bundle, the recipe is `none` and no `--records` is given (`the rubric has no measures to read: pin a recipe or --records`), and when `--rubric` or `--target` is given under a DesignQuestion (exit 2). `--records PATH` (repeatable) is read at add: a directory stands for each regular file under it, a path outside `.tree/evidence/` is refused (exit 2), and hyp stores each file's path and sha256; the new Experiment has no run yet, so every file it names is an earlier record. `--decided-by reading` is the older spelling of `--rubric reading` and writes `rubric: reading`. Replay does not check the rubric's presence: an Experiment without one in a merged log, or written before #106, still applies, and its Results record as before.\n149:- Every write command is refused when its `--why`, `--body`, `--observation`, `--summary` or any `--limit` cites an id that is no node of the store. A cite is a token that starts at a word boundary with `G-`, `Q-`, `H-`, `E-` or `R-` and goes on with six upper-case Crockford base32 characters that end the word (a display id, §2), or with a placeholder mark: `<`, `{`, `…`, `...` or three or more `X`, as in `R-<new>`. A display id that resolves (§2) passes; a placeholder never does. Lower-case prose such as `E-mail` or `R-squared` is no cite, and a token right after `:` cites another store (`containment:R-ABC123`) and is not checked. The refusal names each flag and token, `--why names R-<new>, which is no node here`, appends nothing and exits 2, as `unknown node` does (§2). Text written before this rule, or by an older binary, replays unchanged.\n151:`hyp add exp` also warns, without refusing, when its parent or a target is not a live rival (§7.1): it writes the Experiment, exits 0 and prints one `warn: D1:` line per such Hypothesis with its status, the Results that contradict it or the Hypotheses that supersede it. It reads the same rule as the D1 signal, so the warning and D1 name the same Hypotheses.\n235:- **Constraints block.** A Goal body's constraints block runs from the first line that starts with `May change:`, `Read only:` or `Never:` to the end of the body. It is valid when it holds each of the three headings and every non-empty line in it starts with one of them. Replay stores no word for it and no status reads it. `hyp add goal` admits any body and warns when the body has a heading but no valid block. `hyp prompt G --actor A` prints the `/goal` prompt for G from G's node and the store's place in its repository: the store's path relative to the repository root, A, G, the skill hyp-goal-run, the stop clauses, and each block line as written, in body order; `--branch` and `--pr` add a clause each after the block. It refuses with exit 1 and nothing on stdout when the block is missing or not valid, naming each problem, and exits 2 with no `--actor` (it does not read `$HYP_ACTOR`), for an id that is not a Goal, or for a `--branch` that holds a space or a control character. It exits 3 when the store's directory cannot be resolved or no repository holds its real directory, so a store whose real directory is outside every repository exits 3 even when a link inside a repository reaches it. It checks the block first, so a Goal with no valid block exits 1 wherever the store is. Lines split on `\\n`, and a line is empty only when it holds no byte, so a line of spaces, a tab, or the lone `\\r` of a blank line in a CRLF body is a bad line inside the block. The store's path is read after resolving symbolic links, so a store reached through a linked directory prints the same bytes. Each block line prints as written, so a CRLF body with no blank line in its block keeps the `\\r` at the end of each block line. It reads no answer, so the same Goal and flags print the same bytes before and after an answer and in a store with other Goals.\n248:- **[added]** A matching hash says the procedure is the same, not that it gives the right answer. An **instrument** is a recipe bundle with an Evidence or Standalone command, the checks a verdict counts. A script whose output a Result's verdict counts lives in a bundle and runs as one of its commands (sandbox spec §1), never outside `recipes/`. An instrument must have known answers: cases under `known-answers/NAME/`, each an `input/` and an `expect.json` (`RECIPE-FORMAT.md`, Known answers). A frozen recipe whose cases print `verdict: LABEL=WORD` lines is a verdict check, and `hyp bundle check` warns when a label has no case printing `supports` or none printing `contradicts`, on a malformed verdict line and on a label printed twice in one case (ADR 0004); for a rubric it prints what `hyp add exp --rubric` refuses. Before every `hyp sandbox create` (for each stacked recipe, in stack order, before anything is made), `hyp bundle run` and `hyp bundle evidence`, hyp runs the instrument's known answers with the operator's hyp; a failed case refuses the run with exit 1, a timed-out case exits 3, and a refused create leaves no sandbox. `hyp add exp --recipe` refuses an instrument with no case. An Experiment under a Hypothesis declares how its verdicts are decided with its rubric, a bundle or `reading` (§5.1, next bullet). Replay never reads the declaration, and a false `--rubric reading` that hides a measure is not seen. The sandbox record and the command record both hold the outcome of each case, as `known_answers` (sandbox spec §5.1). A bundle without an Evidence or Standalone command is not gated (ADR 0002).\n249:- **[added]** Recipe and rubric 