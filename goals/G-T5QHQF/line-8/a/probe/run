#!/bin/sh
# Probe of G-T5QHQF line-8/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with a base commit holding
# greet.txt (hello) and a commit C1 (bye now, with a chart under the Goal's
# specs folder) on its own branch, with fixed dates so both shas are the same on
# every run. On main it writes by hand, as H0 wrote them, the store of Goal
# G-041ZJG: its goal.add, the place of its one example and the select of C1,
# each in its own events file, and commits them. The subject's hyp never writes
# these events. Then it runs the example's run section with the real ids mapped
# to stable tokens, then a last line "exit N". Setup output goes to stderr.
# A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

G=G-041ZJG
repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add -A && git commit -q -m base >&2 || fail "commit base"
git checkout -q -b c1 main >&2 || fail "checkout c1"
echo 'bye now' >greet.txt
mkdir -p "goals/$G/specs" || fail "mkdir specs"
printf '%s\n' 'stateDiagram-v2' '  hello --> bye' >"goals/$G/specs/chart.mmd"
git add -A && git commit -q -m c1 >&2 || fail "commit c1"
C1=$(git rev-parse HEAD)
git checkout -q main >&2 || fail "checkout main"

# The store of the Goal, written by hand in H0's form.
mkdir -p .tree/events/owner .tree/events/grill .tree/events/runner || fail "mkdir store"
printf 'events/*.jsonl merge=union\n' >.tree/.gitattributes
cat >.tree/events/owner/01M8DKSSK9S8E5V4GQ86041ZJG.json <<'EVENT'
{"v":2,"id":"01M8DKSSK9S8E5V4GQ86041ZJG","ts":"2026-11-27T04:21:45.70578Z","actor":"owner","type":"goal.add","node":"01M8DKSSK9S8E5V4GQ86041ZJG","payload":{"role":"owner","words":"Greet.","base":"18bf70ee0e575054f95174c682baae4db9c75770","base_tree":"56ef077a153a22a552fb32288831d723bbc3e26c","budget":3,"from":"","lines":[{"key":"line-1","text":"the subject says bye.","kind":"gap"}]},"why":""}
EVENT
cat >.tree/events/grill/01M8DKST212AJ8TGT1ETHQVJ38.json <<'EVENT'
{"v":2,"id":"01M8DKST212AJ8TGT1ETHQVJ38","ts":"2026-11-27T04:21:46.177847Z","actor":"grill","type":"examples.place","node":"01M8DKSSK9S8E5V4GQ86041ZJG","payload":{"role":"grill","examples":[{"line":"line-1","example":"a","hash":"6ec30b060ffc1a628b0669f26910f14f23a2ab54","h0":{"commit":"18bf70ee0e575054f95174c682baae4db9c75770","row_tree":"56ef077a153a22a552fb32288831d723bbc3e26c","probe":"3a7334686c13a115e2636e07896004970fafea34","exit":0,"verdict":"failed"}}]},"why":""}
EVENT
cat >.tree/events/runner/01M8DKT35RZP78KA9K2SJS397Y.json <<EVENT
{"v":2,"id":"01M8DKT35RZP78KA9K2SJS397Y","ts":"2026-11-27T04:21:55.512122Z","actor":"runner","type":"select","node":"01M8DKSSK9S8E5V4GQ86041ZJG","payload":{"role":"runner","commit":"$C1","row_tree":"6966368ecac174be1adfa5404b05294ea24dd88a"},"why":"check"}
EVENT
commit_staged "store of $G" || fail "commit store"
export HYP_ACTOR=owner HYP_ROLE=owner

sh -c "$HYP_RUN" >"$work/out" 2>"$work/err"
code=$?
map() { sed -e "s/$G/G-ONE/g" -e 's/g-041zjg/g-one/g' -e "s/$C1/C1/g" \
  -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
  -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"; }
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
