+func TestDossierAudit(t *testing.T) {
+	b := testutil.New()
+	g := b.Goal("g")
+	q := b.DQ(g, "q")
+	h := b.Hyp(q, "h")
+	r := b.Result(b.Exp(h, event.RecipeNone), map[string]string{h: event.VerdictSupports})
+	b.Select(q, h, "", false)
+	b.As("v").Audit(r, h, event.AuditWrong)
+	b.Audit(r, h, event.AuditHolds)
+	b.As("w").Audit(r, h, event.AuditUnclear)
+	out := Show(replay.Replay(b.Evs, nil, ""), q, nil)
+	for _, line := range []string{"      evidence: " + testutil.EvidencePointer + "\n", "      audited: v holds\n", "      audited: w unclear\n"} {
+		if strings.Count(out, line) != 1 {
+			t.Errorf("want one %q in:\n%s", line, out)
+		}
+	}
+	if strings.Contains(out, "audited: v wrong") {
+		t.Errorf("an earlier audit of the same actor printed:\n%s", out)
+	}
+}
