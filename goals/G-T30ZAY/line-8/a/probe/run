#!/bin/sh
# Probe of G-T30ZAY line-8/a. The working directory is a copy of the subject.
# Builds hyp from the subject, makes a test store with one Goal and one finding
# folded into it, runs the run section with stand-in ids replaced by real ids,
# prints stdout, then stderr (real ids mapped back to stand-ins), then "exit N".
# Setup output goes to stderr. A finding step that fails is an outcome: its
# output and exit code are printed and the Probe exits 0.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"

maps=""

add_goal() {
  added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
    --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
  printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1
}

# setup_failed CODE OUTPUT: a failed finding step is the outcome.
setup_failed() {
  printf '%s\n' "$2" | sed "$maps"
  echo "exit $1"
  exit 0
}

# record_and_fold FACT EVIDENCE GOAL: sets FID to the new finding id.
record_and_fold() {
  o=$(hyp finding add --fact "$1" --evidence "$2" 2>&1)
  c=$?
  [ "$c" -eq 0 ] || setup_failed "$c" "$o"
  FID=$(printf '%s\n' "$o" | sed -n 's/.*recorded \(F-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$FID" ] || fail "no finding id in: $o"
  commit_staged "finding" || fail "commit finding"
  o=$(hyp finding fold "$FID" --goal "$3" 2>&1)
  c=$?
  [ "$c" -eq 0 ] || setup_failed "$c" "$o"
  commit_staged "fold" || fail "commit fold"
}

G1=$(add_goal); [ -n "$G1" ] || fail "no Goal id"
commit_staged goal1 || fail "commit goal1"
maps="s/$G1/G-ONE/g"

export HYP_ACTOR=agent
unset HYP_ROLE

record_and_fold "fact one" "evidence one" "$G1"
F1=$FID
maps="$maps;s/$F1/F-ONE/g"

run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G1/g" -e "s/F-ONE/$F1/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
sed "$maps" "$work/out"
sed "$maps" "$work/err"
echo "exit $code"
exit 0
