-run states how a review is recorded (which Experiment, under which actor) and whether it counts against the stop clause's Results. An eval case gives a consumer only the skill text, and its answers to both questions match the selected rule.\" \\\n  --line \"[P] go test ./..., go vet ./... and skillcheck pass on the candidate. The cases of G-ZBM2RE lines 1 to 5 and 7 pass, except the default number of Results in the stop clause where the selected rule changes it; the test and golden change with it.\" \\\n  --cite 6=G-ZBM2RE#1 --cite 6=G-ZBM2RE#2 --cite 6=G-ZBM2RE#3 --cite 6=G-ZBM2RE#4 --cite 6=G-ZBM2RE#5 --cite 6=G-ZBM2RE#7 \\\n  --why \"Owner-approved lines for issue #141, part of #113: a budget-bound run ends reviewed or named, and a review does not loop.\" 2>&1 | tail -15; echo \"exit ${PIPESTATUS[0]}\"","description":"Add the Goal as owner-standin with trimmed body"},"caller":{"type":"direct"}}],"container":null,"stop_reason":"tool_use","stop_sequence":null,"stop_details":null,"usage":{"input_tokens":2,"cache_creation_input_tokens":1662,"cache_read_input_tokens":120496,"output_tokens":1137,"output_tokens_details":{"thinking_tokens":0},"server_tool_use":{"web_search_requests":0,"web_fetch_requests":0},"service_tier":"standard","cache_creation":{"ephemeral_1h_input_tokens":1662,"ephemeral_5m_input_tokens":0},"inference_geo":"global","iterations":[{"input_tokens":2,"output_tokens":1137,"cache_read_input_tokens":120496,"cache_creation_input_tokens":1662,"cache_creation":{"ephemeral_5m_input_tokens":0,"ephemeral_1h_input_tokens":1662},"type":"message"}],"speed":"standard","fallback_credit":null},"input_transformations":[],"diagnostics":null,"context_management":null},"toolInputStreamMs":5729,"wireToolInputs":{"toolu_013LmToGWQyBQNAWGmazaQpv":{"command":"cd /Users/datguy/.hyp-sandbox/g146-base-b-3/wt/investigations/goal-prompt && export HYP_ACTOR=owner-standin && BODY=\"$(cat \"$TMPDIR/scratch-goal/body6.txt\")\" && hyp add goal \\\n  --title \"A budget-bound run ends