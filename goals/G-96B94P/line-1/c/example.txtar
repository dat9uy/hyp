-- words --
1c sections: an item of section 3 is drawn under "Where it breaks", which comes after "The event".
-- input/page.json --
{"id": "demo", "title": "Demo page",
 "items": [
  {"id": "demo-I1", "tag": "Proposed", "date": "2026-11-28", "section": 1,
   "text": "A runner who branches from main meets the refusal.", "findings": ["F-1NG9VB"]},
  {"id": "demo-I2", "tag": "Hypothetical", "date": "2026-11-28", "section": 3,
   "text": "Two Goals rest on one premise."},
  {"id": "demo-I3", "tag": "Owner said", "date": "2026-11-28", "section": 3,
   "text": "Keep the words of the owner."}
 ]}
-- run --
python3 skills/hyp-grill/scripts/draw_issue.py "$HYP_EXAMPLE/input/page.json" | awk '/The event/ && !e {e=NR} /Where it breaks/ && !b {b=NR} /demo-I2/ && !t {t=NR} END {if (e && b && t && e < b && b < t) print "demo-I2 under Where it breaks, after The event"; else print "order wrong"}'
-- floor: contains --
demo-I2 under Where it breaks, after The event
-- ceiling --
order wrong
