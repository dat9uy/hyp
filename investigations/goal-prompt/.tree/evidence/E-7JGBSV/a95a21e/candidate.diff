+{"type":"session-owner","accountUuid":"61c0dc2c-da2f-41ad-8a06-4c79a78f1d15","organizationUuid":"a1adefea-aeae-4878-8b40-371d459fc3e4","sessionId":"e3ce0dbb-c168-4a49-9caf-ecc01cb40fbf"}
+{"type":"queue-operation","operation":"enqueue","timestamp":"2026-11-12T14:19:19.703Z","sessionId":"e3ce0dbb-c168-4a49-9caf-ecc01cb40fbf","content":"/hyp-owner-grill #113 (the text of issue #113 as of this session is in /Users/datguy/.hyp-sandbox/g146-base-a-2/tmp/issue-113.md; this machine has no network, so gh cannot fetch it)\n"}
