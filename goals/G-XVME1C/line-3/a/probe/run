#!/bin/sh
# Probe of G-XVME1C line-3/a. The working directory is a copy of the subject.
# It writes a kept model goals/model/ (one rule Holds, one variant Breaks) and a
# fixture Goal goals/G-ONE with one example and an empty specs/ folder, runs the
# example's run section, prints its stdout, then a last line "exit N".
# A setup failure goes to stderr and exits 3.

fail() { echo "probe: $*" >&2; exit 3; }

m=goals/model
g=goals/G-ONE
mkdir -p "$m" "$g/specs" "$g/line-1/a/probe" || fail "mkdir"

cat >"$m/model.tla" <<'TLA' || fail "write model.tla"
-------------------------------- MODULE model --------------------------------
EXTENDS Integers

CONSTANTS Breaks

VARIABLES st, out

vars == <<st, out>>

Init == st = "none" /\ out = [cmd |-> "none", text |-> "none"]

\* command: toy add
Add ==
    /\ st = "none" /\ st' = "free"
    /\ out' = [cmd |-> "add", text |-> "added"]

\* command: toy list
List ==
    /\ st' = st
    /\ out' = [cmd |-> "list",
               text |-> IF st = "none" THEN "none"
                        ELSE IF Breaks THEN "empty" ELSE "free"]

Next == Add \/ List

Spec == Init /\ [][Next]_vars

\* source: model only
Holds == (out.cmd = "list" /\ st = "free") => out.text = "free"
=============================================================================
TLA

cat >"$m/model.cfg" <<'CFG' || fail "write model.cfg"
SPECIFICATION Spec

CONSTANTS
    Breaks = FALSE

INVARIANTS
    Holds
CFG

cat >"$m/model-view.mjs" <<'MJS' || fail "write model-view.mjs"
// The view of model.tla: what the toy command prints for each step.

export const title = "toy, kept model";

export const state = (v) => v.st;

export const print = (action, from, to) => {
  const o = to.out;
  switch (o.cmd) {
    case "add": return "added";
    case "list":
      if (o.text === "none") return "nothing";
      if (o.text === "free") return "listed";
      return "";
  }
  return "";
};
MJS

cat >"$g/line-1/a/example.txtar" <<'TXT' || fail "write example"
-- words --
The toy lists what it added.
-- run --
toy list
-- floor: contains --
listed
TXT

cat >"$g/line-1/a/probe/run" <<'RUN' || fail "write fixture probe"
#!/bin/sh
toy add
sh -c "$HYP_RUN"
RUN

tmp=$(mktemp) || exit 3
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
