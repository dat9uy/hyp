#!/bin/sh
# Probe of G-FZ9E1G line-1/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with a kept model whose
# actions Add and List carry the command comments toy add and toy list, adds
# a Goal of one gap line with one placed example that runs "toy list",
# then sets up a finding as the case needs, runs the example's run section
# with G-ONE replaced by the real Goal id, prints its stdout with the real
# ids replaced by stable tokens, then a last line "exit N". Setup output goes
# to stderr. A setup failure exits 3.

FIXCMD='toy list'
SETUP=none
MODE=none

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT
exec 3>&2 2>"$work/setup.err"

fail() { echo "probe: $*" >&3; cat "$work/setup.err" >&3; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
mkdir -p goals/model || fail "mkdir model"
printf '%s\n' '---- MODULE model ----' 'VARIABLE st' 'Init == st = 0' \
  '\* command: toy add' 'Add == st'"'"' = st' \
  '\* command: toy list' 'List == st'"'"' = st' \
  'Next == Add \/ List' 'Spec == Init /\ [][Next]_st' \
  '\* source: model only' 'Ok == TRUE' '====' >goals/model/model.tla || fail "model.tla"
printf '%s\n' 'SPECIFICATION Spec' 'INVARIANTS Ok' >goals/model/model.cfg || fail "model.cfg"
git add -A && git commit -q -m base >&2 || fail "commit base"

# The owner adds the Goal.
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit_staged "goal $G" || fail "commit goal"

# The grill places one example. Its Probe puts a toy stub that echoes its
# arguments on PATH, calls toy add first when the case needs setup, then runs
# the run section. The base fails its floor.
d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
cat >"$d/example.txtar" <<EXAMPLE
-- words --
The subject says bye.
-- run --
$FIXCMD
-- floor: contains --
bye
EXAMPLE
{
  printf '%s\n' '#!/bin/sh' 'stub=$(mktemp -d) || exit 1' \
    'printf '"'"'#!/bin/sh\necho "toy $*"\n'"'"' >"$stub/toy"' \
    'chmod +x "$stub/toy"' 'PATH="$stub:$PATH"'
  [ "$SETUP" = add ] && printf '%s\n' 'toy add >/dev/null'
  printf '%s\n' 'tmp=$(mktemp) || exit 1' 'sh -c "$HYP_RUN" >"$tmp"' 'code=$?' \
    'cat "$tmp"' 'if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi' \
    'echo "exit $code"' 'rm -rf "$tmp" "$stub"'
} >"$d/probe/run"
chmod +x "$d/probe/run"
commit_staged "example of $G" || fail "commit example"
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
commit_staged placed || fail "commit placed"

export HYP_ACTOR=owner HYP_ROLE=owner
# The finding the case needs, recorded before the run section. On H0 the
# example flags are unknown and the act exits 2; that is the build's feature.
case "$MODE" in
  example) hyp finding add --fact 'nothing shows' --evidence 'seen in a run' \
    --example "$G/line-1/a" --commit HEAD >&2 || true ;;
  free) hyp finding add --fact 'nothing shows' --evidence 'seen in a run' >&2 || true ;;
esac

run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
norm() { sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" -e 's/F-[A-Z0-9]\{6\}/F-XXXXXX/g' \
  -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"; }
norm "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
norm "$work/err" >&3
echo "exit $code"
exit 0
