-- words --
One file holding all five defects gives exit 1 and prints all five codes.
-- input/page.json --
{
 "id": "demo",
 "items": [
  {
   "tag": "Proposed",
   "date": "2026-11-28",
   "text": "Store items as data."
  },
  {
   "id": "demo-I1",
   "tag": "Proposed",
   "date": "2026-11-28",
   "text": "Store items as data."
  },
  {
