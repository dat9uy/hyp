-- words --
Each run keeps only its own steps: Goal G-ONE has two examples on line-1; line-1/a's Probe runs one hyp add goal, line-1/b's Probe runs hyp add goal and then hyp finding add in its own repository. After hyp run of line-1 on C1, the trace holds two step logs, one with one line and one with two lines.
-- run --
HYP_ACTOR=runner-one HYP_ROLE=runner hyp run C1 G-ONE/line-1 >/dev/null 2>&1; L=$(grep -rl "^step " "$HOME/.hyp/traces" 2>/dev/null); echo "step logs: $(echo "$L" | grep -c .)"; O=0; T=0; for f in $L; do n=$(grep -c "^step " "$f"); [ "$n" = 1 ] && O=$((O+1)); [ "$n" = 2 ] && T=$((T+1)); done; echo "one-line logs: $O"; echo "two-line logs: $T"
-- floor: contains --
step logs: 2
-- floor: contains --
one-line logs: 1
-- floor: contains --
two-line logs: 1
-- ceiling --
step logs: 0
-- findings --
F-DFY9ND
