-- words --
Branches only feed the warning: Goal G-ONE is selected on C2, built on C1; hyp status is printed; then C2's branch is deleted, its commit kept. hyp status prints the same rows, leaves and stop, and adds only the warning that the selected commit is on no branch or tag.
-- run --
T=$(mktemp -d); hyp status G-ONE >"$T/before" 2>&1; git branch -D c2 >/dev/null 2>&1; hyp status G-ONE >"$T/after" 2>&1; grep -v 'is on no branch or tag' "$T/after" >"$T/rest"; if cmp -s "$T/before" "$T/rest"; then echo "status: same"; else echo "status: changed"; fi; echo "warning lines: $(grep -c 'is on no branch or tag' "$T/after")"
-- floor: contains --
status: same
-- floor: contains --
warning lines: 1
-- ceiling --
status: changed
