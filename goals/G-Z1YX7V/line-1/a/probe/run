#!/bin/sh
# Probe of #444 goal F. The working directory is a copy of the subject. It builds hyp from the subject and
# makes a test repo with a subject file counter that holds bad, committed. It writes by hand, outside hyp,
# draft x into the clone's trace: one example line-1/a with the words, run cat counter and floor ok.
# HYP_RUN is the run section. It prints the stdout, then the stderr, with ids mapped to tokens, then a last
# line "exit N". Setup output goes to stderr of the Probe. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'chmod -R u+w "$work" 2>/dev/null; rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'bad\n' >counter
git add -A && git commit -q -m base >&2 || fail "commit base"

clone=$(git rev-parse --path-format=absolute --git-common-dir) || fail "git common dir"
clone=$(cd "$clone" && pwd -P) || fail "git common dir path"
hash=$(printf '%s' "$clone" | shasum -a 256 | cut -d' ' -f1)
[ -n "$hash" ] || fail "no hash"
trace="$HOME/.hyp/traces/$hash"
ex="$trace/drafts/x/line-1/a"
mkdir -p "$ex/probe" || fail "mkdir draft"
printf '%s\n' "$clone" >"$trace/clone" || fail "trace clone file"
printf '%s\n' '-- words --' 'The counter says ok.' '-- run --' 'cat counter' \
  '-- floor: contains --' 'ok' >"$ex/example.txtar" || fail "draft example"
cp "$work/generic-run" "$ex/probe/run" && chmod +x "$ex/probe/run" || fail "draft probe"

# goals/ exists and is read-only, so the add cannot write goals/<G>/; .tree and the trace stay writable
mkdir goals && chmod a-w goals || fail "chmod goals"

sh -c "$HYP_RUN" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s#$work#WORK#g" -e "s/$hash/HASH/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/G-[0-9A-Z]\{6\}/GOAL/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err"
echo "exit $code"
exit 0
