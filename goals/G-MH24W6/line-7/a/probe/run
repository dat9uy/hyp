#!/bin/sh
# Probe of G-MH24W6 line-7/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a Goal and closes it, appends by hand
# a second close of that Goal (an end freezes it), commits, then runs
# hyp status as the owner and prints its stdout, then a last line "exit N".
# Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"

export HYP_ACTOR=owner HYP_ROLE=owner
added=$(hyp add goal --base HEAD --words 'Greet.' --line 'gap:the subject says bye.') \
  || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
git add -A && git commit -q -m goal >&2 || fail "commit goal"
hyp close "$G" >&2 || fail "hyp close"
git add -A && git commit -q -m close >&2 || fail "commit close"

# A second close, by hand, with a later id: the end froze the Goal.
f=.tree/events/owner.jsonl
last=$(grep '"type":"close"' "$f" | tail -n 1)
id=$(printf '%s\n' "$last" | sed -n 's/.*"id":"\([0-9A-Z]*\)".*/\1/p')
newid=$(printf '%s' "$id" | sed 's/..$/ZZ/')
printf '%s\n' "$last" | sed "s/$id/$newid/" >>"$f" || fail "append"
git add -A && git commit -q -m 'second close' >&2 || fail "commit second close"

out="$work/out"
hyp status >"$out"
code=$?
sed -e "s/$G/G/g" "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
echo "exit $code"
exit 0
