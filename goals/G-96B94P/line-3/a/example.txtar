-- words --
2a no holder: a row with an empty holder gives holder-missing for that item and exits 1.
-- input/body.md --
| Item | Tag | Holder |
|---|---|---|
| demo-I1 | Open | owner: "yes" |
| demo-I2 | Fact |  |
-- run --
python3 skills/hyp-grill/scripts/check_holders.py "$HYP_EXAMPLE/input/body.md"
echo "exit code: $?"
-- floor: contains --
holder-missing demo-I2
-- floor: contains --
exit code: 1
-- ceiling --
holder-missing demo-I1
