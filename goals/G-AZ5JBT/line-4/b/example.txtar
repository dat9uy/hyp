-- words --
With three approaches, the drawn page has three diagrams, and each one shows every party's label.
-- input/page.json --
{
 "id": "demo",
 "items": [
  {
   "id": "demo-I1",
   "tag": "Owner said",
   "date": "2026-11-27",
   "text": "Keep the words of the owner."
  },
  {
   "id": "demo-I2",
   "tag": "Proposed",
   "date": "2026-11-28",
   "text": "Store items as data."
  }
 ],
 "parties": [
  {
   "id": "owner",
   "label": "Owner"
  },
  {
   "id": "agent",
   "label": "Agent"
  },
  {
   "id": "tool",
   "label": "Tool"
  }
 ],
 "approaches": [
  {
   "name": "A",
   "concept_at": "owner",
   "steps": [
    "The owner writes the item."
   ]
  },
  {
   "name": "B",
   "concept_at": "agent",
   "steps": [
    "The agent writes the item."
   ]
  },
  {
   "name": "C",
   "concept_at": "tool",
   "steps": [
    "The tool writes the item."
   ]
  }
 ]
}
-- input/count.py --
import re,sys
s=open(sys.argv[1],encoding='utf-8').read()
g=re.findall(r'<svg\b.*?</svg>',s,flags=re.S)
print('at least 3 diagrams:', 'yes' if len(g)>=3 else 'no')
print('every diagram shows Owner, Agent and Tool:', 'yes' if g and all(all(l in x for l in ('Owner','Agent','Tool')) for x in g) else 'no')
-- run --
test -f skills/hyp-rethinking/scripts/draw_page.py && echo 'draw_page.py ships'
d=$(mktemp -d) && python3 skills/hyp-rethinking/scripts/draw_page.py "$HYP_EXAMPLE/input/page.json" "$d/page.html" && python3 "$HYP_EXAMPLE/input/count.py" "$d/page.html"
-- floor: contains --
draw_page.py ships
-- floor: contains --
at least 3 diagrams: yes
-- floor: contains --
every diagram shows Owner, Agent and Tool: yes
