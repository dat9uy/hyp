+package cli
+
+import (
+	"os"
+	"path/filepath"
+	"strings"
+	"testing"
+)
+
+const auditText = "first line of the file\nthe run   added\n\tappendonly no to its command line\nlast line\n"
+const auditQuote = "the run added appendonly no to its command line"
+
+// auditSetup records a Result on h as the default actor, with a file and a URL
+// as evidence, and selects h. It returns the ids and the file's pointer.
+func auditSetup(t *testing.T) (q, h, r, ptr string) {
+	t.Helper()
+	dir, _, q := setup(t)
+	h = must(t, "add", "hyp", "--parent", q, "--title", "H", "--why", "w")
+	e := must(t, "add", "exp", "--parent", h, "--title", "E", "--recipe", "none", "--decided-by", "reading", "--target", "none", "--why", "w")
+	folder := filepath.Join(dir, ".tree", "evidence", e)
+	if err := os.MkdirAll(folder, 0o755); err != nil {
+		t.Fatal(err)
+	}
+	if err := os.WriteFile(filepath.Join(folder, "run.log"), []byte(auditText), 0o644); err != nil {
+		t.Fatal(err)
+	}
+	ptr = ".tree/evidence/" + e + "/run.log"
+	r = must(t, "record", "--exp", e, "--verdict", h+"=supports", "--observation", "o", "--evidence", ptr, "--evidence", "https://example.com/x", "--why", "w")
+	must(t, "select", q, h, "--why", "w")
+	return q, h, r, ptr
+}
+
+func TestAuditCommand(t *testing.T) {
+	q, h, r, ptr := auditSetup(t)
+	v := func(word string, more ...string) []string {
+		return append([]string{"audit", r, "--hypothesis", h, "--verdict", word, "--actor", "ver", "--why", "w"}, more...)
+	}
+	want(t, hyp(t, "audit", r, "--verdict", "holds", "--actor", "ver", "--why", "w"), 2, "--hypothesis")
+	want(t, hyp(t, "audit", r, "--hypothesis", h, "--actor", "ver", "--why", "w"), 2, "--verdict")
+	want(t, hyp(t, v("holds")...), 2, "--quote")
+	want(t, hyp(t, v("holds", "--quote", "too short", "--pointer", ptr)...), 2, "runes")
+	want(t, hyp(t, v("holds", "--quote", strings.Repeat("x", 301), "--pointer", ptr)...), 2, "runes")
+	want(t, hyp(t, v("holds", "--quote", "this text is in no file at all", "--pointer", ptr)...), 1, "quote not in")
+	want(t, hyp(t, v("wrong", "--quote", auditQuote, "--pointer", "https://example.com/x")...), 1, "only --verdict unclear")
+	want(t, hyp(t, v("holds", "--quote", auditQuote, "--pointer", ".tree/evidence/other.log")...), 1, "is no evidence of")
+	want(t, hyp(t, v("maybe")...), 1, "unknown verdict")
+	want(t, hyp(t, v("holds", "--quote", auditQuote, "--pointer", "./"+ptr)...), 0, "result.audit")
+	want(t, hyp(t, v("unclear", "--pointer", "https://example.com/x")...), 0, "result.audit")
+	want(t, hyp(t, "show", q), 0, "audited: ver unclear")
+	// The recorder may not audit its own Result.
+	want(t, hyp(t, "audit", r, "--hypothesis", h, "--verdict", "unclear", "--why", "w"), 1, "separation of duties")
+}
+
+func TestAuditCommandMissingFile(t *testing.T) {
+	_, h, r, ptr := auditSetup(t)
+	cwd, _ := os.Getwd()
+	if err := os.Remove(filepath.Join(cwd, filepath.FromSlash(ptr))); err != nil {
+		t.Fatal(err)
+	}
+	want(t, hyp(t, "audit", r, "--hypothesis", h, "--verdict", "holds", "--quote", auditQuote, "--pointer", ptr, "--actor", "ver", "--why", "w"), 3, "cannot be read")
+}
+
+func TestAuditConfirm(t *testing.T) {
+	q, h, r, ptr := auditSetup(t)
+	confirm := []string{"confirm", q, "--role", "verifier", "--verdict", "sufficient", "--actor", "ver", "--why", "w"}
+	want(t, hyp(t, confirm...), 1, "not audited by ver:\n  "+r+" on "+h)
+	audit := []string{"audit", r, "--hypothesis", h, "--pointer", ptr, "--quote", auditQuote, "--actor", "ver", "--why", "w"}
+	must(t, append(audit, "--verdict", "wrong")...)
+	want(t, hyp(t, confirm...), 1, "wrong:\n  "+r+" on "+h)
+	must(t, append(audit, "--verdict", "holds")...)
+	want(t, hyp(t, confirm...), 0, "confirm")
+	want(t, hyp(t, "show", q), 0, "status: answered")
+	// An insufficient needs no audits.
+	want(t, hyp(t, "confirm", q, "--role", "verifier", "--verdict", "insufficient", "--actor", "other", "--why", "w"), 0, "confirm")
+}
