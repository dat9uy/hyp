---
title: "hyp G-CJWT9T: hyp try shows a verdict before place or run records it"
---
stateDiagram-v2
  direction LR
  state "Legend" as legend {
    lg0: tried
    lg1: untried
  }
  class lg0 teal
  class lg1 tan
  state "At the same time" as all {
    state "Example" as r0 {
      s0: Not written
      s1: On disk only
      s2: Committed
      s3: Placed
      [*] --> s0
      s0 --> s1: the grill writes the example folder
      s1 --> s2: the grill commits it
      s2 --> s3: hyp place records H0's cell
    }
    --
    state "Checkout" as r1 {
      s4: As H0
      s5: Change not committed
      s6: Change committed
      [*] --> s4
      s4 --> s5: an agent adds a new file or an agent edits a tracked file
      s5 --> s6: the agent commits the change
      s6 --> s5: an agent edits a tracked file or an agent adds a new file
    }
    --
    state "Try" as r2 {
      s7: Nothing shown
      s8: Shown on H0
      s9: Shown on the checkout
      s10: Shown on H0 and on the checkout
      [*] --> s7
      s7 --> s8: hyp try G LINE/EXAMPLE [when Example is not Not written]
      s7 --> s9: hyp try G LINE/EXAMPLE --worktree [when Example is not Not written]
      s8 --> s10: hyp try G LINE/EXAMPLE --worktree
      s9 --> s10: hyp try G LINE/EXAMPLE
    }
    --
    state "Log" as r3 {
      s11: Nothing recorded
      s12: H0's cell recorded
      s13: A run recorded
      [*] --> s11
      s11 --> s12: hyp place records H0's cell [when Example is Committed]
      s12 --> s13: hyp run records a Result [when Checkout is not As H0]
    }
  }
  class s0 tan
  class s7 tan
  class s8 teal
  class s9 teal
  class s10 teal
