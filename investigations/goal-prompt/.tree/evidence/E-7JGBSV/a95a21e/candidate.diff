+	}
+	name := args[0]
+	if a, ok := aliases[name]; ok {
+		name = a
+	}
+	cmd, ok := commands[name]
+	if !ok {
+		fmt.Fprint(stderr, usage)
+		return 2
+	}
+	err := cmd(args[1:], stdout, stderr)
+	if err == nil {
+		return 0
+	}
+	if h, ok := errors.AsType[helpText](err); ok {
+		fmt.Fprintln(stdout, string(h))
