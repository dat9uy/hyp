#!/bin/sh
# Probe of G-MH24W6 line-1/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a store with one open Goal and one
# landed Goal, then runs hyp status as the owner and prints its stdout with the ids, times and hashes replaced, then a
# last line "exit N". Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
# Keep the store out of commits, so a checkout never meets it.
printf '.tree/\n' >"$(git rev-parse --absolute-git-dir)/info/exclude"
echo bad >counter
git add counter && git commit -q -m base >&2 || fail "commit base"
base=$(git rev-parse HEAD)

as() { role=$1; shift; HYP_ACTOR="$role-1" HYP_ROLE="$role" "$@"; }

# mkgoal WORDS: add a Goal with one example that fails on H0 until counter
# reads ok, commit it and place it as the grill. It sets L to the Goal id.
mkgoal() {
  added=$(as owner hyp add goal --base HEAD --words "$1" \
    --line 'gap:the counter is bad.') || fail "add goal: $added"
  L=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$L" ] || fail "no Goal id in: $added"
  ex="goals/$L/line-1/a"
  mkdir -p "$ex/probe" || fail "mkdir example"
  printf -- '-- words --\nw\n-- run --\ncat counter\n-- floor: contains --\nok\n' >"$ex/example.txtar"
  cat >"$ex/probe/run" <<'PROBE'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
PROBE
  chmod +x "$ex/probe/run"
  git add -A && git commit -q -m examples >&2 || fail "commit examples"
  as grill hyp place "$L" >&2 || fail "place"
}

# The landed Goal.
mkgoal 'Landed.'
git checkout -q --detach "$base" || fail "checkout base"
mkdir -p "goals/$L/specs"
echo ok >counter
echo spec >"goals/$L/specs/spec.md"
git add -A && git commit -q -m fix >&2 || fail "commit fix"
fix=$(git rev-parse HEAD)
git checkout -q main || fail "checkout main"
ran=$(as runner hyp run "$fix" "$L/line-1") || fail "run: $ran"
row=$(printf '%s\n' "$ran" | sed -n 's/^row: //p' | head -n 1)
[ -n "$row" ] || fail "no row in: $ran"
as runner hyp select "$L" "$row" >&2 || fail "select"
as owner hyp land "$L" >&2 || fail "land"

# The open Goal.
mkgoal 'Open.'

out="$work/out"
as owner hyp status >"$out"
code=$?
sed -E -e 's/G-[A-Z0-9]{6}/G/g' -e 's/[0-9A-HJKMNP-TV-Z]{26}/ID/g' \
  -e 's/[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9:.]+Z/TIME/g' -e 's/[0-9a-f]{40}/HASH/g' "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
echo "exit $code"
exit 0
