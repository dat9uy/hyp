-- words --
Record PR and runner PR: from a base whose store holds Goal Y, branch main adds Goal X (as a record PR does) and branch side closes Goal Y (as a runner PR carries the owner's land), both by the owner. A plain git merge, with no merge driver, exits 0; hyp status shows X written and Y ended.
-- run --
printf '* merge=text\n' > .git/info/attributes; git merge --no-edit side >/dev/null 2>&1; echo "merge exit: $?"; echo "written: $(hyp status --all 2>/dev/null | grep -c written)"; echo "ended: $(hyp status --all 2>/dev/null | grep -c ended)"
-- floor: contains --
merge exit: 0
-- floor: contains --
written: 1
-- floor: contains --
ended: 1
