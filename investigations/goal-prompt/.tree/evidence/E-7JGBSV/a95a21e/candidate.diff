+{"type":"session-owner","accountUuid":"61c0dc2c-da2f-41ad-8a06-4c79a78f1d15","organizationUuid":"a1adefea-aeae-4878-8b40-371d459fc3e4","sessionId":"1fd7e156-53e8-43a6-92ae-cc9f5bba5a3f"}
