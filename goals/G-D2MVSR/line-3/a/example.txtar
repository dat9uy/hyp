-- words --
An open Goal on greet.sh with three placed examples and a model with two variants, Loud (prints BYE, fails all three) and Shy (prints bye hello, meets the contains-bye example and fails the other two), each written as a patch, tried 3 times, one after another, on Sonnet with the subject's hyp-grill and hyp-statechart skills: in every try the grill tries each variant on one example only, and that try fails, because it stops trying a variant at its first failed example.
-- input/lib.sh --
# Shared helpers for the examples of Goal G-D2MVSR. Each example holds its own
# copy as input/lib.sh, with grill.py and its scenario files. The run section
# sources it from the example folder. It builds hyp from the subject, copies
# the subject's skills, and runs each try in its own repository.
bin=$(mktemp -d) && go build -o "$bin/hyp" ./cmd/hyp || exit 90
sk=$(mktemp -d) && cp -R skills/. "$sk/" || exit 91
export PATH="$bin:$PATH"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
out=$(mktemp -d) || exit 91
export HYP_ACTOR=grill HYP_ROLE=grill
in="$HYP_EXAMPLE/input"
save() { git add -A && git commit -q -m "$1"; }
# addgoal WORDS LINE1 LINE2: the owner adds a Goal with two lines on HEAD; sets g.
addgoal() { g=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words "$1" --line "$2" --line "$3" 2>/dev/null | sed -n 's/^recorded //p') && [ -n "$g" ] && save "record $g"; }
# grill N SKILL...: run try N of the grill in the current repository, with
# the prompt in $in/prompt.txt (G and the skill folder filled in) and the
# owner in $in/owner.json; the transcript goes to $out/t.N.
grill() { n=$1; shift; sed -e "s#@G@#$g#g" -e "s#@SK@#$sk#g" "$in/prompt.txt" >"$out/p.$n" && python3 "$in/grill.py" "$PWD" "$out/p.$n" "$in/owner.json" "$@" >"$out/t.$n" 2>"$out/e.$n"; }
# tries FN: run FN 1, FN 2 and FN 3 in parallel, each in a new directory, then
# print each try's checks, prefixed with "try N: ".
tries() { for n in 1 2 3; do ( r=$(mktemp -d) && cd "$r" && "$1" "$n" >"$out/c.$n" 2>&1 ) & done; wait; for n in 1 2 3; do sed "s/^/try $n: /" "$out/c.$n"; done; }
# serial FN: like tries, but runs FN 1, FN 2 and FN 3 one after another, for a
# try whose grill may use fixed paths outside its repository.
serial() { for n in 1 2 3; do ( r=$(mktemp -d) && cd "$r" && "$1" "$n" >"$out/c.$n" 2>&1 ); done; for n in 1 2 3; do sed "s/^/try $n: /" "$out/c.$n"; done; }
-- input/grill.py --
#!/usr/bin/env python3
# Run one grill session on Sonnet against a scripted owner, and write its
# transcript as JSON lines: {"who": "grill"|"owner"|"tool", ...}; a tool
# call made inside an agent the grill started has "agent": true.
#
# grill.py DIR PROMPT_FILE OWNER_FILE SKILL_FILE... > transcript.jsonl
#
# The grill works in DIR. Its instructions are the SKILL_FILEs, passed as its
# system prompt; no installed skill, user setting or hook loads. After each
# grill turn, the scripted owner answers from OWNER_FILE, a JSON list of rules
# {"if": [regex...], "about": regex (optional), "say": text}. The owner answers
# only a message that asks a question (holds "?"); a message that asks none
# ends the session. The owner reads the message one line at a time. A rule
# fires on a line that every "if" matches (case-insensitive). Of the rules
# that share an "if", the one fires whose "about" matches last in that line
# or, when none does, last before it in the message. A rule with "once": true
# fires at most once in the session; a rule with "after": text fires only once
# the owner has said that text. With no rule firing, the owner says the
# default text. At most 12 turns.
import json, re, subprocess, sys

d, prompt_file, owner_file, *skills = sys.argv[1:]
rules = json.load(open(owner_file))
default = "Use your proposal."
sysfile = d + "/.grill-system.md"
with open(sysfile, "w") as f:
    for s in skills:
        f.write(open(s).read() + "\n\n")
base = ["claude", "-p", "--model", "sonnet", "--output-format", "stream-json", "--verbose",
        "--setting-sources", "project", "--disable-slash-commands",
        "--append-system-prompt-file", sysfile,
        "--allowedTools", "Bash", "Read", "Write", "Edit", "Glob", "Grep", "Agent",
        "--disallowedTools", "AskUserQuestion", "Skill", "WebFetch", "WebSearch", "Bash(gh:*)", "Bash(git push:*)"]
out = sys.stdout
def emit(o): out.write(json.dumps(o) + "\n"); out.flush()

def turn(msg, sid):
    cmd = base + (["--resume", sid] if sid else []) + ["--", msg]
    p = subprocess.run(cmd, cwd=d, capture_output=True, text=True, timeout=480)
    text, new_sid = "", sid
    for line in p.stdout.splitlines():
        try: e = json.loads(line)
        except ValueError: continue
        if e.get("session_id"): new_sid = e["session_id"]
        if e.get("type") == "assistant":
            for c in e["message"].get("content", []):
                if c.get("type") == "tool_use":
                    emit({"who": "tool", "name": c.get("name"), "input": c.get("input"),
                          "agent": bool(e.get("parent_tool_use_id"))})
        if e.get("type") == "result":
            text = e.get("result") or ""
    return text, new_sid

said, used = [], set()
def answer(msg):
    if "?" not in msg: return None
    fired, upto = [], ""
    for para in msg.split("\n"):
        upto += para + "\n"
        groups = {}
        for i, r in enumerate(rules):
            if r.get("once") and i in used: continue
            if "after" in r and not any(r["after"] in s for s in said): continue
            if all(re.search(x, para, re.I) for x in r["if"]):
                groups.setdefault(json.dumps(r["if"]), []).append(r)
        for rs in groups.values():
            best = None
            for scope in (para, upto):
                pos = -1
                for r in rs:
                    if "about" not in r: best = best or r; continue
                    ms = [m.start() for m in re.finditer(r["about"], scope, re.I)]
                    if ms and ms[-1] > pos: best, pos = r, ms[-1]
                if best: break
            if best and best["say"] not in fired:
                fired.append(best["say"]); used.add(rules.index(best))
    return " ".join(fired) if fired else default

msg, sid = open(prompt_file).read(), None
for _ in range(12):
    text, sid = turn(msg, sid)
    emit({"who": "grill", "text": text})
    msg = answer(text)
    if msg is None: break
    said.append(msg)
    emit({"who": "owner", "text": msg})
-- input/check3a.py --
#!/usr/bin/env python3
# check3a.py G TRANSCRIPT: print whether the grill ran and, for each variant
# of the model, whether the grill tried it on exactly one example and that
# try failed: the files under goals/G/specs/tried/<variant>/ hold the verdict
# lines hyp try --worktree printed.
import json, os, sys
g, tf = sys.argv[1:]
ev = [json.loads(l) for l in open(tf) if l.strip()]
def yn(b): return "yes" if b else "no"
print("the grill ran:", yn(any(e["who"] == "tool" for e in ev)))
for v in ("Loud", "Shy"):
    files = []
    for root, _, names in os.walk(f"goals/{g}/specs/tried/{v}"):
        files += [os.path.join(root, n) for n in names if n.endswith(".txt")]
    failed = [f for f in files if "verdict: failed" in open(f).read()]
    print(f"{v} is tried on one example, and that try failed:", yn(len(files) == 1 and len(failed) == 1))
-- input/setup3a.sh --
# variants: a repository with an open Goal on greet.sh, three placed examples,
# the model in its spec folder with the tool's report, and one patch per
# variant in patches/. Sets g.
variants() {
  git init -q -b main && echo 'echo hello' >greet.sh && save base || return 1
  g=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words "greet.sh says bye." --line "gap:sh greet.sh prints bye, never shouts, and never prints hello." 2>/dev/null | sed -n 's/^recorded //p') && [ -n "$g" ] && save "record $g" || return 1
  for e in a b c; do
    x="goals/$g/line-1/$e" && mkdir -p "$x/probe" && cp "$sk/hyp-grill/probe/run" "$x/probe/run" && chmod +x "$x/probe/run" || return 1
  done
  printf -- '-- words --\nsh greet.sh prints bye.\n-- run --\nsh greet.sh\n-- floor: contains --\nbye\n' >"goals/$g/line-1/a/example.txtar"
  printf -- '-- words --\nsh greet.sh prints exactly bye.\n-- run --\nsh greet.sh\n-- floor: equals --\nbye\n' >"goals/$g/line-1/b/example.txtar"
  printf -- '-- words --\nsh greet.sh prints bye and never hello.\n-- run --\nsh greet.sh\n-- floor: contains --\nbye\n-- ceiling --\nhello\n' >"goals/$g/line-1/c/example.txtar"
  save examples && for e in a b c; do hyp place "$g" "line-1/$e" >/dev/null 2>&1 || return 1; done && save place || return 1
  mkdir -p "goals/$g/specs" && cp "$in/greet.tla" "$in/greet.cfg" "$in/greet-view.mjs" "goals/$g/specs/" || return 1
  (cd "goals/$g/specs" && "$sk/hyp-statechart/scripts/statechart" greet.tla --config greet.cfg --view greet-view.mjs --out out >/dev/null 2>&1) || return 1
  save model || return 1
  mkdir -p patches && for v in Loud:BYE Shy:'bye hello'; do
    n=${v%%:*} t=${v#*:}; echo "echo $t" >greet.sh && git diff >"patches/$n.patch" && git checkout -q greet.sh || return 1
  done && save patches
}
-- input/greet.tla --
------------------------------ MODULE greet ------------------------------
(* What sh greet.sh prints. The build either prints bye (the want), or, as *)
(* a variant, shouts BYE (Loud) or prints bye hello (Shy).                 *)
CONSTANTS Loud, Shy
VARIABLES out

Init == out = "none"
YouRunGreet == out = "none" /\ out' = IF Loud THEN "BYE" ELSE IF Shy THEN "bye hello" ELSE "bye"
Done == out # "none" /\ UNCHANGED out
Next == YouRunGreet \/ Done
Spec == Init /\ [][Next]_out

\* source: line-1
SaysBye == out \in {"none", "bye", "bye hello"}
\* source: line-1
NeverHello == out # "bye hello"
=============================================================================
-- input/greet.cfg --
SPECIFICATION Spec
CONSTANTS
    Loud = FALSE
    Shy = FALSE
INVARIANTS
    SaysBye
    NeverHello
-- input/greet-view.mjs --
// The view of greet.tla: whether greet.sh has run, and what it printed.
export const title = "sh greet.sh";
export const state = (v) => (v.out === "none" ? "Not run" : "Printed " + v.out);
export const step = (action, from, to) => (action === "YouRunGreet" ? "you run sh greet.sh" : null);
export const print = (action, from, to) => (action === "YouRunGreet" ? to.out : null);
-- input/prompt.txt --
You are the grill of the hyp store in this repository, and you follow the hyp-grill skill and the hyp-statechart skill given in your system prompt. The hyp-grill skill's folder is @SK@/hyp-grill, and the hyp-statechart skill's folder is @SK@/hyp-statechart. Set HYP_ACTOR=grill and HYP_ROLE=grill for every hyp command.

Goal @G@ is open, and its three examples are placed. Its model is in goals/@G@/specs, and the tool's report of that model is in goals/@G@/specs/out. Each variant's build is written as a patch in patches/<variant>.patch. Try the variants, as your skills say, and report what you found.

The owner reads each of your messages and answers it. End your turn when you need the owner. There is no GitHub issue and no network: record nothing on GitHub and push nothing.
-- input/owner.json --
[]
-- external --
USER
-- run --
. "$HYP_EXAMPLE/input/lib.sh"
. "$HYP_EXAMPLE/input/setup3a.sh"
stops() {
  variants || return 1
  grill "$1" "$sk/hyp-grill/SKILL.md" "$sk/hyp-statechart/SKILL.md"
  python3 "$in/check3a.py" "$g" "$out/t.$1"
}
serial stops
-- floor: equals --
try 1: the grill ran: yes
try 1: Loud is tried on one example, and that try failed: yes
try 1: Shy is tried on one example, and that try failed: yes
try 2: the grill ran: yes
try 2: Loud is tried on one example, and that try failed: yes
try 2: Shy is tried on one example, and that try failed: yes
try 3: the grill ran: yes
try 3: Loud is tried on one example, and that try failed: yes
try 3: Shy is tried on one example, and that try failed: yes
