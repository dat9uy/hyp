#!/bin/sh
# Probe of G-MH24W6 line-3/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test store with one open, one landed
# and one closed Goal, then runs hyp status --all as the owner and prints its
# stdout, then a last line "exit N". Setup output goes to stderr; a setup
# failure exits 3. On H0 --all is an unknown flag: whatever it printed to
# stdout is printed, with its exit code.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }
step() { echo "setup: $*" >&2; }

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"
base=$(git rev-parse HEAD)

OWNER="env HYP_ACTOR=owner HYP_ROLE=owner"
goal_id() { printf '%s\n' "$1" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1; }
commit() { git add -A && git commit -q -m "$1" >&2 || fail "commit $1"; }

# The landed Goal: one gap line, one example, three Hypotheses that fail it
# (the budget is used), then the owner lands it.
step "landed Goal"
added=$($OWNER hyp add goal --base "$base" --words 'Landed.' \
  --line 'gap:the subject says bye.') || fail "add landed: $added"
L=$(goal_id "$added")
[ -n "$L" ] || fail "no Goal id in: $added"
mkdir -p "goals/$L/line-1/a/probe"
printf '%s\n' '-- words --' 'The greeting says bye.' '-- run --' 'cat greet.txt' \
  '-- floor: contains --' 'bye' >"goals/$L/line-1/a/example.txtar"
cat >"goals/$L/line-1/a/probe/run" <<'PROBE'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
PROBE
chmod +x "goals/$L/line-1/a/probe/run"
commit "landed goal"
env HYP_ACTOR=grill HYP_ROLE=grill hyp place "$L" >&2 || fail "place landed"
commit "placed"
for n in 1 2 3; do
  git checkout -q -b "h$n" main >&2 || fail "branch h$n"
  echo "hi $n" >greet.txt
  commit "hypothesis $n"
  env HYP_ACTOR=runner HYP_ROLE=runner hyp run HEAD "$L/line-1" >&2 || fail "run h$n"
done
git checkout -q main >&2
$OWNER hyp land "$L" >&2 || fail "land"
commit "landed"

# The closed Goal.
step "closed Goal"
added=$($OWNER hyp add goal --base "$base" --words 'Closed.' \
  --line 'gap:the subject says hi.') || fail "add closed: $added"
C=$(goal_id "$added")
[ -n "$C" ] || fail "no Goal id in: $added"
commit "closed goal"
$OWNER hyp close "$C" >&2 || fail "close"
commit "closed"

# The open Goal: one placed example, no run.
step "open Goal"
added=$($OWNER hyp add goal --base "$base" --words 'Open.' \
  --line 'gap:the subject says yo.') || fail "add open: $added"
O=$(goal_id "$added")
[ -n "$O" ] || fail "no Goal id in: $added"
mkdir -p "goals/$O/line-1/a"
cp -R "goals/$L/line-1/a/probe" "goals/$O/line-1/a/probe"
printf '%s\n' '-- words --' 'The greeting says yo.' '-- run --' 'cat greet.txt' \
  '-- floor: contains --' 'yo' >"goals/$O/line-1/a/example.txtar"
commit "open goal"
env HYP_ACTOR=grill HYP_ROLE=grill hyp place "$O" >&2 || fail "place open"
commit "placed open"

export HYP_ACTOR=owner HYP_ROLE=owner
out="$work/out"
hyp status --all >"$out"
code=$?
sed -e "s/$L/G-L/g; s/$C/G-C/g; s/$O/G-O/g" "$out"
if [ -n "$(tail -c 1 "$out")" ]; then echo; fi
echo "exit $code"
exit 0
