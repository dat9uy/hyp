#!/bin/sh
# Probe of G-T30ZAY line-10. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test store, runs the example's run
# section on it with the stand-in Goal ids (G-ONE ...) replaced by the real
# ids, prints its stdout then stderr with the real ids put back, then a last
# line "exit N", the exit code of the run section. Setup output goes to stderr.
# A setup failure exits 3; the run command failing is an outcome.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"

# add_goal: adds a written Goal as the owner, sets GID to its id.
add_goal() {
  added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
    --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
  GID=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
  [ -n "$GID" ] || fail "no Goal id in: $added"
  commit_staged "goal $GID" || fail "commit goal"
}

# place_goal G: one fixture example with the generic Probe and a spec, placed.
place_goal() {
  d="goals/$1/line-1/a"
  mkdir -p "$d/probe" || fail "mkdir $d"
  {
    echo '-- words --'
    echo "Fixture."
    echo '-- run --'
    echo "cat greet.txt"
    echo '-- floor: contains --'
    echo "bye"
  } >"$d/example.txtar"
  cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
  chmod +x "$d/probe/run"
  mkdir -p "goals/$1/specs" && echo spec >"goals/$1/specs/spec.txt" || fail "spec"
  git add -A && git commit -q -m "fixtures $1" >&2 || fail "commit fixtures"
  HYP_ACTOR=grill HYP_ROLE=grill hyp place "$1" >&2 || fail "hyp place $1 failed"
  commit_staged "placed $1" || fail "commit placed"
}

# select_goal G N: runs a Hypothesis that meets the line, selects it.
select_goal() {
  git checkout -q -b "h$2" main >&2 || fail "checkout h$2"
  echo "bye $2" >greet.txt
  git add -A && git commit -q -m "h$2" >&2 || fail "commit h$2"
  c=$(git rev-parse HEAD)
  git checkout -q main >&2 || fail "checkout main"
  ran=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run "$c" "$1/line-1") || fail "hyp run failed: $ran"
  row=$(printf '%s\n' "$ran" | sed -n 's/^row: //p' | head -n 1)
  [ -n "$row" ] || fail "no row in: $ran"
  commit_staged "events of h$2" || fail "commit events of h$2"
  HYP_ACTOR=runner HYP_ROLE=runner hyp select "$1" "$row" --why 'meets line-1' >&2 ||
    fail "hyp select $1 failed"
  commit_staged "select $1" || fail "commit select"
}

# finish: runs $HYP_RUN with the stand-ins replaced, prints stdout then stderr
# with the real ids put back, then the exit line.
finish() {
  run=$HYP_RUN
  sub=""
  for pair in "G-ONE:$G1" "G-TWO:$G2" "G-THREE:$G3" "G-FOUR:$G4" "G-FIVE:$G5"; do
    s=${pair%%:*}; r=${pair#*:}
    [ -n "$r" ] || continue
    run=$(printf '%s' "$run" | sed "s#$s#$r#g")
    sub="$sub -e s#$r#$s#g"
  done
  out="$work/out"; err="$work/err"
  sh -c "$run" >"$out" 2>"$err"
  code=$?
  # shellcheck disable=SC2086
  sed $sub "$out"
  # shellcheck disable=SC2086
  sed $sub "$err"
  # The last line is the Probe's own; the run's exit line is part of the output.
  echo "exit $code"
  echo "exit $code"
  exit 0
}

add_goal; G1=$GID
add_goal; G2=$GID
place_goal "$G2"
add_goal; G3=$GID
place_goal "$G3"
select_goal "$G3" 3
add_goal; G4=$GID
place_goal "$G4"
select_goal "$G4" 4
HYP_ACTOR=owner HYP_ROLE=owner hyp land "$G4" --why 'done' >&2 || fail "hyp land failed"
commit_staged "land" || fail "commit land"
add_goal; G5=$GID
HYP_ACTOR=owner HYP_ROLE=owner hyp close "$G5" --why 'closed' >&2 || fail "hyp close failed"
commit_staged "close" || fail "commit close"

export HYP_ACTOR=reader HYP_ROLE=reader
finish
