#!/bin/sh
# Probe of G-W8MR53. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with a Goal of one gap
# line and one placed example, makes the commits of the Hypotheses this
# example needs and runs the line on each, so each row is a candidate. What
# each commit holds under goals/G/specs/ sets whether hyp select would hold
# that candidate back (case below). Then it runs the example's run section
# with G-ONE replaced by the real Goal id, prints its stdout with the real id
# replaced by G-ONE, then a last line "exit N" with the run's exit code. The
# run's stderr goes to stderr. Setup output goes to stderr. A setup failure
# exits 3. With PROBE_CHECK=1 it also tries hyp select on each held-back
# candidate before the run section and prints the result to stderr.

# case: no-spec | rule-no-variant | no-chart-and-selectable | selectable
case=rule-no-variant

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"

# The owner adds the Goal.
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit_staged "goal $G" || fail "commit goal"

# The grill places one example, run by the generic Probe: the base fails it.
d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
cat >"$d/example.txtar" <<'EXAMPLE'
-- words --
The subject says bye.
-- run --
cat greet.txt
-- floor: contains --
bye
EXAMPLE
cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
chmod +x "$d/probe/run"
commit_staged "example of $G" || fail "commit example"
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
commit_staged placed || fail "commit placed"

specs="goals/$G/specs"

# spec_none, spec_text, spec_model_no_variant, spec_model_no_chart: write
# what a Hypothesis commit holds under specs/.
spec_none() { :; }
spec_text() {
  mkdir -p "$specs" && echo 'The subject says bye.' >"$specs/spec.txt"
}
spec_model_no_variant() {
  mkdir -p "$specs" || return 1
  printf '%s\n' '---- MODULE greet ----' 'VARIABLE said' 'Init == said = "hello"' \
    'Next == said'"'"' = "bye"' 'Spec == Init /\ [][Next]_said' \
    'TypeOKRule == said \in {"hello", "bye"}' '====' >"$specs/greet.tla" || return 1
  printf '%s\n' 'SPECIFICATION Spec' 'INVARIANTS TypeOKRule' >"$specs/greet.cfg" || return 1
  printf '%s\n' 'stateDiagram-v2' '  hello --> bye' >"$specs/chart.mmd"
}
spec_model_no_chart() {
  mkdir -p "$specs/variants" || return 1
  printf '%s\n' '---- MODULE greet ----' 'VARIABLE said' 'Init == said = "hello"' \
    'Next == said'"'"' = "bye"' 'Spec == Init /\ [][Next]_said' \
    'SaysBye == said \in {"hello", "bye"}' '====' >"$specs/greet.tla" || return 1
  printf '%s\n' 'SPECIFICATION Spec' 'INVARIANT SaysBye' >"$specs/greet.cfg" || return 1
  printf '%s\n' 'SPECIFICATION Spec' 'INVARIANT SaysBye' >"$specs/variants/Silent.cfg"
}

# hypothesis NAME SPECFN SAYS HELD: the runner commits a Hypothesis whose
# greet.txt says SAYS (each says bye, so each meets line-1; a different SAYS
# gives a different output, so a different row) and holds what SPECFN writes,
# runs line-1 on it and, when HELD is held, appends its row to held.
: >"$work/held"
hypothesis() {
  git checkout -q -b "$1" main >&2 || fail "checkout $1"
  echo "$3" >greet.txt
  "$2" || fail "spec of $1"
  commit_staged "hypothesis $1" || fail "commit $1"
  c=$(git rev-parse HEAD)
  git checkout -q main >&2 || fail "checkout main"
  ran=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run "$c" "$G/line-1") || fail "hyp run failed: $ran"
  printf '%s\n' "$ran" >&2
  row=$(printf '%s\n' "$ran" | sed -n 's/^row: //p' | head -n 1)
  [ -n "$row" ] || fail "no row in: $ran"
  if [ "$4" = held ]; then echo "$row" >>"$work/held"; fi
  commit_staged "events of $1" || fail "commit events"
}

case "$case" in
  no-spec) hypothesis h1 spec_none bye held ;;
  rule-no-variant) hypothesis h1 spec_model_no_variant bye held ;;
  no-chart-and-selectable)
    hypothesis h1 spec_model_no_chart bye held
    hypothesis h2 spec_text 'bye now' selectable
    ;;
  selectable) hypothesis h1 spec_text bye selectable ;;
  *) fail "unknown case $case" ;;
esac

if [ "${PROBE_CHECK:-}" = 1 ]; then
  # Among two candidates only the owner selects; a lone one is the runner's.
  who=runner
  [ "$case" = no-chart-and-selectable ] && who=owner
  while read -r row; do
    echo "probe check: hyp select $G $row as $who" >&2
    HYP_ACTOR=$who HYP_ROLE=$who hyp select "$G" "$row" --why check >&2
    echo "probe check: exit $?" >&2
  done <"$work/held"
fi

export HYP_ACTOR=owner HYP_ROLE=owner
run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g")
# Actor names such as runner-g-xxxxxx hold the id in lower case.
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" "$work/err" >&2
echo "exit $code"
exit 0
