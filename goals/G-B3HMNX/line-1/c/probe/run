#!/bin/sh
# Probe of an example at a runner's run of Goal A2, added with --from A, on a commit that holds A's runner commit.
# The working directory is a copy of the subject. It builds hyp from the subject and makes a test repo with
# counter and counter2 both bad. Goal A (gap: counter says ok) is added and committed on main; A's runner
# commits CA (counter ok, a spec) on a branch from the base commit, before A's add, and runs A/line-1, so A is selected. The owner then adds A2
# with --from A (H0 is CA; gap: counter2 says ok) and commits on main. A2's runner branches from main (it does not merge CA:
# merging it leaves no refusal on H0), sets counter2 ok and commits a spec under goals/A2/specs/. ROW and GOAL in the run section are replaced
# by that commit and A2's id. Output: stdout, then stderr, tokens for ids, then a last line "exit N".
# Setup output goes to stderr. A setup failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'counter: bad\n' >counter
printf 'counter2: bad\n' >counter2
git add -A && git commit -q -m base >&2 || fail "commit base"
base=$(git rev-parse HEAD)

owner() { HYP_ACTOR=owner HYP_ROLE=owner hyp "$@"; }
runner() { HYP_ACTOR=runner-1 HYP_ROLE=runner hyp "$@"; }

# addgoal NAME FILE BASE [FROM]: a Goal with one gap line (FILE says ok), its draft NAME, and a commit of the add; sets goal
addgoal() {
  draft=$(HYP_ACTOR=owner hyp draft path "$1") || fail "draft path"
  mkdir -p "$draft/line-1/a/probe" || fail "mkdir example"
  printf '%s\n' '-- words --' 'Example.' '-- run --' "cat $2" '-- floor: contains --' 'ok' >"$draft/line-1/a/example.txtar"
  cp "$work/generic-run" "$draft/line-1/a/probe/run" && chmod +x "$draft/line-1/a/probe/run" || fail "probe copy"
  owner add goal --base "$3" --words 'Count.' --line "gap:$2 says ok." --draft "$1" $4 >"$work/add" 2>&1 || { cat "$work/add" >&2; fail "add goal $1"; }
  cat "$work/add" >&2
  goal=$(grep -o 'G-[0-9A-Z]\{6\}' "$work/add" | head -1)
  [ -n "$goal" ] || fail "no Goal id"
  git add -A && git commit -q -m "add $1" >&2 || fail "commit add $1"
}
addgoal x counter HEAD
goalA=$goal

# A's runner: CA is the fix and a spec; the run selects A
git checkout -q -b runner-a "$base" || fail "checkout"
printf 'counter: ok\n' >counter
mkdir -p "goals/$goalA/specs" && printf 'spec\n' >"goals/$goalA/specs/spec.md" || fail "spec"
git add -A && git commit -q -m "runner A" >&2 || fail "commit CA"
ca=$(git rev-parse HEAD)
git checkout -q main || fail "checkout main"
runner run "$ca" "$goalA/line-1" >&2 || fail "run A"
owner status "$goalA" >"$work/st" 2>&1; cat "$work/st" >&2
grep -q 'selected' "$work/st" || fail "A is not selected"
git checkout -q main || fail "checkout main"

# A2 rests on A: its H0 is CA; the add is on main
addgoal y counter2 "$ca" "--from $goalA"
goalB=$goal

git checkout -q -b runner-a2 main || fail "checkout"
printf 'counter2: ok\n' >counter2
mkdir -p "goals/$goalB/specs" && printf 'spec\n' >"goals/$goalB/specs/spec.md" || fail "spec"
git add -A && git commit -q -m "runner A2" >&2 || fail "commit runner"
row=$(git rev-parse HEAD)

tokens() { sed -e "s/$goalB/GOAL/g" -e "s/$goalA/GOAL_A/g" -e "s/$row/ROW/g" -e "s/$ca/CA/g" \
    -e "s/$(echo "$row" | cut -c1-7)[0-9a-f]*/ROW/g" -e "s/$(echo "$ca" | cut -c1-7)[0-9a-f]*/CA/g" \
    -e 's/[0-9a-f]\{40\}/HASH/g' -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"; }

run=$(printf '%s' "$HYP_RUN" | sed -E -e "s/(^|[^A-Za-z0-9_-])ROW([^A-Za-z0-9_-]|$)/\\1$row\\2/g" -e "s/(^|[^A-Za-z0-9_-])ROW([^A-Za-z0-9_-]|$)/\\1$row\\2/g" -e "s/GOAL\//$goalB\//g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
tokens "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
tokens "$work/err" >&2
echo "exit $code"
exit 0
