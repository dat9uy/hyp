#!/bin/sh
# Probe of G-0P2A61 line-1/d. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test store with a Goal whose one
# fixture example is placed, run on a build that meets it, selects it, replaces the
# stand-ins G-ONE and ROW-ONE in the run section with the real Goal id and row
# subject hash, runs it, prints its stdout then its stderr with the real
# ids replaced back by the stand-ins, then a last line "exit N", the exit code
# of the run section. Setup output goes to stderr. A setup failure exits 3.

MODE=d
work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"

added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit_staged "goal $G" || fail "commit goal"

# The fixture example, with the generic Probe.
d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
{
  echo '-- words --'
  echo "Fixture line-1/a."
  echo '-- run --'
  echo "cat greet.txt"
  echo '-- floor: contains --'
  echo "bye"
} >"$d/example.txtar"
{
  echo '#!/bin/sh'
  if [ "$MODE" = d ]; then echo 'echo fixture-warning >&2'; fi
  cat <<'GENERIC'
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
} >"$d/probe/run"
chmod +x "$d/probe/run"
# A spec the Spec guard accepts.
mkdir -p "goals/$G/specs" && echo spec >"goals/$G/specs/spec.txt" || fail "spec"
git add -A && git commit -q -m fixtures >&2 || fail "commit fixtures"
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
commit_staged placed || fail "commit placed"

# A build that meets line-1, run by the runner.
git checkout -q -b h main >&2 || fail "checkout h"
echo "hello bye" >greet.txt
git add -A && git commit -q -m h >&2 || fail "commit h"
c=$(git rev-parse HEAD)
git checkout -q main >&2 || fail "checkout main"
ran=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run "$c" "$G/line-1") || fail "hyp run failed: $ran"
printf '%s\n' "$ran" >&2
row=$(printf '%s\n' "$ran" | sed -n 's/^row: //p' | head -n 1)
[ -n "$row" ] || fail "no row in: $ran"
commit_staged "events of h" || fail "commit events"

if [ "$MODE" != a ]; then
  HYP_ACTOR=runner HYP_ROLE=runner hyp select "$G" "$row" --why 'h meets line-1' >&2 ||
    fail "hyp select failed"
  commit_staged select || fail "commit select"
fi

if [ "$MODE" = c ]; then
  git clone -q "$repo" "$work/clone" >&2 || fail "git clone"
  cd "$work/clone" || fail "cd clone"
fi

if [ "$MODE" = a ]; then export HYP_ACTOR=runner HYP_ROLE=runner
else export HYP_ACTOR=owner HYP_ROLE=owner; fi
run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g" -e "s/ROW-ONE/$row/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
sed -e "s/$G/G-ONE/g" -e "s/$row/ROW-ONE/g" "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
sed -e "s/$G/G-ONE/g" -e "s/$row/ROW-ONE/g" "$work/err"
echo "exit $code"
exit 0
