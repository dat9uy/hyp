-- words --
Under selected, hyp spec lists the owner's place as allowed, and does not list place as refused with no condition.
-- run --
if hyp spec | grep '^  selected  allows:' | grep -q place; then echo "selected allows place"; else echo "selected allows no place"; fi; hyp spec | grep '^  selected  does not allow:'
-- floor: contains --
selected allows place
-- ceiling --
selected allows no place
-- ceiling --
place (guard Selected)
