#!/bin/sh
# Probe: B tolerated, A selected on C1, B runs BC, owner unselects C1; the run section runs C3 for A.
work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT
fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
printf 'counter: bad\n' >counter
git add -A && git commit -q -m base >&2 || fail "commit base"
h0=$(git rev-parse HEAD)

owner() { HYP_ACTOR=owner HYP_ROLE=owner hyp "$@"; }
runa() { HYP_ACTOR=runner-a HYP_ROLE=runner hyp "$@"; }
runb() { HYP_ACTOR=runner-b HYP_ROLE=runner hyp "$@"; }

mkex() { # DRAFTDIR WORDS RUN FLOOR
  d="$1/line-1/a"
  mkdir -p "$d/probe" || fail "mkdir example"
  { printf '%s\n' '-- words --' "$2" '-- run --' "$3" '-- floor: contains --' "$4"; } >"$d/example.txtar"
  cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
}
dra=$(HYP_ACTOR=probe-writer-432b HYP_ROLE=probe-writer hyp draft path xa) || fail "draft path xa"
mkex "$dra" 'The counter says ok.' 'cat counter' 'ok'
owner add goal --base "$h0" --words 'Count.' --line 'gap:the counter says ok' --draft xa >"$work/add" 2>&1 || { cat "$work/add" >&2; fail "add goal A"; }
cat "$work/add" >&2
ga=$(grep -o 'G-[0-9A-Z]\{6\}' "$work/add" | head -1)
[ -n "$ga" ] || fail "no Goal id"
git add -A && git commit -q -m goalA >&2 || fail "commit A"

drb=$(HYP_ACTOR=probe-writer-432b HYP_ROLE=probe-writer hyp draft path xb) || fail "draft path xb"
mkex "$drb" 'The counter says done.' 'cat counter' 'done'
gb=G-NONE01
if owner add goal --from "$ga" --base "$h0" --words 'Done.' --line 'gap:the counter says done.' --draft xb >"$work/addb" 2>&1; then
  g=$(grep -o 'G-[0-9A-Z]\{6\}' "$work/addb" | head -1); [ -n "$g" ] && gb=$g
fi
cat "$work/addb" >&2
git add -A && git commit -q -m goalB >&2

build() { # BRANCH PARENT CONTENT GOALID
  git checkout -q -b "$1" "$2" || fail "checkout $1"
  printf '%s\n' "$3" >counter
  mkdir -p "goals/$4/specs" && printf 'spec %s\n' "$1" >"goals/$4/specs/spec.md" || fail "spec"
  git add -A && git commit -q -m "build $1" >&2 || fail "commit $1"
  git rev-parse HEAD
}
c1=$(build c1 "$h0" 'counter: ok' "$ga")
c2=$(build c2 "$h0" 'counter: ok done' "$ga")
c3=$(build c3 "$h0" 'counter: ok!' "$ga")
bc=$(build bc "$c1" 'counter: ok done' "$gb")
git checkout -q main || fail "checkout main"

runa run "$c1" "$ga/line-1" >&2 || fail "run C1"
owner status "$ga" 2>&1 | head -1 | grep -q "^$ga  selected" || fail "A not selected on C1"
runb run "$bc" "$gb/line-1" >&2 || echo "probe: tolerated: B run failed" >&2
owner unselect "$ga" "$c1" >&2 || fail "unselect C1"
git add -A && git commit -q -m unselect >&2 || fail "commit unselect"

B='(^|[^A-Za-z0-9_-])'; E='([^A-Za-z0-9_-]|$)'
run=$(printf '%s' "$HYP_RUN" | sed -E \
  -e "s/${B}H0${E}/\1$h0\2/g" -e "s/${B}C1${E}/\1$c1\2/g" -e "s/${B}C2${E}/\1$c2\2/g" \
  -e "s/${B}C3${E}/\1$c3\2/g" -e "s/${B}BC${E}/\1$bc\2/g" \
  -e "s/${B}GOAL_A${E}/\1$ga\2/g" -e "s/${B}GOAL_B${E}/\1$gb\2/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$h0/H0/g" -e "s/$c1/C1/g" -e "s/$c2/C2/g" -e "s/$c3/C3/g" -e "s/$bc/BC/g" \
    -e "s/$(echo "$h0" | cut -c1-7)[0-9a-f]*/H0/g" -e "s/$(echo "$c1" | cut -c1-7)[0-9a-f]*/C1/g" \
    -e "s/$(echo "$c2" | cut -c1-7)[0-9a-f]*/C2/g" -e "s/$(echo "$c3" | cut -c1-7)[0-9a-f]*/C3/g" \
    -e "s/$(echo "$bc" | cut -c1-7)[0-9a-f]*/BC/g" \
    -e "s/$ga/GOAL_A/g" -e "s/$gb/GOAL_B/g" -e "s/G-[0-9A-Z]\{6\}/GOAL_B/g" "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
