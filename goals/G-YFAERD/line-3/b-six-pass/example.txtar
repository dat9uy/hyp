-- run --
python3 skills/hyp-rethinking/scripts/check_items.py "$HYP_EXAMPLE/input/six.json"; echo "check exit: $?"
d=$(mktemp -d) && python3 skills/hyp-rethinking/scripts/draw_page.py "$HYP_EXAMPLE/input/six.json" "$d/page.html"; echo "draw exit: $?"
-- floor: contains --
check exit: 0
-- floor: contains --
draw exit: 0
-- ceiling --
section 0 is not 1 to 10
