#!/bin/sh
# Probe of a draft example of #397 goal 4. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo, adds Goal G-ONE with a custom inner example
# set (the inner Probe makes a repository and runs hyp acts), makes commit C1 on the Goal, has
# the runner's run section use G-ONE and C1 as real ids, prints stdout with real ids mapped
# back, then a last line "exit N". Setup output goes to stderr. A setup failure exits 3.
unset HYP_STEP_LOG

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"
cp skills/hyp-grill/probe/run "$work/generic-run" || fail "generic probe"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt

# inner example: its Probe makes a repository and runs one hyp act, then prints ok.
mk_inner() { # name act
  d=goals/draft-steps/line-1/$1
  mkdir -p "$d/probe" || fail "mkdir inner"
  printf '%s\n' '-- words --' "Inner $1." '-- run --' 'true' '-- floor: contains --' 'ok' >"$d/example.txtar"
  {
    printf '%s\n' '#!/bin/sh' 'd=$(mktemp -d) || exit 3' 'cd "$d" || exit 3' 'git init -q' \
      'git config user.name t; git config user.email t@example.invalid' \
      'git commit -q --allow-empty -m init' "$2" 'echo ok' 'echo "exit 0"'
  } >"$d/probe/run"
  chmod +x "$d/probe/run"
}
mk_inner a "HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words w --line 'gap:x' >/dev/null 2>&1"
d=goals/draft-steps/line-2/a
mkdir -p "$d/probe" || fail "mkdir gap"
printf '%s\n' '-- words --' 'The subject says bye.' '-- run --' 'cat greet.txt' '-- floor: contains --' 'bye' >"$d/example.txtar"
cp "$work/generic-run" "$d/probe/run" && chmod +x "$d/probe/run" || fail "probe copy"
git add -A && git commit -q -m base >&2 || fail "commit base"

export HYP_ACTOR=owner HYP_ROLE=owner
added=$(hyp add goal --base HEAD --words 'Steps.' --line 'guard:the run keeps its steps.' --line 'gap:the subject says bye.' --examples goals/draft-steps 2>"$work/adderr") \
  || fail "hyp add goal: $(cat "$work/adderr")"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || G=$(hyp status --all 2>/dev/null | sed -n 's/^\(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
git add -A && git commit -q -m "goal $G" >&2 || fail "commit goal"

git checkout -q -b c1 main >&2 || fail "checkout c1"
echo bye >greet.txt
git add -A && git commit -q -m c1 >&2 || fail "commit c1"
git checkout -q main >&2 || fail "checkout main"
C1=$(git rev-parse c1) || fail "rev-parse c1"

run=$(printf '%s' "$HYP_RUN" | sed -e "s/G-ONE/$G/g" -e "s/C1/$C1/g")
g=$(printf '%s' "$G" | tr 'A-Z' 'a-z')
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
map() {
  sed -e "s/$G/G-ONE/g" -e "s/$g/g-one/g" -e "s/$C1/C1/g" \
    -e "s/$(printf '%s' "$C1" | cut -c1-8)[0-9a-f]*/C1/g" \
    -e 's/[0-9A-HJKMNP-TV-Z]\{26\}/ULID/g' \
    -e 's/[0-9]\{4\}-[0-9]\{2\}-[0-9]\{2\}T[0-9:.]*Z\{0,1\}\([+-][0-9:]*\)\{0,1\}/TIMESTAMP/g' "$1"
}
map "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
map "$work/err" >&2
echo "exit $code"
exit 0
