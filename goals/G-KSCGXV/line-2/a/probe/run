#!/bin/sh
# Probe of G-KSCGXV line-2/a. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test store (clone A) with a test
# Goal (one gap line, one fixture example with the generic Probe, placed),
# runs one Hypothesis that meets it, selects it, lands it as owner and
# commits the events. It makes a fresh clone B with `git clone` (its trace is
# empty) and runs the example's run section in clone A and in clone B with G
# replaced by the test Goal. It prints clone B's stdout with the Goal id
# replaced by "G", then "runs count in clone A: yes|no" and "runs count in
# clone B: yes|no" (yes: the state line, the first line of the status that
# starts with the Goal id, contains "runs:"), then "exit N", the exit code of
# the run section in clone B. Setup output goes to stderr. A build or setup
# failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

commit_staged() {
  git add -A || return 1
  git diff --cached --quiet && return 0
  git commit -q -m "$1" >&2
}

mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"
added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
commit_staged goal || fail "commit goal"

d="goals/$G/line-1/a"
mkdir -p "$d/probe" || fail "mkdir $d"
{
  echo '-- words --'
  echo "Fixture line-1/a."
  echo '-- run --'
  echo "cat greet.txt"
  echo '-- floor: contains --'
  echo "bye"
} >"$d/example.txtar"
cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
# Run the example's run section in the subject copy (the working directory),
# print its stdout, then a last line "exit N" with its exit code.
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
chmod +x "$d/probe/run"
git add -A && git commit -q -m fixtures >&2 || fail "commit fixtures"
echo "setup: hyp place $G" >&2
HYP_ACTOR=grill HYP_ROLE=grill hyp place "$G" >&2 || fail "hyp place failed"
commit_staged placed || fail "commit placed"

# One Hypothesis that meets the line, with a spec under goals/G/specs.
git checkout -q -b h1 main >&2 || fail "checkout h1"
echo bye >greet.txt
mkdir -p "goals/$G/specs" && echo "The subject says bye." >"goals/$G/specs/spec.md" || fail "spec"
git add -A && git commit -q -m h1 >&2 || fail "commit h1"
c=$(git rev-parse HEAD)
git checkout -q main >&2 || fail "checkout main"
echo "setup: hyp run h1" >&2
runout=$(HYP_ACTOR=runner HYP_ROLE=runner hyp run "$c" "$G/line-1") || fail "hyp run failed: $runout"
printf '%s\n' "$runout" >&2
row=$(printf '%s\n' "$runout" | sed -n 's/^row: //p' | head -n 1)
[ -n "$row" ] || fail "no row in: $runout"
commit_staged "events of h1" || fail "commit events of h1"
echo "setup: hyp select $G $row" >&2
HYP_ACTOR=runner HYP_ROLE=runner hyp select "$G" "$row" >&2 || fail "hyp select failed"
commit_staged select || fail "commit select"
echo "setup: hyp land $G" >&2
HYP_ACTOR=owner HYP_ROLE=owner hyp land "$G" >&2 || fail "hyp land failed"
commit_staged land || fail "commit land"

git clone -q "$repo" "$work/cloneB" >&2 || fail "git clone"
run=$(printf '%s' "$HYP_RUN" | sed -e "s#\([ ]\)G\([/ ]\)#\1$G\2#g" -e "s# G\$# $G#")

# runs_count DIR OUT: run the run section in DIR, keep stdout in OUT and its
# exit code in OUT.code, print yes when the state line holds "runs:".
runs_count() {
  (cd "$1" && HYP_ACTOR=reader HYP_ROLE=reader sh -c "$run") >"$2"
  echo $? >"$2.code"
  if grep -m 1 "^$G" "$2" | grep -q 'runs:'; then echo yes; else echo no; fi
}
a=$(runs_count "$repo" "$work/outA")
b=$(runs_count "$work/cloneB" "$work/outB")
code=$(cat "$work/outB.code")
sed "s/$G/G/g" "$work/outB"
if [ -n "$(tail -c 1 "$work/outB")" ]; then echo; fi
echo "runs count in clone A: $a"
echo "runs count in clone B: $b"
echo "exit $code"
exit 0
