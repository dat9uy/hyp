#!/bin/sh
# Build hyp from the subject copy, record an open Goal in a fresh repo, run the
# example's run section there with that hyp, print stdout with the Goal id as G
# and its lower case as g, then a last line "exit N".
src=$(pwd)
bin=$(mktemp -d) && go build -o "$bin/hyp" ./cmd/hyp || exit 90
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1 GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
HOME=$(mktemp -d) && export HOME || exit 91
r=$(mktemp -d) && cd "$r" && git init -q && echo hello >greet.txt && git add greet.txt && git commit -q -m base || exit 92
g=$(HYP_ACTOR=owner HYP_ROLE=owner "$bin/hyp" add goal --base HEAD --words 'Greet.' --line 'gap:hyp says bye.' | sed -n 's/^recorded //p')
[ -n "$g" ] || exit 93
git add -A && git commit -q -m 'record the Goal' || exit 94
d='--'
ex="goals/$g/line-1/a"
mkdir -p "$ex/probe" || exit 95
printf '%s\n' '#!/bin/sh' 'tmp=$(mktemp) || exit 1' 'sh -c "$HYP_RUN" >"$tmp"' 'code=$?' 'cat "$tmp"' 'if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi' 'echo "exit $code"' 'rm -f "$tmp"' >"$ex/probe/run"
chmod +x "$ex/probe/run"
{ printf '%s words %s\nThe subject greets.\n%s run %s\ncat greet.txt\n%s floor: contains %s\nbye\n' "$d" "$d" "$d" "$d" "$d" "$d"; } >"$ex/example.txtar"
git add -A && git commit -q -m 'add the example' || exit 96
HYP_ACTOR=grill HYP_ROLE=grill "$bin/hyp" place "$g" >/dev/null 2>&1 || exit 97
git add -A && git commit -q -m 'place' || exit 98
lc=$(printf '%s' "$g" | tr 'A-Z' 'a-z')
cmd=$(printf '%s' "$HYP_RUN" | sed "s/\\([^A-Za-z0-9-]\\)G\\([^A-Za-z0-9-]\\)/\\1$g\\2/g; s/\\([^A-Za-z0-9-]\\)G\$/\\1$g/")
tmp=$(mktemp)
PATH="$bin:$PATH" HYP_ACTOR=owner HYP_ROLE=owner sh -c "$cmd" >"$tmp" 2>/dev/null
code=$?
sed -e "s/$g/G/g" -e "s/$lc/g/g" "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
