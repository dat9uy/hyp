+    }
+   ]
+  },
+  {
+   "id": "fixture-b",
+   "split": "holdout",
+   "prompt": "/hyp-owner-grill #141 with issue-b.md and the stand-in owner of standin-b.md, repository and hyp at 9c8e498.",
+   "expected_output": "A Goal with lines for #141 in investigations/goal-prompt, written without repeating S1 to S6 of #146.",
+   "files": [
+    "issue-b.md",
+    "standin-b.md"
+   ],
+   "assertions": [
+    {
+     "id": "has-goal",
+     "text": "The grill wrote at least one Goal with lines.",
+     "kind": "json-equals",
+     "path": "has_goal.json",
+     "expected": {
