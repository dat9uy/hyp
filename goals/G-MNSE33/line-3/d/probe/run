#!/bin/sh
# Probe of G-MNSE33. The working directory is a copy of the subject.
# It builds hyp from the subject, makes a test repo with a Goal, writes one
# fixture example (goals/G/line-1/N) for each input/N.fixture file, runs the
# example's run section (hyp place G-ONE ...) as the grill, prints its stdout
# then its stderr with the real Goal id replaced by G-ONE, then a last line
# "exit N" with the run's exit code. Setup output goes to stderr. A setup
# failure exits 3.

work=$(mktemp -d) || exit 3
trap 'rm -rf "$work"' EXIT

fail() { echo "probe: $*" >&2; exit 3; }

ex="$HYP_EXAMPLE"
run_cmd="$HYP_RUN"

# Build hyp from the subject before HOME changes: the Go cache is under HOME.
mkdir -p "$work/bin" || fail "mkdir"
CGO_ENABLED=0 go build -o "$work/bin/hyp" ./cmd/hyp >&2 || fail "go build failed"

export HOME="$work/home"
mkdir -p "$HOME" || fail "mkdir HOME"
export GIT_CONFIG_GLOBAL=/dev/null GIT_CONFIG_NOSYSTEM=1
export GIT_AUTHOR_NAME=owner GIT_AUTHOR_EMAIL=owner@example.invalid
export GIT_COMMITTER_NAME=owner GIT_COMMITTER_EMAIL=owner@example.invalid
export GIT_AUTHOR_DATE='2026-01-01T00:00:00+0000'
export GIT_COMMITTER_DATE='2026-01-01T00:00:00+0000'
export PATH="$work/bin:$PATH"

repo="$work/repo"
mkdir -p "$repo" && cd "$repo" || fail "mkdir repo"
git init -q -b main >&2 || fail "git init"
echo hello >greet.txt
git add greet.txt && git commit -q -m base >&2 || fail "commit base"

added=$(HYP_ACTOR=owner HYP_ROLE=owner hyp add goal --base HEAD --words 'Greet.' \
  --line 'gap:the subject says bye.') || fail "hyp add goal: $added"
G=$(printf '%s\n' "$added" | sed -n 's/^recorded \(G-[A-Z0-9]*\).*/\1/p' | head -n 1)
[ -n "$G" ] || fail "no Goal id in: $added"
git add -A && git commit -q -m "goal $G" >&2 || fail "commit goal"

for f in $(ls "$ex"/input/*.fixture 2>/dev/null | sort); do
  n=$(basename "$f" .fixture)
  d="goals/$G/line-1/$n"
  mkdir -p "$d/probe" || fail "mkdir $d"
  {
    echo '-- words --'
    echo "Fixture $n."
    echo '-- run --'
    echo 'cat greet.txt'
    while IFS= read -r line || [ -n "$line" ]; do
      case "$line" in
        floor-contains:*) echo '-- floor: contains --'; printf '%s\n' "${line#floor-contains: }" ;;
        floor-equals:*) echo '-- floor: equals --'; printf '%s\n' "${line#floor-equals: }" ;;
        ceiling:*) echo '-- ceiling --'; printf '%s\n' "${line#ceiling: }" ;;
        '') ;;
        *) fail "bad fixture line: $line" ;;
      esac
    done <"$f"
  } >"$d/example.txtar"
  cat >"$d/probe/run" <<'GENERIC'
#!/bin/sh
tmp=$(mktemp) || exit 1
sh -c "$HYP_RUN" >"$tmp"
code=$?
cat "$tmp"
if [ -n "$(tail -c 1 "$tmp")" ]; then echo; fi
echo "exit $code"
rm -f "$tmp"
GENERIC
  chmod +x "$d/probe/run"
done
git add -A && git commit -q -m fixtures >&2 || fail "commit fixtures"

export HYP_ACTOR=grill HYP_ROLE=grill
run=$(printf '%s' "$run_cmd" | sed -e "s/G-ONE/$G/g")
sh -c "$run" >"$work/out" 2>"$work/err"
code=$?
sed -e "s/$G/G-ONE/g" "$work/out"
if [ -n "$(tail -c 1 "$work/out")" ]; then echo; fi
sed -e "s/$G/G-ONE/g" "$work/err"
echo "exit $code"
exit 0
