-- words --
2d unknown holder: a holder names a Goal that is not in the store, so the check gives holder-unknown for that item and exits 1.
-- input/body.md --
| Item | Tag | Holder |
|---|---|---|
| demo-I1 | Owner said | G-ZZZZZZ line-1 |
-- run --
python3 skills/hyp-grill/scripts/check_holders.py "$HYP_EXAMPLE/input/body.md"
echo "exit code: $?"
-- floor: contains --
holder-unknown demo-I1
-- floor: contains --
exit code: 1
