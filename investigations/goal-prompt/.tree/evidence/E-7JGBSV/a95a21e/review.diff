+{
+ "skill_name": "hyp-owner-grill",
+ "evals": [
+  {
+   "id": "fixture-a",
+   "split": "holdout",
+   "prompt": "/hyp-owner-grill #113 with issue-a.md and the stand-in owner of standin-a.md, repository and hyp at a51f140.",
+   "expected_output": "A Goal with lines for #113, written without repeating S1 to S6 of #146.",
+   "files": [
