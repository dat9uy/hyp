+{"type":"session-owner","accountUuid":"61c0dc2c-da2f-41ad-8a06-4c79a78f1d15","organizationUuid":"a1adefea-aeae-4878-8b40-371d459fc3e4","sessionId":"85078edc-ac51-4204-aee9-42d61eec2054"}
