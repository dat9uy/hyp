-- words --
One HTML page holding all five faults prints each of today's five messages and exit 1.
-- input/page.html --
<!doctype html><html><body>
<h2 id="x">1. One</h2><p id="x">See section 2. word word word word word word word word word word word word word word word word word word word word word word word word word word word word word word.</p><h2>3. Three</h2><p>Fine.</p><h2>6. Approaches</h2><p>None.</p><h2>7. Side by side</h2><svg viewBox="0 0 1 1"></svg>
</body></html>
-- run --
test -f skills/hyp-rethinking/scripts/check_page.py && echo 'check_page.py ships'
python3 skills/hyp-rethinking/scripts/check_page.py "$HYP_EXAMPLE/input/page.html"
echo "exit code: $?"
-- floor: contains --
check_page.py ships
-- floor: contains --
heading order:
-- floor: contains --
reference to missing section
-- floor: contains --
duplicate id
-- floor: contains --
words:
-- floor: contains --
diagrams, needs
-- floor: contains --
exit code: 1
